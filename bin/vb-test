test_s3_checksum_roundtrip_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_checksum_roundtrip_optional"

  make_volume_content "alpha"

  local ts="20250101_040001"
  local prefix key
  prefix="$(t_s3_prefix checksum)"
  key="${prefix}/alpha_${ts}.tar.gz"

  run_backup -v alpha -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  [[ "$(t_s3_head "${key}.sha256")" == 200 ]] || {
    log "BUG: .sha256 was not uploaded to S3 alongside the archive"
    return 1
  }

  # The archive and its sidecar carry the same publication token
  local archive_token sidecar_token
  archive_token="$(curl -K "$T_S3_CONFIG" --head "$(t_s3_url "$key")" | tr -d '\r' | awk 'tolower($1) == "x-amz-meta-vb-token:" { print $2 }')"
  sidecar_token="$(curl -K "$T_S3_CONFIG" --head "$(t_s3_url "${key}.sha256")" | tr -d '\r' | awk 'tolower($1) == "x-amz-meta-vb-token:" { print $2 }')"
  [[ -n "$archive_token" && "$archive_token" == "$sidecar_token" ]] || {
    log "BUG: archive and sidecar tokens differ: '$archive_token' vs '$sidecar_token'"
    return 1
  }

  # A corrupted sidecar must make the restore fail and leave the target alone
  t_s3_get "${key}.sha256" "$CASE_ROOT/good.sha256" || return 1
  printf '%064d  alpha_%s.tar.gz\n' 0 "$ts" > "$CASE_ROOT/bad.sha256"
  [[ "$(t_s3_put "${key}.sha256" "$CASE_ROOT/bad.sha256")" == 200 ]] || return 1

  replace_volume_with_marker "alpha_restore" "must-survive"
  local rc=0
  run_restore -i "s3://${TEST_S3_BUCKET}/${key}" -t alpha_restore -C 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: restore accepted an archive that does not match its checksum"
    return 1
  }
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha_restore/marker.txt" "must-survive" || return 1

  [[ "$(t_s3_put "${key}.sha256" "$CASE_ROOT/good.sha256")" == 200 ]] || return 1
  run_restore -i "s3://${TEST_S3_BUCKET}/${key}" -t alpha_restore -C || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_s3_backup_fails_closed_on_head_error() {
  setup_case "s3_backup_fails_closed_on_head_error"
  make_volume_content "alpha"

  # A HEAD answer other than 200/404 (here: 403) must stop the backup before
  # anything is uploaded; it must never be read as "object does not exist".
  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" deny

  local rc=0
  run_backup_with_env \
    AWS_ACCESS_KEY_ID=dummy \
    AWS_SECRET_ACCESS_KEY=dummy \
    AWS_ENDPOINT_URL=http://127.0.0.1:9 \
    PATH="$stub:$PATH" \
    -- -v alpha -T 20250101_444444 -c -b irrelevant 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: backup proceeded despite an ambiguous HEAD answer — should fail closed"
    return 1
  }

  ! grep -q '?uploads' "$stub/curl.trace" || {
    log "BUG: backup started an upload after an ambiguous HEAD answer"
    return 1
  }
}

test_s3_rejects_unsafe_keys() {
  setup_case "s3_rejects_unsafe_keys"
  make_volume_content "alpha"
  prepare_target_volume "alpha_restore"

  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" deny

  local -a s3_env=(
    AWS_ACCESS_KEY_ID=dummy
    AWS_SECRET_ACCESS_KEY=dummy
    AWS_ENDPOINT_URL=http://127.0.0.1:9
    PATH="$stub:$PATH"
  )

  local folder
  for folder in 'a/../b' 'a//b' './x' 'a/./b' 'a b' 'a/..'; do
    expect_rejected run_backup_with_env "${s3_env[@]}" -- -v alpha -T 20250101_454545 -b bucket -f "$folder" || return 1
  done

  local source
  for source in 's3://bucket/a/../x.tar' 's3://bucket//x.tar' 's3://bucket/' 's3://Bad_Bucket/x.tar'; do
    expect_rejected run_restore_with_env "${s3_env[@]}" -- -i "$source" -t alpha_restore || return 1
  done

  [[ ! -s "$stub/curl.trace" ]] || {
    log "BUG: an unsafe key reached the network:"
    cat "$stub/curl.trace" >&2
    return 1
  }
}

test_s3_backup_fails_on_overwrite_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_backup_fails_on_overwrite_optional"


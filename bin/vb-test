test_restore_refuses_source_inside_target() {
  setup_case "restore_refuses_source_inside_target"
  make_volume_content "alpha"
  local ts="20250101_801000"
  run_backup -v alpha -T "$ts" || return 1

  cp "$TEST_BACKUP_ROOT/alpha_${ts}.tar" "$TEST_BACKUP_ROOT/alpha_${ts}.tar.sha256" "$TEST_VOLUMES_ROOT/alpha/"
  expect_rejected run_restore -i "$TEST_VOLUMES_ROOT/alpha/alpha_${ts}.tar" -t alpha -C || return 1
  assert_file_exists "$TEST_VOLUMES_ROOT/alpha/alpha_${ts}.tar" || return 1
  assert_no_reserved_entries alpha || return 1

  # Same when the whole backup directory lives in a target volume
  expect_rejected run_restore -a -d "$TEST_VOLUMES_ROOT/alpha" -C || return 1
  assert_file_exists "$TEST_VOLUMES_ROOT/alpha/alpha_${ts}.tar" || return 1
}

test_backup_warns_about_nested_mounts() {
  setup_case "backup_warns_about_nested_mounts"
  make_volume_content "alpha"

  local real_alpha fake="$CASE_ROOT/mountinfo"
  real_alpha="$(cd "$TEST_VOLUMES_ROOT/alpha" && pwd -P)"
  { cat /proc/self/mountinfo; printf '9999 1 0:99 / %s/subdir rw - tmpfs tmpfs rw\n' "$real_alpha"; } > "$fake"

  run_backup_with_env VB_TEST_HOOKS=1 VB_TEST_MOUNTINFO="$fake" -- -v alpha -T 20250101_801100 2> "$CASE_ROOT/backup.log" || return 1
  grep -q 'contains other mount points' "$CASE_ROOT/backup.log" || {
    log "BUG: no warning about the mount point inside the volume"
    return 1
  }
}

test_restore_does_not_restore_selinux_labels() {
  is_gnu_tar || return "$SKIP_RC"
  setup_case "restore_does_not_restore_selinux_labels"
  make_volume_content "alpha"
  local ts="20250101_801200"
  run_backup -v alpha -T "$ts" || return 1

  local stub="$CASE_ROOT/stub" real_tar
  real_tar="$(command -v tar)"
  mkdir -p "$stub"
  cat > "$stub/tar" <<STUB
#!/usr/bin/env bash
[[ " \$* " == *" --extract "* ]] && printf '%s\n' "\$*" >> '$stub/trace'
exec '$real_tar' "\$@"
STUB
  chmod +x "$stub/tar"

  prepare_target_volume "alpha_restore"
  run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha_restore || return 1
  [[ -s "$stub/trace" ]] || return 1
  if grep -q -v -- '--xattrs-exclude=security.selinux' "$stub/trace"; then
    log "BUG: an extraction restores SELinux labels:"
    cat "$stub/trace" >&2
    return 1
  fi
}

test_s3_errors_include_the_curl_message() {
  setup_case "s3_errors_include_the_curl_message"
  make_volume_content "alpha"

  local rc=0
  run_backup_with_env AWS_ENDPOINT_URL=http://127.0.0.1:9 AWS_ACCESS_KEY_ID=key AWS_SECRET_ACCESS_KEY=secret AWS_REGION=us-east-1 -- \
    -v alpha -T 20250101_801300 -b vb-test 2> "$CASE_ROOT/backup.log" || rc=$?
  (( rc != 0 )) || return 1
  grep -q 'curl: (7)' "$CASE_ROOT/backup.log" || {
    log "BUG: the error does not say why curl failed:"
    cat "$CASE_ROOT/backup.log" >&2
    return 1
  }
}

# Prints a backup timestamp <days> days ago (UTC)
ts_days_ago() {
  ts_seconds_ago $(( $1 * 86400 ))
}

ts_seconds_ago() {
  date -u -d "@$(( $(date -u +%s) - $1 ))" +%Y%m%d_%H%M%S
}

# Prints the keys below an S3 prefix of the test bucket
#   t_s3_list_keys <prefix> [endpoint] [bucket]
t_s3_list_keys() {
  local endpoint="${2:-${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}}"
  local bucket="${3:-$TEST_S3_BUCKET}"
  curl -K "$T_S3_CONFIG" --fail "${endpoint%/}/${bucket}?list-type=2&prefix=$1" \
    | tr '<' '\n' | awk -F'>' '$1 == "Key" { print $2 }' | tr '\n' ' '
}

# Every checksum file in BACKUP_ROOT has its archive, and the digests match
assert_backup_root_consistent() {
  local sidecar archive
  for sidecar in "$TEST_BACKUP_ROOT"/*.sha256; do
    [[ -e "$sidecar" ]] || continue
    archive="${sidecar%.sha256}"
    [[ -f "$archive" ]] || {
      log "BUG: checksum file without its archive: $sidecar"
      return 1
    }
    [[ "$(sha256sum "$archive" | awk '{ print $1 }')" == "$(awk '{ print $1 }' "$sidecar")" ]] || {
      log "BUG: checksum file does not match its archive: $sidecar"
      return 1
    }
  done
}

# Lists the backup names left in BACKUP_ROOT for a volume (archives and checksum files)
backup_names() {
  find "$TEST_BACKUP_ROOT" -maxdepth 1 -name "$1_[0-9]*" -printf '%f\n' | LC_ALL=C sort | tr '\n' ' '
}

test_single_backup_restore_zstd() {
  command -v zstd >/dev/null 2>&1 || return "$SKIP_RC"
  setup_case "single_backup_restore_zstd"
  make_volume_content "alpha"

  run_backup -v alpha -T 20250101_900000 -z || return 1
  run_backup -v alpha -T 20250101_900001 -z -L 19 || return 1
  run_backup_with_env GPG_PASSPHRASE=secret -- -v alpha -T 20250101_900002 -z -s || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/alpha_20250101_900000.tar.zst" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/alpha_20250101_900002.tar.zst.gpg" || return 1

  local name
  for name in alpha_20250101_900000.tar.zst alpha_20250101_900001.tar.zst; do
    prepare_target_volume "restore_${name%%.*}"
    run_restore -i "$name" -t "restore_${name%%.*}" || return 1
    assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/restore_${name%%.*}" || return 1
  done
  prepare_target_volume "restore_encrypted"
  run_restore_with_env GPG_PASSPHRASE=secret -- -i alpha_20250101_900002.tar.zst.gpg -t restore_encrypted -s || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/restore_encrypted" || return 1

  # restore -a picks zstd archives too
  replace_volume_with_marker "alpha" "old"
  run_restore -a -T 20250101_900001 -C || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/restore_alpha_20250101_900001" "$TEST_VOLUMES_ROOT/alpha" || return 1
}

test_compression_options_are_validated() {
  setup_case "compression_options_are_validated"
  make_volume_content "alpha"

  expect_rejected run_backup -v alpha -T 20250101_900100 -L 5 || return 1
  expect_rejected run_backup -v alpha -T 20250101_900100 -c -L 10 || return 1
  expect_rejected run_backup -v alpha -T 20250101_900100 -c -L 'x' || return 1
  expect_rejected run_backup -v alpha -T 20250101_900100 -z -L 20 || return 1
  expect_rejected run_backup -v alpha -T 20250101_900100 -c -z || return 1
  [[ -z "$(find "$TEST_BACKUP_ROOT" -mindepth 1)" ]] || return 1

  run_backup -v alpha -T 20250101_900100 -c -L 1 || return 1
  prepare_target_volume "alpha_restore"
  run_restore -i alpha_20250101_900100.tar.gz -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_backup_excludes_patterns() {
  setup_case "backup_excludes_patterns"
  local root="$TEST_VOLUMES_ROOT/alpha"
  make_volume_content "alpha"
  mkdir -p "$root/cache" "$root/subdir/cache" "$root/logs"
  printf 'x\n' > "$root/cache/blob"
  printf 'x\n' > "$root/subdir/cache/kept"
  printf 'x\n' > "$root/logs/app.log"
  printf 'x\n' > "$root/subdir/debug.log"
  printf 'x\n' > "$root/logs/keep.txt"
  make_volume_content "beta"
  printf 'x\n' > "$TEST_VOLUMES_ROOT/beta/beta.log"

  run_backup -a -T 20250101_900200 -x '*.log' -x ./cache || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i alpha_20250101_900200.tar -t alpha_restore || return 1
  local restored="$TEST_VOLUMES_ROOT/alpha_restore"
  assert_file_not_exists "$restored/cache" || return 1
  assert_file_not_exists "$restored/logs/app.log" || return 1
  assert_file_not_exists "$restored/subdir/debug.log" || return 1
  assert_file_exists "$restored/subdir/cache/kept" || return 1
  assert_file_exists "$restored/logs/keep.txt" || return 1
  assert_file_exists "$restored/hello.txt" || return 1

  prepare_target_volume "beta_restore"
  run_restore -i beta_20250101_900200.tar -t beta_restore || return 1
  assert_file_not_exists "$TEST_VOLUMES_ROOT/beta_restore/beta.log" || return 1
}

test_secrets_from_files() {
  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"
  setup_case "secrets_from_files"
  make_volume_content "alpha"
  make_volume_content "beta"

  # Docker secrets usually end with a newline, which is not part of the value
  printf 'file-secret\n' > "$CASE_ROOT/passphrase"
  run_backup_with_env GPG_PASSPHRASE_FILE="$CASE_ROOT/passphrase" -- -a -T 20250101_900300 -s || return 1

  prepare_target_volume "alpha_restore"
  run_restore_with_env GPG_PASSPHRASE=file-secret -- -i alpha_20250101_900300.tar.gpg -t alpha_restore -s || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1

  # Workers of restore -a see the value, not the file variable
  replace_volume_with_marker "alpha" "old"
  replace_volume_with_marker "beta" "old"
  run_restore_with_env GPG_PASSPHRASE_FILE="$CASE_ROOT/passphrase" -- -a -T 20250101_900300 -s -C -j 2 || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha_restore" "$TEST_VOLUMES_ROOT/alpha" || return 1

  expect_rejected run_backup_with_env GPG_PASSPHRASE=x GPG_PASSPHRASE_FILE="$CASE_ROOT/passphrase" -- \
    -v alpha -T 20250101_900301 -s || return 1
  expect_rejected run_backup_with_env GPG_PASSPHRASE_FILE="$CASE_ROOT/missing" -- -v alpha -T 20250101_900301 -s || return 1
}

test_restore_lists_backups() {
  setup_case "restore_lists_backups"
  make_volume_content "alpha"
  make_volume_content "beta"
  run_backup -a -T 20250101_900400 || return 1
  run_backup -v alpha -T 20250101_900401 || return 1
  run_backup -v alpha -T 20250101_900402 || return 1
  run_backup -v alpha -T 20250101_900403 || return 1

  rm "$TEST_BACKUP_ROOT/alpha_20250101_900401.tar.sha256"
  cp "$TEST_BACKUP_ROOT/alpha_20250101_900400.tar.sha256" "$TEST_BACKUP_ROOT/alpha_20250101_900402.tar.sha256"
  rm "$TEST_BACKUP_ROOT/alpha_20250101_900403.tar"

  local out
  out="$(run_restore -l 2>/dev/null)" || return 1
  grep -q '^alpha  *20250101_900400  *complete .*alpha_20250101_900400\.tar$' <<< "$out" || {
    log "Unexpected listing:"
    printf '%s\n' "$out" >&2
    return 1
  }
  grep -q '^alpha  *20250101_900401  *incomplete .*(no checksum file)$' <<< "$out" || return 1
  grep -q '^alpha  *20250101_900402  *incomplete .*(checksum file names alpha_20250101_900400\.tar)$' <<< "$out" || return 1
  grep -q '^alpha  *20250101_900403  *orphan ' <<< "$out" || return 1
  grep -q '^beta  *20250101_900400  *complete ' <<< "$out" || return 1

  out="$(run_restore -l -v beta 2>/dev/null)" || return 1
  [[ "$(printf '%s\n' "$out" | grep -c '^alpha')" == 0 && "$(printf '%s\n' "$out" | grep -c '^beta')" == 1 ]] || return 1
  out="$(run_restore -l -T 20250101_900401 2>/dev/null)" || return 1
  [[ "$(printf '%s\n' "$out" | grep -c '_2025')" == 1 ]] || return 1

  expect_rejected run_restore -l -i alpha_20250101_900400.tar || return 1
}

test_restore_all_skips_incomplete_backups() {
  setup_case "restore_all_skips_incomplete_backups"
  make_volume_content "alpha"
  run_backup -v alpha -T 20250101_900500 || return 1
  copy_volume_snapshot "alpha" "$CASE_ROOT/first"
  printf 'second\n' > "$TEST_VOLUMES_ROOT/alpha/second.txt"
  run_backup -v alpha -T 20250101_900501 || return 1
  copy_volume_snapshot "alpha" "$CASE_ROOT/second"
  rm "$TEST_BACKUP_ROOT/alpha_20250101_900501.tar.sha256"

  replace_volume_with_marker "alpha" "old"
  run_restore -a -C 2> "$CASE_ROOT/restore.log" || return 1
  assert_dirs_equal "$CASE_ROOT/first" "$TEST_VOLUMES_ROOT/alpha" || return 1
  grep -q 'Skipping incomplete backup alpha_20250101_900501.tar' "$CASE_ROOT/restore.log" || return 1

  # With -T, an incomplete backup is not replaced by another one
  expect_rejected run_restore -a -T 20250101_900501 -C || return 1

  run_restore -a -C -U 2>/dev/null || return 1
  assert_dirs_equal "$CASE_ROOT/second" "$TEST_VOLUMES_ROOT/alpha" || return 1
}

test_verify_backups() {
  setup_case "verify_backups"
  make_volume_content "alpha"
  make_volume_content "beta"
  local ts="20250101_900600"
  run_backup -a -T "$ts" -c || return 1
  run_backup_with_env GPG_PASSPHRASE=secret -- -v alpha -T 20250101_900601 -s || return 1

  # No volumes are needed to verify
  local -a no_volumes=(VOLUMES_ROOT="$CASE_ROOT/missing")
  run_restore_with_env "${no_volumes[@]}" -- -V -i "alpha_${ts}.tar.gz" || return 1
  run_restore_with_env "${no_volumes[@]}" GPG_PASSPHRASE=secret -- -V -i alpha_20250101_900601.tar.gpg -s || return 1
  expect_rejected run_restore_with_env "${no_volumes[@]}" GPG_PASSPHRASE=wrong -- -V -i alpha_20250101_900601.tar.gpg -s || return 1
  run_restore_with_env "${no_volumes[@]}" -- -V -a -T "$ts" -j 2 || return 1

  # A corrupted archive fails, and so does -a when one of its backups is bad
  printf 'garbage' >> "$TEST_BACKUP_ROOT/beta_${ts}.tar.gz"
  expect_rejected run_restore_with_env "${no_volumes[@]}" -- -V -i "beta_${ts}.tar.gz" || return 1
  expect_rejected run_restore_with_env "${no_volumes[@]}" -- -V -a -T "$ts" || return 1

  # Without a checksum file (-U), a truncated archive is still detected
  local size
  size="$(stat -c %s "$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz")"
  head -c $(( size / 2 )) "$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz" > "$TEST_BACKUP_ROOT/alpha_20250101_900602.tar.gz"
  expect_rejected run_restore_with_env "${no_volumes[@]}" -- -V -i alpha_20250101_900602.tar.gz -U || return 1

  expect_rejected run_restore -V -i "alpha_${ts}.tar.gz" -t alpha || return 1
}

test_rotation_keeps_newest_backups() {
  setup_case "rotation_keeps_newest_backups"
  make_volume_content "app"
  make_volume_content "app_data"
  local ts
  for ts in 20250101_000001 20250101_000002 20250101_000003 20250101_000004; do
    run_backup -v app -T "$ts" || return 1
  done
  run_backup -v app_data -T 20250101_000001 || return 1

  # Dry run: nothing is deleted
  run_backup -v app -T 20250101_000005 -R 2 -n 2> "$CASE_ROOT/dry.log" || return 1
  grep -q 'Rotation would delete: app_20250101_000003.tar' "$CASE_ROOT/dry.log" || return 1
  [[ "$(find "$TEST_BACKUP_ROOT" -name 'app_2025*.tar' | wc -l)" == 4 ]] || return 1

  run_backup -v app -T 20250101_000005 -R 2 || return 1
  [[ "$(backup_names app)" == "app_20250101_000004.tar app_20250101_000004.tar.sha256 app_20250101_000005.tar app_20250101_000005.tar.sha256 " ]] || {
    log "Unexpected backups left: $(backup_names app)"
    return 1
  }
  # Another volume whose name starts with the same prefix is not touched
  assert_file_exists "$TEST_BACKUP_ROOT/app_data_20250101_000001.tar" || return 1
  assert_backup_root_consistent || return 1
}

test_rotation_keeps_recent_backups() {
  setup_case "rotation_keeps_recent_backups"
  make_volume_content "app"
  local old older recent
  older="$(ts_days_ago 10)"
  old="$(ts_days_ago 5)"
  recent="$(ts_days_ago 1)"
  run_backup -v app -T "$older" || return 1
  run_backup -v app -T "$old" || return 1
  run_backup -v app -T "$recent" || return 1

  # Either rule keeps a backup: the 3 newest, or those younger than 3 days
  run_backup -v app -T "$(ts_seconds_ago 7200)" -R 3 -D 3 || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_${old}.tar" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_${older}.tar" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_${older}.tar.sha256" || return 1

  run_backup -v app -T "$(ts_seconds_ago 3600)" -D 3 || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_${old}.tar" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_${recent}.tar" || return 1
  assert_backup_root_consistent || return 1
}

test_rotation_handles_incomplete_backups() {
  setup_case "rotation_handles_incomplete_backups"
  make_volume_content "app"
  local incomplete orphan complete two_days one_day ancient
  complete="$(ts_days_ago 30)"
  incomplete="$(ts_days_ago 20)"
  orphan="$(ts_days_ago 10)"
  two_days="$(ts_days_ago 2)"
  one_day="$(ts_days_ago 1)"
  ancient="$(ts_days_ago 40)"
  run_backup -v app -T "$complete" || return 1
  run_backup -v app -T "$incomplete" || return 1
  rm "$TEST_BACKUP_ROOT/app_${incomplete}.tar.sha256"
  run_backup -v app -T "$orphan" || return 1
  rm "$TEST_BACKUP_ROOT/app_${orphan}.tar"

  # -R never deletes incomplete backups or orphaned checksum files
  run_backup -v app -T "$two_days" -R 1 2> "$CASE_ROOT/r.log" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_${complete}.tar" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_${incomplete}.tar" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_${orphan}.tar.sha256" || return 1
  grep -q "keeping incomplete backup app_${incomplete}.tar" "$CASE_ROOT/r.log" || return 1

  # -D does, once they are old enough
  run_backup -v app -T "$one_day" -D 5 || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_${incomplete}.tar" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_${orphan}.tar.sha256" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_${two_days}.tar" || return 1

  # The newest complete backup survives even when it is too old, and so does
  # the backup that was just made, whatever its timestamp
  run_backup -v app -T "$ancient" -D 1 || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_${one_day}.tar" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_${ancient}.tar" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_${two_days}.tar" || return 1
  assert_backup_root_consistent || return 1
}

test_rotation_interrupted_between_files() {
  setup_case "rotation_interrupted_between_files"
  make_volume_content "app"
  run_backup -v app -T 20250101_000001 || return 1
  run_backup -v app -T 20250101_000002 || return 1

  local rc=0
  run_backup_with_env VB_TEST_HOOKS=1 VB_TEST_FAIL_AT=rotate_pair:app -- -v app -T 20250101_000003 -R 1 >/dev/null 2>&1 || rc=$?
  (( rc == 137 )) || {
    log "Expected the backup to be killed during rotation, got exit $rc"
    return 1
  }

  # Newest first, and the checksum file before the archive: what is left is
  # an incomplete archive
  assert_file_not_exists "$TEST_BACKUP_ROOT/app_20250101_000002.tar.sha256" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_20250101_000002.tar" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/app_20250101_000001.tar.sha256" || return 1
  local out
  out="$(run_restore -l 2>/dev/null)" || return 1
  grep -q '^app  *20250101_000002  *incomplete ' <<< "$out" || return 1
  assert_backup_root_consistent || return 1
}

test_rotation_and_publishing_do_not_interleave() {
  setup_case "rotation_and_publishing_do_not_interleave"
  make_volume_content "app"
  run_backup -v app -T 20250101_000001 || return 1

  # A holds the BACKUP_ROOT lock while publishing; B finishes its archive,
  # then publishes and rotates only after A released the lock
  start_paused_backup local_publish:app -- -v app -T 20250101_000002
  wait_for_point local_publish:app || return 1
  run_backup -v app -T 20250101_000003 -R 1 > "$CASE_ROOT/b.log" 2>&1 &
  local b_pid=$!
  sleep 1
  resume_and_wait local_publish:app 2>/dev/null || return 1
  wait "$b_pid" || {
    cat "$CASE_ROOT/b.log" >&2
    return 1
  }

  [[ "$(backup_names app)" == "app_20250101_000003.tar app_20250101_000003.tar.sha256 " ]] || {
    log "Unexpected backups left: $(backup_names app)"
    return 1
  }
  assert_backup_root_consistent || return 1
}

test_s3_list_and_restore_all_optional() {
  require_s3_or_skip || return $?
  setup_case "s3_list_and_restore_all_optional"
  make_volume_content "alpha"
  make_volume_content "beta"

  local ts="20250101_900700" prefix
  prefix="$(t_s3_prefix restore-all)"
  run_backup -a -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  copy_volume_snapshot "alpha" "$CASE_ROOT/expected-alpha"
  copy_volume_snapshot "beta" "$CASE_ROOT/expected-beta"

  # An archive whose checksum file belongs to another upload is incomplete
  run_backup -v alpha -T 20250101_900701 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  printf '%064d  alpha_20250101_900701.tar\n' 0 > "$CASE_ROOT/foreign.sha256"
  [[ "$(t_s3_put "${prefix}/alpha_20250101_900701.tar.sha256" "$CASE_ROOT/foreign.sha256")" == 200 ]] || return 1

  local out
  out="$(run_restore -l -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null)" || return 1
  grep -q "^alpha  *${ts}  *complete " <<< "$out" || {
    printf '%s\n' "$out" >&2
    return 1
  }
  grep -q "^beta  *${ts}  *complete " <<< "$out" || return 1
  grep -q '^alpha  *20250101_900701  *incomplete .*another upload' <<< "$out" || return 1

  replace_volume_with_marker "alpha" "old"
  replace_volume_with_marker "beta" "old"
  run_restore -a -b "$TEST_S3_BUCKET" -f "$prefix" -C -j 2 || return 1
  assert_dirs_equal "$CASE_ROOT/expected-alpha" "$TEST_VOLUMES_ROOT/alpha" || return 1
  assert_dirs_equal "$CASE_ROOT/expected-beta" "$TEST_VOLUMES_ROOT/beta" || return 1

  run_restore -V -a -b "$TEST_S3_BUCKET" -f "$prefix" -T "$ts" || return 1
}

test_s3_rotation_optional() {
  require_s3_or_skip || return $?
  setup_case "s3_rotation_optional"
  make_volume_content "app"

  local prefix ts
  prefix="$(t_s3_prefix rotation)"
  for ts in 20250101_000001 20250101_000002 20250101_000003; do
    run_backup -v app -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  done

  run_backup -v app -T 20250101_000004 -R 2 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  for ts in 20250101_000001 20250101_000002; do
    [[ "$(t_s3_head "${prefix}/app_${ts}.tar")" == 404 && "$(t_s3_head "${prefix}/app_${ts}.tar.sha256")" == 404 ]] || {
      log "BUG: app_${ts} was not rotated away"
      return 1
    }
  done
  [[ "$(t_s3_head "${prefix}/app_20250101_000003.tar.sha256")" == 200 ]] || return 1
  [[ "$(t_s3_head "${prefix}/app_20250101_000004.tar.sha256")" == 200 ]] || return 1
  # No probe objects are left behind
  [[ -z "$(t_s3_list_keys "${prefix}/.vb-probe")" ]] || return 1
}

test_s3_rotation_keeps_replaced_objects_optional() {
  require_s3_or_skip || return $?
  setup_case "s3_rotation_keeps_replaced_objects_optional"
  make_volume_content "app"

  local prefix
  prefix="$(t_s3_prefix rotation-replaced)"
  run_backup -v app -T 20250101_000001 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  # Paused after planning: the old backup gets replaced by different objects
  start_paused_backup rotate_planned:app -- -v app -T 20250101_000002 -R 1 -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point rotate_planned:app || return 1
  printf 'replacement archive\n' > "$CASE_ROOT/b.tar"
  printf '%064d  app_20250101_000001.tar\n' 1 > "$CASE_ROOT/b.sha256"
  [[ "$(t_s3_put "${prefix}/app_20250101_000001.tar" "$CASE_ROOT/b.tar")" == 200 ]] || return 1
  [[ "$(t_s3_put "${prefix}/app_20250101_000001.tar.sha256" "$CASE_ROOT/b.sha256")" == 200 ]] || return 1
  resume_and_wait rotate_planned:app 2>/dev/null || return 1

  t_s3_get "${prefix}/app_20250101_000001.tar" "$CASE_ROOT/after.tar" || return 1
  t_s3_get "${prefix}/app_20250101_000001.tar.sha256" "$CASE_ROOT/after.sha256" || return 1
  if ! cmp -s "$CASE_ROOT/b.tar" "$CASE_ROOT/after.tar" || ! cmp -s "$CASE_ROOT/b.sha256" "$CASE_ROOT/after.sha256"; then
    log "BUG: rotation deleted objects that were replaced after it checked them"
    return 1
  fi
  grep -q 'changed after it was checked' "$CASE_ROOT/paused.log" || return 1
}

test_s3_rotation_needs_conditional_delete_optional() {
  require_s3_or_skip || return $?
  setup_case "s3_rotation_needs_conditional_delete_optional"
  make_volume_content "app"

  local prefix stub="$CASE_ROOT/stub"
  prefix="$(t_s3_prefix rotation-unconditional)"
  run_backup -v app -T 20250101_000001 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  make_curl_stub "$stub" delete-ignores-if-match

  expect_rejected run_backup_with_env PATH="$stub:$PATH" -- -v app -T 20250101_000002 -R 1 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  [[ "$(t_s3_head "${prefix}/app_20250101_000001.tar")" == 200 ]] || {
    log "BUG: rotation deleted a backup although conditional deletes are not supported"
    return 1
  }

  run_backup_with_env PATH="$stub:$PATH" S3_ALLOW_UNCONDITIONAL_DELETE=1 -- \
    -v app -T 20250101_000003 -R 1 -b "$TEST_S3_BUCKET" -f "$prefix" 2> "$CASE_ROOT/optin.log" || return 1
  grep -q 'ignores If-Match' "$CASE_ROOT/optin.log" || return 1
  [[ "$(t_s3_head "${prefix}/app_20250101_000001.tar")" == 404 ]] || return 1
}

test_s3_rotation_on_versioned_bucket_optional() {
  require_s3_or_skip || return $?
  if [[ -z "${TEST_S3_VERSIONED_ENDPOINT:-}${TEST_S3_VERSIONED_BUCKET:-}" ]]; then
    [[ "${REQUIRE_S3_TESTS:-0}" != 1 ]] || {
      log "TEST_S3_VERSIONED_ENDPOINT or TEST_S3_VERSIONED_BUCKET is required (REQUIRE_S3_TESTS=1)"
      return 1
    }
    return "$SKIP_RC"
  fi
  setup_case "s3_rotation_on_versioned_bucket_optional"
  make_volume_content "app"

  local endpoint="${TEST_S3_VERSIONED_ENDPOINT:-${AWS_ENDPOINT_URL:-}}"
  local bucket="${TEST_S3_VERSIONED_BUCKET:-$TEST_S3_BUCKET}"
  local prefix ts stub="$CASE_ROOT/stub" listing
  local -a server=()
  [[ -z "$endpoint" ]] || server=(AWS_ENDPOINT_URL="$endpoint")
  prefix="$(t_s3_prefix rotation-versioned)"
  make_curl_stub "$stub" trace
  for ts in 20250101_000001 20250101_000002; do
    run_backup_with_env "${server[@]}" -- -v app -T "$ts" -b "$bucket" -f "$prefix" || return 1
  done
  run_backup_with_env "${server[@]}" PATH="$stub:$PATH" -- \
    -v app -T 20250101_000003 -R 1 -b "$bucket" -f "$prefix" || return 1

  listing="$(t_s3_list_keys "${prefix}/" "$endpoint" "$bucket")"
  [[ "$listing" == "${prefix}/app_20250101_000003.tar ${prefix}/app_20250101_000003.tar.sha256 " ]] || {
    log "Unexpected listing after rotation: $listing"
    return 1
  }
  ! grep -qi 'versionId' "$stub/curl.trace" || {
    log "BUG: rotation addressed object versions"
    return 1
  }

  # Clean up this prefix in the versioned bucket
  local key
  endpoint="${endpoint:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  for key in $listing; do
    curl -K "$T_S3_CONFIG" -o /dev/null -X DELETE "${endpoint%/}/${bucket}/${key}" || true
  done
}

test_gnu_tar_features_are_detected_reliably() {
  is_gnu_tar || return "$SKIP_RC"
  setup_case "gnu_tar_features_are_detected_reliably"
  make_volume_content "alpha"

  # A tar whose version banner arrives in two writes: a reader that stops at
  # the first match makes the second write fail with SIGPIPE
  local stub="$CASE_ROOT/stub" real_tar
  real_tar="$(command -v tar)"
  mkdir -p "$stub"
  cat > "$stub/tar" <<STUB
#!/usr/bin/env bash
if [[ "\$1" == --version ]]; then
  printf 'tar (GNU tar) 1.35\n'
  sleep 0.2
  printf 'Copyright (C) 2023 Free Software Foundation, Inc.\n'
  exit 0
fi
printf '%s\n' "\$*" >> '$stub/trace'
exec '$real_tar' "\$@"
STUB
  chmod +x "$stub/tar"

  run_backup_with_env PATH="$stub:$PATH" -- -v alpha -T 20250101_901000 || return 1
  prepare_target_volume "alpha_restore"
  run_restore_with_env PATH="$stub:$PATH" -- -i alpha_20250101_901000.tar -t alpha_restore || return 1

  if ! grep -q -- '--create.*--xattrs' "$stub/trace" || ! grep -q -- '--extract.*--xattrs' "$stub/trace"; then
    log "BUG: GNU tar was not detected; archives lose ACLs and extended attributes:"
    cat "$stub/trace" >&2
    return 1
  fi
}

test_failed_rollback_keeps_the_journal() {
  setup_case "failed_rollback_keeps_the_journal"
  setup_two_volume_transaction || return 1

  # Moves out of journal/old fail while the control file exists
  local stub="$CASE_ROOT/stub" real_mv
  real_mv="$(command -v mv)"
  write_wrapper "$stub" mv <<STUB
#!/usr/bin/env bash
for arg in "\$@"; do src="\${dst:-}"; dst="\$arg"; done
if [[ -e '$CASE_ROOT/mv.fail' && "\$src" == */.vb-restore/old/* ]]; then
  : > '$CASE_ROOT/mv.fired'
  printf 'mv: injected failure\n' >&2
  exit 1
fi
exec '$real_mv' "\$@"
STUB
  : > "$CASE_ROOT/mv.fail"

  # Interrupted before the commit: the rollback cannot move old data back
  start_paused_restore txn_before_decision PATH="$stub:$PATH" -- -a -T "$TXN_TS" -C
  wait_for_point txn_before_decision || return 1
  local pid rc=0
  pid="$(paused_script_pid)" || return 1
  kill -TERM "$pid"
  wait "$PAUSED_PID" || rc=$?
  [[ -e "$CASE_ROOT/mv.fired" ]] || {
    log "The injected mv failure never happened"
    return 1
  }
  (( rc != 0 )) || return 1

  # The original data of beta must still be in its journal
  [[ -d "$TEST_VOLUMES_ROOT/beta/.vb-restore/old" ]] || {
    log "BUG: the journal of beta is gone although its rollback failed"
    return 1
  }
  assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/.vb-restore/old/marker.txt" "old-beta" || return 1

  rm -f "$CASE_ROOT/mv.fail"
  run_restore -X || return 1
  assert_group_state old || return 1
}

test_xattr_marker_fallback_and_failure() {
  setup_case "xattr_marker_fallback_and_failure"
  make_volume_content "alpha"
  local ts="20250101_902000"
  run_backup -v alpha -T "$ts" || return 1
  copy_volume_snapshot "alpha" "$CASE_ROOT/new-alpha"

  local stub="$CASE_ROOT/stub" real_setfattr
  real_setfattr="$(command -v setfattr || true)"
  write_wrapper "$stub" setfattr <<STUB
#!/usr/bin/env bash
target="\${!#}"
fail() {
  : > '$CASE_ROOT/setfattr.fired'
  printf 'setfattr: %s: %s\n' "\$target" "\$1" >&2
  exit 1
}
case "\$(cat '$CASE_ROOT/setfattr.mode' 2>/dev/null)" in
  unsupported) fail "Operation not supported" ;;
  eio-finalize)
    if [[ " \$* " == *" -v "* && "\$(head -n 1 "\$target/.vb-restore/state" 2>/dev/null)" == finalize ]]; then
      fail "Input/output error"
    fi
    ;;
  eio-early)
    if [[ " \$* " == *" -v "* && ! -e "\$target/.vb-restore" ]]; then
      fail "Input/output error"
    fi
    ;;
esac
if [[ -n '$real_setfattr' ]]; then
  exec '$real_setfattr' "\$@"
fi
exit 0
STUB

  # Not supported: the restore works without the marker
  printf 'unsupported\n' > "$CASE_ROOT/setfattr.mode"
  replace_volume_with_marker "alpha" "old"
  run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha -C 2> "$CASE_ROOT/unsupported.log" || {
    cat "$CASE_ROOT/unsupported.log" >&2
    return 1
  }
  [[ -e "$CASE_ROOT/setfattr.fired" ]] || return 1
  assert_dirs_equal "$CASE_ROOT/new-alpha" "$TEST_VOLUMES_ROOT/alpha" || return 1

  # A failure while finalizing keeps the journal; recovery completes it
  rm -f "$CASE_ROOT/setfattr.fired"
  printf 'eio-finalize\n' > "$CASE_ROOT/setfattr.mode"
  replace_volume_with_marker "alpha" "old"
  expect_injected_failure "$CASE_ROOT/setfattr.fired" \
    run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha -C || return 1
  [[ "$(head -n 1 "$TEST_VOLUMES_ROOT/alpha/.vb-restore/state" 2>/dev/null)" == finalize ]] || {
    log "BUG: the journal did not stay in phase finalize after a failed marker"
    return 1
  }
  run_restore -X || return 1
  assert_dirs_equal "$CASE_ROOT/new-alpha" "$TEST_VOLUMES_ROOT/alpha" || return 1
  assert_no_reserved_entries alpha || return 1

  # A failure before the journal exists leaves the volume untouched
  rm -f "$CASE_ROOT/setfattr.fired"
  printf 'eio-early\n' > "$CASE_ROOT/setfattr.mode"
  replace_volume_with_marker "alpha" "old"
  local before
  before="$(volume_state alpha)"
  expect_injected_failure "$CASE_ROOT/setfattr.fired" \
    run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha -C || return 1
  [[ "$(volume_state alpha)" == "$before" ]] || {
    log "BUG: a failure before the journal existed changed the volume"
    return 1
  }
}

test_signal_after_commit_decision_does_not_roll_back() {
  setup_case "signal_after_commit_decision_does_not_roll_back"
  setup_two_volume_transaction || return 1

  # TERM right after the decision was made durable (alpha is the coordinator)
  local stub="$CASE_ROOT/stub" real_sync journal
  real_sync="$(command -v sync)"
  journal="$(cd "$TEST_VOLUMES_ROOT/alpha" && pwd -P)/.vb-restore"
  write_wrapper "$stub" sync <<STUB
#!/usr/bin/env bash
'$real_sync' "\$@"
rc=\$?
if [[ -e '$CASE_ROOT/sync.arm' && "\${!#}" == '$journal' && -e '$journal/decision' ]]; then
  rm -f '$CASE_ROOT/sync.arm'
  : > '$CASE_ROOT/sync.fired'
  kill -TERM "\$PPID"
fi
exit \$rc
STUB
  : > "$CASE_ROOT/sync.arm"

  local rc=0
  run_restore_with_env PATH="$stub:$PATH" -- -a -T "$TXN_TS" -C > "$CASE_ROOT/restore.log" 2>&1 || rc=$?
  [[ -e "$CASE_ROOT/sync.fired" ]] || {
    log "The signal was never sent"
    return 1
  }
  (( rc != 0 )) || return 1

  # Committed: both volumes keep the new data, the decision stays
  local vol
  for vol in alpha beta; do
    [[ "$(volume_manifest_without_journal "$TEST_VOLUMES_ROOT/$vol")" == "$(tree_manifest "$CASE_ROOT/new-$vol")" ]] || {
      log "BUG: $vol was rolled back although the commit decision was durable"
      cat "$CASE_ROOT/restore.log" >&2
      return 1
    }
  done
  [[ "$(head -n 1 "$journal/decision")" == commit ]] || return 1

  run_restore -X || return 1
  assert_group_state new || return 1
}

test_invalid_commit_decision_stops_recovery() {
  setup_case "invalid_commit_decision_stops_recovery"
  setup_two_volume_transaction || return 1
  restore_crashing_at txn_after_decision -- -a -T "$TXN_TS" -C || return 1

  local decision="$TEST_VOLUMES_ROOT/alpha/.vb-restore/decision" before variant
  for variant in garbage directory; do
    rm -rf "$decision"
    if [[ "$variant" == garbage ]]; then
      printf 'commmit\n' > "$decision"
    else
      mkdir "$decision"
    fi
    before="$(volume_state alpha beta)"
    expect_rejected run_restore -X || return 1
    [[ "$(volume_state alpha beta)" == "$before" ]] || {
      log "BUG: recovery acted on an unreadable commit decision ($variant)"
      return 1
    }
  done

  rm -rf "$decision"
  printf 'commit\n' > "$decision"
  run_restore -X || return 1
  assert_group_state new || return 1
}

# Backups of alpha and beta in S3, a curl stub in <mode> that lets the
# complete pair of alpha through and fails afterwards: restore -a and -l must
# refuse, and the volumes stay as they are. <setup>, if given, is called with
# the stub directory to add more wrappers (which touch its "fired" too).
#   check_incomplete_listing_is_refused <case> <mode> [<setup>]
check_incomplete_listing_is_refused() {
  local name="$1" mode="$2" setup="${3:-}" ts="20250101_903000" prefix stub
  require_s3_or_skip || return $?
  setup_case "$name"
  make_volume_content "alpha"
  make_volume_content "beta"
  prefix="$(t_s3_prefix "$name")"
  run_backup -a -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  replace_volume_with_marker "alpha" "old-alpha"
  replace_volume_with_marker "beta" "old-beta"

  stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" "$mode"
  [[ -z "$setup" ]] || "$setup" "$stub"
  expect_injected_failure "$stub/fired" \
    run_restore_with_env PATH="$stub:$PATH" -- -a -b "$TEST_S3_BUCKET" -f "$prefix" -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old-alpha" || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/marker.txt" "old-beta" || return 1
  assert_no_reserved_entries alpha beta || return 1

  rm -f "$stub/fired" "$stub"/*.count
  expect_injected_failure "$stub/fired" \
    run_restore_with_env PATH="$stub:$PATH" -- -l -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
}

test_s3_failed_listing_page_fails_optional() {
  check_incomplete_listing_is_refused "s3_failed_listing_page_fails_optional" list-paged-fail
}

test_s3_truncated_listing_fails_optional() {
  check_incomplete_listing_is_refused "s3_truncated_listing_fails_optional" list-truncated
}

# The parser of the second page (beta) fails; matched by its awk program
listing_parser_fails_on_page_2() {
  # shellcheck disable=SC2016
  write_failing_wrapper "$1" awk '$1 == "Contents"' 2
}

test_s3_failed_listing_parser_fails_optional() {
  check_incomplete_listing_is_refused "s3_failed_listing_parser_fails_optional" list-paged \
    listing_parser_fails_on_page_2
}

# Reading the first page (alpha) to see whether more follow fails
listing_read_fails() {
  write_failing_wrapper "$1" grep '<IsTruncated>true</IsTruncated>' 1
}

test_s3_unreadable_listing_fails_optional() {
  check_incomplete_listing_is_refused "s3_unreadable_listing_fails_optional" list-paged listing_read_fails
}

test_s3_malformed_listing_fails_optional() {
  check_incomplete_listing_is_refused "s3_malformed_listing_fails_optional" list-malformed
}

test_s3_failed_token_check_fails_optional() {
  require_s3_or_skip || return $?
  setup_case "s3_failed_token_check_fails_optional"
  make_volume_content "alpha"
  make_volume_content "beta"

  local ts="20250101_904100" prefix stub="$CASE_ROOT/stub"
  prefix="$(t_s3_prefix failed-token-check)"
  run_backup -a -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  replace_volume_with_marker "alpha" "old-alpha"
  replace_volume_with_marker "beta" "old-beta"

  # Reading the token of alpha's checksum file (the second token read) fails
  write_failing_wrapper "$stub" awk 'name=x-amz-meta-vb-token' 2
  expect_injected_failure "$stub/fired" \
    run_restore_with_env PATH="$stub:$PATH" -- -a -b "$TEST_S3_BUCKET" -f "$prefix" -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old-alpha" || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/marker.txt" "old-beta" || return 1
  assert_no_reserved_entries alpha beta || return 1
}

test_unreadable_checksum_file_fails_the_catalog() {
  setup_case "unreadable_checksum_file_fails_the_catalog"
  make_volume_content "alpha"
  make_volume_content "beta"

  local ts="20250101_904000" stub="$CASE_ROOT/stub"
  run_backup -a -T "$ts" || return 1
  replace_volume_with_marker "alpha" "old-alpha"
  replace_volume_with_marker "beta" "old-beta"

  # Reading beta's checksum file fails: an I/O error, not a malformed file
  write_failing_wrapper "$stub" awk "/beta_${ts}.tar.sha256" 1
  expect_injected_failure "$stub/fired" run_restore_with_env PATH="$stub:$PATH" -- -a -T "$ts" -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old-alpha" || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/marker.txt" "old-beta" || return 1
  assert_no_reserved_entries alpha beta || return 1

  rm -f "$stub/fired" "$stub"/*.count
  expect_injected_failure "$stub/fired" run_restore_with_env PATH="$stub:$PATH" -- -l || return 1
}

test_failed_sort_stops_backup() {
  setup_case "failed_sort_stops_backup"
  make_volume_content "alpha"
  make_volume_content "beta"
  local stub="$CASE_ROOT/stub" ts

  # The volumes of backup -a and the locks of backup -v come from sort -u
  write_sort_wrapper "$stub" -u
  for ts in 20250101_904300 20250101_904301; do
    rm -f "$stub/fired"
    if [[ "$ts" == *00 ]]; then
      expect_injected_failure "$stub/fired" run_backup_with_env PATH="$stub:$PATH" -- -a -T "$ts" || return 1
    else
      expect_injected_failure "$stub/fired" run_backup_with_env PATH="$stub:$PATH" -- -v alpha -T "$ts" || return 1
    fi
    if compgen -G "$TEST_BACKUP_ROOT/*_${ts}.tar*" > /dev/null; then
      log "BUG: a backup was published although sorting its list failed: $ts"
      return 1
    fi
  done

  # The backups of a volume, newest first, come from sort -r for rotation
  run_backup -v alpha -T 20250101_904310 || return 1
  run_backup -v alpha -T 20250101_904311 || return 1
  write_sort_wrapper "$stub" -r
  rm -f "$stub/fired"
  expect_injected_failure "$stub/fired" \
    run_backup_with_env PATH="$stub:$PATH" -- -v alpha -T 20250101_904312 -R 1 || return 1
  for ts in 20250101_904310 20250101_904311; do
    assert_file_exists "$TEST_BACKUP_ROOT/alpha_${ts}.tar" || return 1
    assert_file_exists "$TEST_BACKUP_ROOT/alpha_${ts}.tar.sha256" || return 1
  done
}

test_failed_sort_stops_restore() {
  setup_case "failed_sort_stops_restore"
  make_volume_content "alpha"
  make_volume_content "beta"
  local ts="20250101_904400" stub="$CASE_ROOT/stub" glob
  run_backup -a -T "$ts" || return 1
  replace_volume_with_marker "alpha" "old-alpha"
  replace_volume_with_marker "beta" "old-beta"

  # restore -a sorts its candidates (-k2,2r), its participants (no options)
  # and its locks (-u); restore -i its lock
  for glob in '*-k2,2r' none -u -u:single; do
    write_sort_wrapper "$stub" "${glob%:single}"
    rm -f "$stub/fired"
    if [[ "$glob" == *:single ]]; then
      expect_injected_failure "$stub/fired" \
        run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha -C || return 1
    else
      expect_injected_failure "$stub/fired" \
        run_restore_with_env PATH="$stub:$PATH" -- -a -T "$ts" -C || return 1
    fi
    assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old-alpha" || return 1
    assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/marker.txt" "old-beta" || return 1
    assert_no_reserved_entries alpha beta || return 1
  done

  # restore -l sorts its rows for display
  write_sort_wrapper "$stub" '*-k2,2'
  rm -f "$stub/fired"
  expect_injected_failure "$stub/fired" run_restore_with_env PATH="$stub:$PATH" -- -l || return 1
}

test_restore_refuses_unreadable_mount_table() {
  setup_case "restore_refuses_unreadable_mount_table"
  make_volume_content "alpha"
  local ts="20250101_904200" missing="$CASE_ROOT/no-mountinfo"
  run_backup -v alpha -T "$ts" || return 1
  replace_volume_with_marker "alpha" "old"

  # Without the mount table, mount points inside the target cannot be ruled out
  expect_rejected run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_MOUNTINFO="$missing" -- \
    -i "alpha_${ts}.tar" -t alpha -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old" || return 1
  assert_no_reserved_entries alpha || return 1

  # A backup is the same either way; only its warning about mount points is lost
  run_backup_with_env VB_TEST_HOOKS=1 VB_TEST_MOUNTINFO="$missing" -- -v alpha -T 20250101_904201 \
    2> "$CASE_ROOT/backup.log" || return 1
  grep -q "Cannot read the mount table" "$CASE_ROOT/backup.log" || {
    log "Expected a warning about the unreadable mount table"
    return 1
  }
}

test_s3_truncated_checksum_fails_optional() {
  require_s3_or_skip || return $?
  setup_case "s3_truncated_checksum_fails_optional"
  make_volume_content "alpha"

  local ts="20250101_903100" prefix stub="$CASE_ROOT/stub"
  prefix="$(t_s3_prefix truncated-checksum)"
  run_backup -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix" || return 1
  replace_volume_with_marker "alpha" "old"
  make_curl_stub "$stub" get-truncated

  # The digest arrives in full, but the transfer broke off
  expect_injected_failure "$stub/fired" run_restore_with_env PATH="$stub:$PATH" -- \
    -i "s3://${TEST_S3_BUCKET}/${prefix}/alpha_${ts}.tar" -t alpha -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old" || return 1
  assert_no_reserved_entries alpha || return 1
}

test_failed_directory_scan_keeps_the_journal() {
  setup_case "failed_directory_scan_keeps_the_journal"
  setup_two_volume_transaction || return 1
  restore_crashing_at txn_swap_entry:beta -- -a -T "$TXN_TS" -C || return 1

  # Listing journal/old fails while the control file exists
  local stub="$CASE_ROOT/stub" real_find
  real_find="$(command -v find)"
  write_wrapper "$stub" find <<STUB
#!/usr/bin/env bash
if [[ -e '$CASE_ROOT/find.fail' && "\$1" == */.vb-restore/old ]]; then
  : > '$CASE_ROOT/find.fired'
  printf 'find: %s: Input/output error\n' "\$1" >&2
  exit 1
fi
exec '$real_find' "\$@"
STUB
  : > "$CASE_ROOT/find.fail"

  expect_injected_failure "$CASE_ROOT/find.fired" run_restore_with_env PATH="$stub:$PATH" -- -X || return 1
  [[ -d "$TEST_VOLUMES_ROOT/beta/.vb-restore/old" ]] || {
    log "BUG: the journal of beta is gone although its old data could not be listed"
    return 1
  }
  assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/.vb-restore/old/marker.txt" "old-beta" || return 1

  rm -f "$CASE_ROOT/find.fail"
  run_restore -X || return 1
  assert_group_state old || return 1
}

test_recovery_rejects_dry_run() {
  setup_case "recovery_rejects_dry_run"
  setup_two_volume_transaction || return 1
  restore_crashing_at txn_after_decision -- -a -T "$TXN_TS" -C || return 1

  local before
  before="$(volume_state alpha beta)"
  expect_rejected run_restore -X -n || return 1
  expect_rejected run_restore -X -C || return 1
  expect_rejected run_restore -X -j 2 || return 1
  [[ "$(volume_state alpha beta)" == "$before" ]] || {
    log "BUG: a refused recovery changed the volumes"
    return 1
  }

  run_restore -X || return 1
  assert_group_state new || return 1
}

# ------------------------------------------------------------------------------
# Test runner
# ------------------------------------------------------------------------------

run_test() {
  local name="$1"
  shift

  # TEST_FILTER (a bash regex) selects tests by function name
  if [[ -n "${TEST_FILTER:-}" && ! "$1" =~ $TEST_FILTER ]]; then
    return 0
  fi

  TESTS_TOTAL=$((TESTS_TOTAL + 1))

  set +e
  "$@"
  local rc=$?
  set -e

  case "$rc" in
    0)
      TESTS_PASSED=$((TESTS_PASSED + 1))
      pass "$name"
      ;;
    "$SKIP_RC")
      TESTS_SKIPPED=$((TESTS_SKIPPED + 1))
      skip "$name"
      ;;
    *)
      TESTS_FAILED=$((TESTS_FAILED + 1))
      fail "$name"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Preflight
# ------------------------------------------------------------------------------

[[ -f "$BACKUP_BIN" ]] || die "Backup script not found: $BACKUP_BIN"
[[ -f "$RESTORE_BIN" ]] || die "Restore script not found: $RESTORE_BIN"

require_command bash
require_command tar
require_command find
require_command diff

if ! command -v gzip >/dev/null 2>&1 && ! command -v pigz >/dev/null 2>&1; then
  die "Neither gzip nor pigz found; compressed tests cannot run"
fi

if [[ "${REQUIRE_XATTR_TESTS:-0}" == 1 ]]; then
  for xattr_command in getfattr setfattr getfacl setfacl; do
    require_command "$xattr_command"
  done
  xattr_tests_enabled || die "REQUIRE_XATTR_TESTS=1, but user extended attributes are not supported under $TEST_ROOT"
fi

log "Using backup script:  $BACKUP_BIN"
log "Using restore script: $RESTORE_BIN"
log "Test root: $TEST_ROOT"

if [[ "${TEST_S3_CREATE_BUCKETS:-0}" == 1 ]] && s3_tests_enabled; then
  t_s3_init
  default_endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  t_s3_create_bucket "$default_endpoint" "$TEST_S3_BUCKET"
  if [[ -n "${TEST_S3_VERSIONED_ENDPOINT:-}${TEST_S3_VERSIONED_BUCKET:-}" ]]; then
    t_s3_create_bucket "${TEST_S3_VERSIONED_ENDPOINT:-$default_endpoint}" "${TEST_S3_VERSIONED_BUCKET:-$TEST_S3_BUCKET}" versioned
  fi
fi
if s3_tests_enabled; then
  log "S3 server: ${TEST_S3_PROVIDER:-unnamed} (${AWS_ENDPOINT_URL:-AWS})"
fi


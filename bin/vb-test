run_test "s3 malformed listing fails"                  test_s3_malformed_listing_fails_optional
run_test "s3 failed token check fails"                 test_s3_failed_token_check_fails_optional
run_test "unreadable checksum file fails the catalog"  test_unreadable_checksum_file_fails_the_catalog
run_test "restore refuses unreadable mount table"      test_restore_refuses_unreadable_mount_table
run_test "failed sort stops backup"                    test_failed_sort_stops_backup
run_test "failed sort stops restore"                   test_failed_sort_stops_restore

# ------------------------------------------------------------------------------
# Summary
# ------------------------------------------------------------------------------

printf '\n' >&2
if [[ -n "${TEST_S3_PROVIDER:-}" ]]; then
  printf 'S3 server   : %s\n' "$TEST_S3_PROVIDER" >&2
fi
printf 'Tests total : %d\n' "$TESTS_TOTAL" >&2
printf 'Passed      : %d\n' "$TESTS_PASSED" >&2
printf 'Skipped     : %d\n' "$TESTS_SKIPPED" >&2
printf 'Failed      : %d\n' "$TESTS_FAILED" >&2

if (( TESTS_FAILED > 0 )); then
  exit 1
fi

exit 0

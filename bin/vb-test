  local ts="20250101_500000"
  local prefix
  prefix="$(t_s3_prefix multipart)"

  # 12 MiB of random data in 5 MiB parts: three parts, the last one short
  run_backup_with_env S3_PART_SIZE=5 -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"

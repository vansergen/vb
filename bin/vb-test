test_s3_multipart_roundtrip_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_multipart_roundtrip_optional"

  make_volume_content "alpha"
  dd if=/dev/urandom of="$TEST_VOLUMES_ROOT/alpha/big.bin" bs=1M count=12 status=none

  local ts="20250101_500000"
  local prefix
  prefix="$(t_s3_prefix multipart)"

  # 12 MiB of random data in 5 MiB parts: three parts, the last one short
  run_backup_with_env S3_PART_SIZE=5 -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "s3://${TEST_S3_BUCKET}/${prefix}/alpha_${ts}.tar" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_s3_failed_stream_publishes_nothing_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_failed_stream_publishes_nothing_optional"
  make_volume_content "alpha"

  # A compressor that emits 7 MiB (more than one 5 MiB part) and then fails:
  # the uploader sees a normal end of stream, but nothing may be published.
  local stub="$CASE_ROOT/stub"
  mkdir -p "$stub"
  printf '#!/usr/bin/env bash\nhead -c 7340032 /dev/urandom\nexit 1\n' > "$stub/pigz"
  chmod +x "$stub/pigz"

  local ts="20250101_510000"
  local prefix key
  prefix="$(t_s3_prefix failed-stream)"
  key="${prefix}/alpha_${ts}.tar.gz"

  local rc=0
  run_backup_with_env S3_PART_SIZE=5 PATH="$stub:$PATH" -- \
    -v alpha -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: backup reported success although the compressor failed"
    return 1
  }

  [[ "$(t_s3_head "$key")" == 404 ]] || {
    log "BUG: a truncated archive was published at $key"
    return 1
  }
  [[ "$(t_s3_head "${key}.sha256")" == 404 ]] || return 1

  [[ "$(t_s3_pending_uploads "$key")" == 0 ]] || {
    log "BUG: the failed multipart upload was not aborted"
    return 1
  }
}

test_s3_concurrent_object_is_not_overwritten_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_concurrent_object_is_not_overwritten_optional"
  make_volume_content "alpha"

  local ts="20250101_520000"
  local prefix key
  prefix="$(t_s3_prefix concurrent)"
  key="${prefix}/alpha_${ts}.tar"

  start_paused_backup s3_before_complete -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point s3_before_complete || return 1

  # Another writer publishes the same key after our existence check
  printf 'foreign\n' > "$CASE_ROOT/foreign.bin"
  [[ "$(t_s3_put "$key" "$CASE_ROOT/foreign.bin")" == 200 ]] || return 1

  local rc=0
  resume_and_wait s3_before_complete 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup overwrote an object that appeared while it was uploading"
    return 1
  }

  t_s3_get "$key" "$CASE_ROOT/after.bin" || return 1
  cmp -s "$CASE_ROOT/foreign.bin" "$CASE_ROOT/after.bin" || {
    log "BUG: the concurrently written object was replaced"
    return 1
  }
  [[ "$(t_s3_pending_uploads "$key")" == 0 ]] || return 1
}

test_s3_requires_conditional_writes_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_requires_conditional_writes_optional"
  make_volume_content "alpha"

  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" complete-501

  local prefix
  prefix="$(t_s3_prefix no-conditional)"

  local rc=0
  run_backup_with_env PATH="$stub:$PATH" -- \
    -v alpha -T 20250101_530000 -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup published without overwrite protection and without opt-in"
    return 1
  }
  [[ "$(t_s3_head "${prefix}/alpha_20250101_530000.tar")" == 404 ]] || return 1

  # Explicit opt-in publishes without the condition
  run_backup_with_env PATH="$stub:$PATH" S3_ALLOW_UNCONDITIONAL_WRITES=1 -- \
    -v alpha -T 20250101_530001 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "s3://${TEST_S3_BUCKET}/${prefix}/alpha_20250101_530001.tar" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_s3_lost_complete_response_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_lost_complete_response_optional"
  make_volume_content "alpha"

  local prefix
  prefix="$(t_s3_prefix lost-response)"

  # Our own completion succeeded but the response got lost: the retry sees
  # the object, recognises our token, and the backup succeeds.
  local stub_ours="$CASE_ROOT/stub-ours"
  make_curl_stub "$stub_ours" complete-lost
  run_backup_with_env PATH="$stub_ours:$PATH" -- \
    -v alpha -T 20250101_540000 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "s3://${TEST_S3_BUCKET}/${prefix}/alpha_20250101_540000.tar" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1

  # Someone else's object occupies the key: the retry sees a foreign token
  local stub_foreign="$CASE_ROOT/stub-foreign"
  make_curl_stub "$stub_foreign" complete-lost-foreign
  local key="${prefix}/alpha_20250101_540001.tar"
  local rc=0
  run_backup_with_env PATH="$stub_foreign:$PATH" -- \
    -v alpha -T 20250101_540001 -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup claimed a foreign object as its own"
    return 1
  }

  t_s3_get "$key" "$CASE_ROOT/after.bin" || return 1
  [[ "$(cat "$CASE_ROOT/after.bin")" == foreign ]] || return 1
  [[ "$(t_s3_head "${key}.sha256")" == 404 ]] || return 1
}

test_s3_sidecar_conflict_keeps_archive_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_sidecar_conflict_keeps_archive_optional"
  make_volume_content "alpha"

  local ts="20250101_550000"
  local prefix key
  prefix="$(t_s3_prefix sidecar-conflict)"
  key="${prefix}/alpha_${ts}.tar"

  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" trace

  start_paused_backup s3_before_sidecar PATH="$stub:$PATH" -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point s3_before_sidecar || return 1

  printf '%064d  foreign\n' 1 > "$CASE_ROOT/foreign.sha256"
  [[ "$(t_s3_put "${key}.sha256" "$CASE_ROOT/foreign.sha256")" == 200 ]] || return 1

  local rc=0
  resume_and_wait s3_before_sidecar 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup reported success although its sidecar could not be published"
    return 1
  }

  [[ "$(t_s3_head "$key")" == 200 ]] || {
    log "BUG: the uploaded archive was removed"
    return 1
  }
  t_s3_get "${key}.sha256" "$CASE_ROOT/after.sha256" || return 1
  cmp -s "$CASE_ROOT/foreign.sha256" "$CASE_ROOT/after.sha256" || {
    log "BUG: the foreign sidecar was overwritten"
    return 1
  }

  # No object DELETE at all (aborting a multipart upload uses ?uploadId=)
  ! grep -E -- '-X DELETE' "$stub/curl.trace" | grep -vq 'uploadId=' || {
    log "BUG: backup issued an object DELETE"
    return 1
  }

  # Without -U, the archive whose sidecar is foreign must not be restored
  prepare_target_volume "alpha_restore"
  rc=0
  run_restore -i "s3://${TEST_S3_BUCKET}/${key}" -t alpha_restore 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: restore accepted an archive with a mismatching sidecar"
    return 1
  }
}

test_s3_credentials_stay_off_the_command_line_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_credentials_stay_off_the_command_line_optional"
  make_volume_content "alpha"

  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" trace

  local ts="20250101_560000"
  local prefix
  prefix="$(t_s3_prefix credentials)"

  start_paused_backup s3_before_complete PATH="$stub:$PATH" -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point s3_before_complete || return 1

  # No running process may carry the secret in its command line
  # No process of the paused backup may carry the secret in its command line.
  # Compare inside bash: an external grep would carry the secret in its argv.
  local pid content leaked=0
  while IFS= read -r pid; do
    content="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null)" || continue
    [[ "$content" != *"$AWS_SECRET_ACCESS_KEY"* ]] || leaked=1
  done < <(process_tree_pids "$PAUSED_PID")

  resume_and_wait s3_before_complete 2>/dev/null || return 1

  (( leaked == 0 )) || {
    log "BUG: the S3 secret appeared in a process command line"
    return 1
  }

  local trace
  trace="$(cat "$stub/curl.trace")"
  [[ -n "$trace" && "$trace" != *"$AWS_SECRET_ACCESS_KEY"* ]] || {
    log "BUG: the S3 secret was passed to curl on the command line (or curl was never called)"
    return 1
  }
}

# ------------------------------------------------------------------------------
# Test runner
# ------------------------------------------------------------------------------

run_test() {
  local name="$1"
  shift

  TESTS_TOTAL=$((TESTS_TOTAL + 1))

  set +e
  "$@"
  local rc=$?
  set -e

  case "$rc" in
    0)
      TESTS_PASSED=$((TESTS_PASSED + 1))
      pass "$name"
      ;;
    "$SKIP_RC")
      TESTS_SKIPPED=$((TESTS_SKIPPED + 1))
      skip "$name"
      ;;
    *)
      TESTS_FAILED=$((TESTS_FAILED + 1))
      fail "$name"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Preflight
# ------------------------------------------------------------------------------

[[ -f "$BACKUP_BIN" ]] || die "Backup script not found: $BACKUP_BIN"
[[ -f "$RESTORE_BIN" ]] || die "Restore script not found: $RESTORE_BIN"

require_command bash
require_command tar
require_command find
require_command diff

if ! command -v gzip >/dev/null 2>&1 && ! command -v pigz >/dev/null 2>&1; then
  die "Neither gzip nor pigz found; compressed tests cannot run"
fi

log "Using backup script:  $BACKUP_BIN"
log "Using restore script: $RESTORE_BIN"
log "Test root: $TEST_ROOT"

# ------------------------------------------------------------------------------
# Execute tests
# ------------------------------------------------------------------------------

run_test "single backup/restore plain"              test_single_backup_restore_plain
run_test "single backup/restore compressed"         test_single_backup_restore_compressed
run_test "single backup/restore symmetric"          test_single_backup_restore_symmetric
run_test "single backup/restore asymmetric"         test_single_backup_restore_asymmetric
run_test "all-mode filters + parallel"              test_all_mode_with_filters_and_parallel
run_test "backup single dry-run"                    test_backup_single_dry_run_creates_nothing
run_test "backup all dry-run"                       test_backup_all_dry_run_creates_nothing
run_test "restore single dry-run"                   test_restore_single_dry_run_changes_nothing
run_test "restore fails without -C on non-empty"    test_restore_fails_on_non_empty_without_clear_flag
run_test "backup fails on duplicate timestamp"      test_backup_fails_on_duplicate_timestamp
run_test "restore all: picks latest without -T"     test_restore_all_no_timestamp_picks_latest
run_test "restore all dry-run"                      test_restore_all_dry_run_changes_nothing
run_test "restore single: filename-only source"     test_restore_single_source_filename_only
run_test "backup root override (-d)"                test_backup_root_override
run_test "asymmetric GPG via env vars"              test_backup_restore_asymmetric_env_keys
run_test "single backup/restore .tar.gpg"           test_single_backup_restore_tar_gpg
run_test "volume names with dots and dashes"        test_volume_names_with_dots_and_dashes
run_test "BACKUP_TIMESTAMP via env var"             test_backup_timestamp_env_var
run_test "invalid flags and missing args"           test_invalid_flags_and_missing_args
run_test "restore: leftover tmp does not block"     test_restore_leftover_tmp_does_not_block
run_test "restore is atomic on failure"             test_restore_is_atomic_on_failure
run_test "backup/restore sparse file"               test_backup_restore_sparse_file
run_test "restore fails: VOLUMES_ROOT missing"      test_restore_fails_when_volumes_root_missing
run_test "restore fails: target not mounted"        test_restore_fails_when_target_not_mounted
run_test "local checksum detects tampering"         test_local_checksum_detects_tampering_after_move
run_test "rejects ./.. and escaping volume names"   test_rejects_dot_and_escaping_volume_names
run_test "restore all: skips dot-named files"       test_restore_all_skips_dot_named_backup_files
run_test "-j is validated before use"               test_jobs_value_is_validated_before_use
run_test "s3 backup fails closed on HEAD error"     test_s3_backup_fails_closed_on_head_error
run_test "s3 rejects unsafe keys"                   test_s3_rejects_unsafe_keys
run_test "s3 roundtrip (optional)"                  test_s3_roundtrip_optional
run_test "s3 checksum roundtrip (optional)"         test_s3_checksum_roundtrip_optional
run_test "s3 backup fails on overwrite (optional)"  test_s3_backup_fails_on_overwrite_optional
run_test "s3 roundtrip encrypted (optional)"        test_s3_roundtrip_encrypted_optional
run_test "s3 multipart roundtrip (optional)"        test_s3_multipart_roundtrip_optional
run_test "s3 failed stream publishes nothing"       test_s3_failed_stream_publishes_nothing_optional
run_test "s3 concurrent object kept (optional)"     test_s3_concurrent_object_is_not_overwritten_optional
run_test "s3 needs conditional writes (optional)"   test_s3_requires_conditional_writes_optional
run_test "s3 lost Complete response (optional)"     test_s3_lost_complete_response_optional
run_test "s3 sidecar conflict keeps archive"        test_s3_sidecar_conflict_keeps_archive_optional
run_test "s3 credentials not on command line"       test_s3_credentials_stay_off_the_command_line_optional

# ------------------------------------------------------------------------------
# Summary
# ------------------------------------------------------------------------------

printf '\n' >&2
printf 'Tests total : %d\n' "$TESTS_TOTAL" >&2
printf 'Passed      : %d\n' "$TESTS_PASSED" >&2
printf 'Skipped     : %d\n' "$TESTS_SKIPPED" >&2
printf 'Failed      : %d\n' "$TESTS_FAILED" >&2

if (( TESTS_FAILED > 0 )); then
  exit 1
fi

exit 0

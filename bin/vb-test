test_s3_multipart_roundtrip_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_multipart_roundtrip_optional"

  make_volume_content "alpha"
  dd if=/dev/urandom of="$TEST_VOLUMES_ROOT/alpha/big.bin" bs=1M count=12 status=none

  local ts="20250101_500000"
  local prefix
  prefix="$(t_s3_prefix multipart)"

  # 12 MiB of random data in 5 MiB parts: three parts, the last one short
  run_backup_with_env S3_PART_SIZE=5 -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "s3://${TEST_S3_BUCKET}/${prefix}/alpha_${ts}.tar" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_s3_failed_stream_publishes_nothing_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_failed_stream_publishes_nothing_optional"
  make_volume_content "alpha"

  # A compressor that emits 7 MiB (more than one 5 MiB part) and then fails:
  # the uploader sees a normal end of stream, but nothing may be published.
  local stub="$CASE_ROOT/stub"
  mkdir -p "$stub"
  printf '#!/usr/bin/env bash\nhead -c 7340032 /dev/urandom\nexit 1\n' > "$stub/pigz"
  chmod +x "$stub/pigz"

  local ts="20250101_510000"
  local prefix key
  prefix="$(t_s3_prefix failed-stream)"
  key="${prefix}/alpha_${ts}.tar.gz"

  local rc=0
  run_backup_with_env S3_PART_SIZE=5 PATH="$stub:$PATH" -- \
    -v alpha -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: backup reported success although the compressor failed"
    return 1
  }

  [[ "$(t_s3_head "$key")" == 404 ]] || {
    log "BUG: a truncated archive was published at $key"
    return 1
  }
  [[ "$(t_s3_head "${key}.sha256")" == 404 ]] || return 1

  [[ "$(t_s3_pending_uploads "$key")" == 0 ]] || {
    log "BUG: the failed multipart upload was not aborted"
    return 1
  }
}

test_s3_concurrent_object_is_not_overwritten_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_concurrent_object_is_not_overwritten_optional"
  make_volume_content "alpha"

  local ts="20250101_520000"
  local prefix key
  prefix="$(t_s3_prefix concurrent)"
  key="${prefix}/alpha_${ts}.tar"

  start_paused_backup s3_before_complete -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point s3_before_complete || return 1

  # Another writer publishes the same key after our existence check
  printf 'foreign\n' > "$CASE_ROOT/foreign.bin"
  [[ "$(t_s3_put "$key" "$CASE_ROOT/foreign.bin")" == 200 ]] || return 1

  local rc=0
  resume_and_wait s3_before_complete 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup overwrote an object that appeared while it was uploading"
    return 1
  }

  t_s3_get "$key" "$CASE_ROOT/after.bin" || return 1
  cmp -s "$CASE_ROOT/foreign.bin" "$CASE_ROOT/after.bin" || {
    log "BUG: the concurrently written object was replaced"
    return 1
  }
  [[ "$(t_s3_pending_uploads "$key")" == 0 ]] || return 1
}

test_s3_requires_conditional_writes_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_requires_conditional_writes_optional"
  make_volume_content "alpha"

  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" complete-501

  local prefix
  prefix="$(t_s3_prefix no-conditional)"

  local rc=0
  run_backup_with_env PATH="$stub:$PATH" -- \
    -v alpha -T 20250101_530000 -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup published without overwrite protection and without opt-in"
    return 1
  }
  [[ "$(t_s3_head "${prefix}/alpha_20250101_530000.tar")" == 404 ]] || return 1

  # Explicit opt-in publishes without the condition
  run_backup_with_env PATH="$stub:$PATH" S3_ALLOW_UNCONDITIONAL_WRITES=1 -- \
    -v alpha -T 20250101_530001 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "s3://${TEST_S3_BUCKET}/${prefix}/alpha_20250101_530001.tar" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_s3_lost_complete_response_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_lost_complete_response_optional"
  make_volume_content "alpha"

  local prefix
  prefix="$(t_s3_prefix lost-response)"

  # Our own completion succeeded but the response got lost: the retry sees
  # the object, recognises our token, and the backup succeeds.
  local stub_ours="$CASE_ROOT/stub-ours"
  make_curl_stub "$stub_ours" complete-lost
  run_backup_with_env PATH="$stub_ours:$PATH" -- \
    -v alpha -T 20250101_540000 -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "s3://${TEST_S3_BUCKET}/${prefix}/alpha_20250101_540000.tar" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1

  # Someone else's object occupies the key: the retry sees a foreign token
  local stub_foreign="$CASE_ROOT/stub-foreign"
  make_curl_stub "$stub_foreign" complete-lost-foreign
  local key="${prefix}/alpha_20250101_540001.tar"
  local rc=0
  run_backup_with_env PATH="$stub_foreign:$PATH" -- \
    -v alpha -T 20250101_540001 -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup claimed a foreign object as its own"
    return 1
  }

  t_s3_get "$key" "$CASE_ROOT/after.bin" || return 1
  [[ "$(cat "$CASE_ROOT/after.bin")" == foreign ]] || return 1
  [[ "$(t_s3_head "${key}.sha256")" == 404 ]] || return 1
}

test_s3_sidecar_conflict_keeps_archive_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_sidecar_conflict_keeps_archive_optional"
  make_volume_content "alpha"

  local ts="20250101_550000"
  local prefix key
  prefix="$(t_s3_prefix sidecar-conflict)"
  key="${prefix}/alpha_${ts}.tar"

  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" trace

  start_paused_backup s3_before_sidecar PATH="$stub:$PATH" -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point s3_before_sidecar || return 1

  printf '%064d  foreign\n' 1 > "$CASE_ROOT/foreign.sha256"
  [[ "$(t_s3_put "${key}.sha256" "$CASE_ROOT/foreign.sha256")" == 200 ]] || return 1

  local rc=0
  resume_and_wait s3_before_sidecar 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: backup reported success although its sidecar could not be published"
    return 1
  }

  [[ "$(t_s3_head "$key")" == 200 ]] || {
    log "BUG: the uploaded archive was removed"
    return 1
  }
  t_s3_get "${key}.sha256" "$CASE_ROOT/after.sha256" || return 1
  cmp -s "$CASE_ROOT/foreign.sha256" "$CASE_ROOT/after.sha256" || {
    log "BUG: the foreign sidecar was overwritten"
    return 1
  }

  # No object DELETE at all (aborting a multipart upload uses ?uploadId=)
  ! grep -E -- '-X DELETE' "$stub/curl.trace" | grep -vq 'uploadId=' || {
    log "BUG: backup issued an object DELETE"
    return 1
  }

  # Without -U, the archive whose sidecar is foreign must not be restored
  prepare_target_volume "alpha_restore"
  rc=0
  run_restore -i "s3://${TEST_S3_BUCKET}/${key}" -t alpha_restore 2>/dev/null || rc=$?
  (( rc != 0 )) || {
    log "BUG: restore accepted an archive with a mismatching sidecar"
    return 1
  }
}

test_s3_credentials_stay_off_the_command_line_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_credentials_stay_off_the_command_line_optional"
  make_volume_content "alpha"

  local stub="$CASE_ROOT/stub"
  make_curl_stub "$stub" trace

  local ts="20250101_560000"
  local prefix
  prefix="$(t_s3_prefix credentials)"

  start_paused_backup s3_before_complete PATH="$stub:$PATH" -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point s3_before_complete || return 1

  # No running process may carry the secret in its command line
  # No process of the paused backup may carry the secret in its command line.
  # Compare inside bash: an external grep would carry the secret in its argv.
  local pid content leaked=0
  while IFS= read -r pid; do
    content="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null)" || continue
    [[ "$content" != *"$AWS_SECRET_ACCESS_KEY"* ]] || leaked=1
  done < <(process_tree_pids "$PAUSED_PID")

  resume_and_wait s3_before_complete 2>/dev/null || return 1

  (( leaked == 0 )) || {
    log "BUG: the S3 secret appeared in a process command line"
    return 1
  }

  local trace
  trace="$(cat "$stub/curl.trace")"
  [[ -n "$trace" && "$trace" != *"$AWS_SECRET_ACCESS_KEY"* ]] || {
    log "BUG: the S3 secret was passed to curl on the command line (or curl was never called)"
    return 1
  }
}

# ------------------------------------------------------------------------------
# Transactional restore helpers
# ------------------------------------------------------------------------------

# Runs restore with a crash injected at <point> (the whole run is killed with
# SIGKILL there). Fails if the run was not killed.
#   restore_crashing_at <point> [env assignments...] -- <restore args...>
restore_crashing_at() {
  local point="$1" rc=0
  shift
  run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_FAIL_AT="$point" "$@" >/dev/null 2>&1 || rc=$?
  (( rc == 137 )) || {
    log "Expected restore to be killed at '$point' (exit 137), got exit $rc"
    return 1
  }
}

recover_crashing_at() {
  local point="$1" rc=0
  run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_FAIL_AT="$point" -- -X >/dev/null 2>&1 || rc=$?
  (( rc == 137 )) || {
    log "Expected recovery to be killed at '$point' (exit 137), got exit $rc"
    return 1
  }
}

# Lists reserved entries left in a volume (should be empty after recovery)
reserved_entries() {
  find "$1" -mindepth 1 -maxdepth 1 \( -name '.vb-restore*' -o -name '.restore-in-progress.*' \) -printf '%f\n'
}

assert_no_reserved_entries() {
  local vol left
  for vol in "$@"; do
    left="$(reserved_entries "$TEST_VOLUMES_ROOT/$vol")"
    [[ -z "$left" ]] || {
      log "Reserved entries left in $vol: $left"
      return 1
    }
  done
}

# Two volumes with backups at TXN_TS (the "new" data, kept in new-*) and
# different current contents (the "old" data, kept in old-*). The metadata of
# each volume root is kept in <snapshot>.root.
setup_two_volume_transaction() {
  TXN_TS="20250101_600000"
  local vol
  for vol in alpha beta; do
    make_volume_content "$vol"
    chmod 0750 "$TEST_VOLUMES_ROOT/$vol"
    touch -d '2021-05-06 07:08:09' "$TEST_VOLUMES_ROOT/$vol"
    copy_volume_snapshot "$vol" "$CASE_ROOT/new-$vol"
    dir_root_metadata "$TEST_VOLUMES_ROOT/$vol" > "$CASE_ROOT/new-$vol.root"
  done
  run_backup -a -T "$TXN_TS" -c || return 1

  for vol in alpha beta; do
    replace_volume_with_marker "$vol" "old-$vol"
    printf 'second old entry\n' > "$TEST_VOLUMES_ROOT/$vol/second.txt"
    mkdir -p "$TEST_VOLUMES_ROOT/$vol/old-dir"
    printf 'third\n' > "$TEST_VOLUMES_ROOT/$vol/old-dir/third.txt"
    touch -d '2019-01-02 03:04:05' "$TEST_VOLUMES_ROOT/$vol"
    copy_volume_snapshot "$vol" "$CASE_ROOT/old-$vol"
    dir_root_metadata "$TEST_VOLUMES_ROOT/$vol" > "$CASE_ROOT/old-$vol.root"
  done
}

# Puts the old data back into both volumes
reset_two_volume_transaction() {
  local vol
  for vol in alpha beta; do
    rm -rf "${TEST_VOLUMES_ROOT:?}/$vol"
    mkdir -p "$TEST_VOLUMES_ROOT/$vol"
    cp -a "$CASE_ROOT/old-$vol/." "$TEST_VOLUMES_ROOT/$vol/"
    touch -d '2019-01-02 03:04:05' "$TEST_VOLUMES_ROOT/$vol"
    dir_root_metadata "$TEST_VOLUMES_ROOT/$vol" > "$CASE_ROOT/old-$vol.root"
  done
}

# Both volumes hold the <old|new> data, including the metadata of their
# roots (the root mtime survives every crash only with user xattrs), and no
# journal is left.
assert_group_state() {
  local expected="$1" vol
  for vol in alpha beta; do
    assert_dirs_equal "$CASE_ROOT/${expected}-${vol}" "$TEST_VOLUMES_ROOT/$vol" || {
      log "Volume $vol does not hold the ${expected} data"
      return 1
    }
    if xattr_tests_enabled; then
      [[ "$(dir_root_metadata "$TEST_VOLUMES_ROOT/$vol")" == "$(cat "$CASE_ROOT/${expected}-${vol}.root")" ]] || {
        log "Root of $vol: expected '$(cat "$CASE_ROOT/${expected}-${vol}.root")', got '$(dir_root_metadata "$TEST_VOLUMES_ROOT/$vol")'"
        return 1
      }
    fi
  done
  assert_no_reserved_entries alpha beta || return 1
}

# ------------------------------------------------------------------------------
# Transactional restore tests
# ------------------------------------------------------------------------------

test_restore_empty_volume_roundtrip() {
  setup_case "restore_empty_volume_roundtrip"

  mkdir -p "$TEST_VOLUMES_ROOT/empty"
  local ts="20250101_610000"

  run_backup -v empty -T "$ts" || return 1
  prepare_target_volume "empty_restore"
  run_restore -i "empty_${ts}.tar" -t empty_restore || return 1
  [[ -z "$(ls -A "$TEST_VOLUMES_ROOT/empty_restore")" ]] || return 1

  # Replacing a non-empty volume with an empty backup empties it
  printf 'old\n' > "$TEST_VOLUMES_ROOT/empty_restore/old.txt"
  run_restore -i "empty_${ts}.tar" -t empty_restore -C || return 1
  [[ -z "$(ls -A "$TEST_VOLUMES_ROOT/empty_restore")" ]] || return 1
}

test_restore_preserves_volume_root_metadata() {
  (( EUID == 0 )) || return "$SKIP_RC"
  setup_case "restore_preserves_volume_root_metadata"

  make_volume_content "pg"
  chown 999:998 "$TEST_VOLUMES_ROOT/pg"
  chmod 2750 "$TEST_VOLUMES_ROOT/pg"
  touch -d '2021-03-04 05:06:07' "$TEST_VOLUMES_ROOT/pg"
  local expected
  expected="$(dir_root_metadata "$TEST_VOLUMES_ROOT/pg")"

  local ts="20250101_620000"
  run_backup -v pg -T "$ts" || return 1

  prepare_target_volume "pg_new"
  run_restore -i "pg_${ts}.tar" -t pg_new || return 1
  [[ "$(dir_root_metadata "$TEST_VOLUMES_ROOT/pg_new")" == "$expected" ]] || {
    log "Root metadata not restored: expected '$expected', got '$(dir_root_metadata "$TEST_VOLUMES_ROOT/pg_new")'"
    return 1
  }
  assert_dirs_equal "$TEST_VOLUMES_ROOT/pg" "$TEST_VOLUMES_ROOT/pg_new" || return 1

  # Also when replacing existing contents
  replace_volume_with_marker "pg_new" "old"
  chmod 0755 "$TEST_VOLUMES_ROOT/pg_new"
  run_restore -i "pg_${ts}.tar" -t pg_new -C || return 1
  [[ "$(dir_root_metadata "$TEST_VOLUMES_ROOT/pg_new")" == "$expected" ]] || return 1
}

test_backup_tolerates_files_changing() {
  setup_case "backup_tolerates_files_changing"
  make_volume_content "alpha"

  # tar exits 1 when files changed while being read
  local stub="$CASE_ROOT/stub" real_tar
  real_tar="$(command -v tar)"
  mkdir -p "$stub"
  cat > "$stub/tar" <<STUB
#!/usr/bin/env bash
'$real_tar' "\$@" || exit \$?
[[ " \$* " == *" --create "* ]] && exit 1
exit 0
STUB
  chmod +x "$stub/tar"

  run_backup_with_env PATH="$stub:$PATH" -- -v alpha -T 20250101_630000 || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/alpha_20250101_630000.tar" || return 1

  expect_rejected run_backup_with_env PATH="$stub:$PATH" -- -v alpha -T 20250101_630001 -S || return 1
  [[ -z "$(find "$TEST_BACKUP_ROOT" -name '*_20250101_630001*')" ]] || {
    log "BUG: strict backup left files behind"
    return 1
  }
}

test_restore_all_wrong_passphrase_changes_nothing() {
  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"
  setup_case "restore_all_wrong_passphrase_changes_nothing"

  make_volume_content "alpha"
  make_volume_content "beta"
  local ts="20250101_640000"
  run_backup_with_env GPG_PASSPHRASE=right -- -v alpha -T "$ts" -c -s || return 1
  run_backup_with_env GPG_PASSPHRASE=other -- -v beta -T "$ts" -c -s || return 1

  replace_volume_with_marker "alpha" "old-alpha"
  replace_volume_with_marker "beta" "old-beta"

  expect_rejected run_restore_with_env GPG_PASSPHRASE=right -- -a -T "$ts" -s -C -j 2 || return 1

  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old-alpha" || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/marker.txt" "old-beta" || return 1
  assert_no_reserved_entries alpha beta || return 1
}

test_restore_crash_matrix() {
  setup_case "restore_crash_matrix"
  setup_two_volume_transaction || return 1

  # alpha is the coordinator (first by name); it finalizes last
  local spec point expected
  for spec in \
    txn_create_rename:beta=old \
    txn_staged:beta=old \
    txn_aside_entry:alpha=old \
    txn_swap_entry:beta=old \
    txn_before_decision=old \
    txn_after_decision=new \
    txn_finalize:beta=new \
    txn_finalize:alpha=new \
    txn_retire_done:alpha=new \
    txn_trash_signature:alpha=new \
    txn_trash_rmdir:alpha=new \
    txn_finalize_mtime:alpha=new; do
    point="${spec%=*}"
    expected="${spec##*=}"

    restore_crashing_at "$point" -- -a -T "$TXN_TS" -C || return 1
    if [[ "$point" != txn_finalize_mtime:* ]]; then
      [[ -n "$(reserved_entries "$TEST_VOLUMES_ROOT/alpha")$(reserved_entries "$TEST_VOLUMES_ROOT/beta")" ]] || {
        log "Crash at $point left no journal behind"
        return 1
      }
    fi

    # Recovery runs in a fresh process with a fresh TMPDIR (container restart)
    run_restore -X || return 1
    assert_group_state "$expected" || {
      log "Wrong state after a crash at $point (expected $expected data)"
      return 1
    }

    # Back to the old data for the next round
    if [[ "$expected" == new ]]; then
      reset_two_volume_transaction
    fi
  done
}

test_restore_repeated_crashes_during_rollback() {
  setup_case "restore_repeated_crashes_during_rollback"
  setup_two_volume_transaction || return 1

  # alpha switched, beta half switched; then the rollback itself crashes in
  # beta's rb2 and later in alpha's rb1
  restore_crashing_at txn_swap_entry:beta -- -a -T "$TXN_TS" -C || return 1
  recover_crashing_at txn_rb2_entry:beta || return 1
  [[ "$(cat "$TEST_VOLUMES_ROOT/beta/.vb-restore/state")" == rb2 ]] || {
    log "Expected beta to be in rb2 after the crash"
    return 1
  }
  recover_crashing_at txn_rb1_entry:alpha || return 1
  run_restore -X || return 1
  assert_group_state old || return 1

  # Mixed phases: alpha switched, beta just entered aside
  restore_crashing_at txn_aside:beta -- -a -T "$TXN_TS" -C || return 1
  recover_crashing_at txn_rb2_entry:alpha || return 1
  run_restore -X || return 1
  assert_group_state old || return 1
}

test_restore_recovery_needs_all_participants() {
  setup_case "restore_recovery_needs_all_participants"
  setup_two_volume_transaction || return 1

  restore_crashing_at txn_swap_entry:beta -- -a -T "$TXN_TS" -C || return 1

  # Only beta is mounted: recovery must refuse without touching it
  local partial_root="$CASE_ROOT/partial-volumes"
  mkdir -p "$partial_root"
  mv "$TEST_VOLUMES_ROOT/beta" "$partial_root/beta"
  local before
  before="$(tree_manifest "$partial_root/beta")"

  expect_rejected run_restore_with_env VOLUMES_ROOT="$partial_root" -- -X || return 1
  [[ "$(tree_manifest "$partial_root/beta")" == "$before" ]] || {
    log "BUG: recovery changed a volume although the coordinator was not mounted"
    return 1
  }

  mv "$partial_root/beta" "$TEST_VOLUMES_ROOT/beta"
  run_restore -X || return 1
  assert_group_state old || return 1
}

test_restore_locks_against_concurrent_operations() {
  setup_case "restore_locks_against_concurrent_operations"
  make_volume_content "alpha"
  local ts="20250101_650000"
  run_backup -v alpha -T "$ts" || return 1

  PAUSE_DIR="$CASE_ROOT/pause"
  mkdir -p "$PAUSE_DIR"

  # A restore holds the volume: backup, restore and recovery must refuse
  run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_PAUSE_AT=txn_staged VB_TEST_PAUSE_DIR="$PAUSE_DIR" -- \
    -i "alpha_${ts}.tar" -t alpha -C > "$CASE_ROOT/paused.log" 2>&1 &
  PAUSED_PID=$!
  wait_for_point txn_staged || return 1

  expect_rejected run_backup -v alpha -T 20250101_650001 || return 1
  expect_rejected run_restore -i "alpha_${ts}.tar" -t alpha -C || return 1
  expect_rejected run_restore -X || return 1

  resume_and_wait txn_staged 2>/dev/null || return 1

  # A backup holds the volume (shared): a restore must refuse
  start_paused_backup local_publish -- -v alpha -T 20250101_650002
  wait_for_point local_publish || return 1
  expect_rejected run_restore -i "alpha_${ts}.tar" -t alpha -C || return 1
  resume_and_wait local_publish 2>/dev/null || return 1
}

test_recovery_waits_for_finalize() {
  setup_case "recovery_waits_for_finalize"
  make_volume_content "alpha"
  local ts="20250101_660000"
  run_backup -v alpha -T "$ts" || return 1
  replace_volume_with_marker "alpha" "old"

  local point
  local -a points=(txn_retire_done txn_trash_signature txn_trash_rmdir)
  # Without user xattrs nothing marks the volume once its journal is gone
  if xattr_tests_enabled; then
    points+=(txn_finalize_mtime)
  fi
  for point in "${points[@]}"; do
    PAUSE_DIR="$CASE_ROOT/pause-$point"
    mkdir -p "$PAUSE_DIR"
    run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_PAUSE_AT="$point" VB_TEST_PAUSE_DIR="$PAUSE_DIR" -- \
      -i "alpha_${ts}.tar" -t alpha -C > "$CASE_ROOT/paused.log" 2>&1 &
    PAUSED_PID=$!
    wait_for_point "$point" || return 1

    local before after
    before="$(cd "$TEST_VOLUMES_ROOT/alpha" && find . -printf '%P\t%y\t%m\t%T@\n' | LC_ALL=C sort; dir_root_metadata .; getfattr -d -m - --absolute-names . 2>/dev/null)"

    expect_rejected run_restore -X || return 1
    expect_rejected run_backup -v alpha -T 20250101_660001 || return 1

    after="$(cd "$TEST_VOLUMES_ROOT/alpha" && find . -printf '%P\t%y\t%m\t%T@\n' | LC_ALL=C sort; dir_root_metadata .; getfattr -d -m - --absolute-names . 2>/dev/null)"
    [[ "$before" == "$after" ]] || {
      log "BUG: a concurrent recovery changed the volume while it was being finalized ($point)"
      return 1
    }

    resume_and_wait "$point" 2>/dev/null || return 1
    assert_no_reserved_entries alpha || return 1
    replace_volume_with_marker "alpha" "old"
  done
}

test_restore_wal_order() {
  setup_case "restore_wal_order"
  make_volume_content "alpha"
  local ts="20250101_670000"
  run_backup -v alpha -T "$ts" || return 1
  replace_volume_with_marker "alpha" "old"
  printf 'second\n' > "$TEST_VOLUMES_ROOT/alpha/second.txt"

  # Record every sync and mv (with the content of journal state files)
  local stub="$CASE_ROOT/stub" real_mv real_sync
  real_mv="$(command -v mv)"
  real_sync="$(command -v sync)"
  mkdir -p "$stub"
  cat > "$stub/mv" <<STUB
#!/usr/bin/env bash
for arg in "\$@"; do src="\$dst"; dst="\$arg"; done
if [[ "\$src" == */.state.tmp ]]; then
  printf 'STATE %s\n' "\$(cat "\$src")" >> '$stub/trace'
elif [[ "\$src" == */.decision.tmp ]]; then
  printf 'DECISION\n' >> '$stub/trace'
elif [[ "\$src" != */.*.tmp ]]; then
  printf 'MOVE %s -> %s\n' "\$src" "\$dst" >> '$stub/trace'
fi
exec '$real_mv' "\$@"
STUB
  cat > "$stub/sync" <<STUB
#!/usr/bin/env bash
printf 'SYNC %s\n' "\$*" >> '$stub/trace'
exec '$real_sync' "\$@"
STUB
  chmod +x "$stub/mv" "$stub/sync"

  run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha -C || return 1

  awk '
    /^STATE / { state = $2; states[state] = NR; synced_old = synced_new = 0; next }
    /^SYNC -f/ { syncfs = NR; next }
    /^SYNC / { if ($0 ~ /\/old/) synced_old = 1; if ($0 ~ /\/new/) synced_new = 1; next }
    /^MOVE / {
      if ($0 ~ /\/\.vb-restore\/old\// && state != "aside") { print "aside move outside the aside phase: " $0; bad = 1 }
      if ($0 ~ /\/\.vb-restore\/new\// && $0 !~ /-> .*\.vb-restore/ && state != "swap") { print "swap move outside the swap phase: " $0; bad = 1 }
      next
    }
    END {
      if (!syncfs || syncfs > states["staged"]) { print "data not synced before staged"; bad = 1 }
      if (!(states["aside"] < states["swap"] && states["swap"] < states["swapped"] && states["swapped"] < states["finalize"])) { print "phases out of order"; bad = 1 }
      exit bad
    }' "$stub/trace" || {
    cat "$stub/trace" >&2
    return 1
  }

  # The phase that follows aside/swap is only recorded after its directories were synced
  awk '
    /^STATE swap$/ && !old_synced { print "swap recorded before old/ was synced"; bad = 1 }
    /^STATE swapped$/ && !new_synced { print "swapped recorded before new/ was synced"; bad = 1 }
    /^STATE aside$/ { old_synced = 0 }
    /^STATE swap$/ { new_synced = 0 }
    /^SYNC / && /\/\.vb-restore\/old/ { old_synced = 1 }
    /^SYNC / && /\/\.vb-restore\/new/ { new_synced = 1 }
    END { exit bad }' "$stub/trace" || {
    cat "$stub/trace" >&2
    return 1
  }
}

test_restore_refuses_nested_mounts() {
  setup_case "restore_refuses_nested_mounts"
  make_volume_content "alpha"
  local ts="20250101_680000"
  run_backup -v alpha -T "$ts" || return 1

  mkdir -p "$TEST_VOLUMES_ROOT/alpha/mnt" "$CASE_ROOT/elsewhere"
  printf 'must survive\n' > "$CASE_ROOT/elsewhere/keep.txt"
  if ! mount --bind "$CASE_ROOT/elsewhere" "$TEST_VOLUMES_ROOT/alpha/mnt" 2>/dev/null; then
    log "Skipping: bind mounts are not permitted here (needs CAP_SYS_ADMIN)"
    return "$SKIP_RC"
  fi

  local rc=0
  run_restore -i "alpha_${ts}.tar" -t alpha -C 2>/dev/null || rc=$?
  umount "$TEST_VOLUMES_ROOT/alpha/mnt"

  (( rc != 0 )) || {
    log "BUG: restore replaced a volume that contains a mount point"
    return 1
  }
  assert_text_file_contains "$CASE_ROOT/elsewhere/keep.txt" "must survive" || return 1
  assert_no_reserved_entries alpha || return 1
}

test_restore_refuses_mount_points_from_mountinfo() {
  setup_case "restore_refuses_mount_points_from_mountinfo"
  make_volume_content "alpha"
  local ts="20250101_681000"
  run_backup -v alpha -T "$ts" || return 1
  replace_volume_with_marker "alpha" "old"

  # Mount points are read from mountinfo, where spaces are escaped as \040
  local real_alpha fake="$CASE_ROOT/mountinfo"
  real_alpha="$(cd "$TEST_VOLUMES_ROOT/alpha" && pwd -P)"
  { cat /proc/self/mountinfo; printf '9999 1 0:99 / %s/data\\040dir rw - tmpfs tmpfs rw\n' "$real_alpha"; } > "$fake"

  expect_rejected run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_MOUNTINFO="$fake" -- \
    -i "alpha_${ts}.tar" -t alpha -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old" || return 1
  assert_no_reserved_entries alpha || return 1

  # A mount point of a volume that merely shares the name prefix is fine
  { cat /proc/self/mountinfo; printf '9999 1 0:99 / %s-other/sub rw - tmpfs tmpfs rw\n' "$real_alpha"; } > "$fake"
  run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_MOUNTINFO="$fake" -- -i "alpha_${ts}.tar" -t alpha -C || return 1
}

test_restore_refuses_legacy_staging_directory() {
  setup_case "restore_refuses_legacy_staging_directory"
  make_volume_content "alpha"
  local ts="20250101_011112"
  run_backup -v alpha -T "$ts" || return 1

  clear_volume_dir "alpha"
  # A staging directory of an older version may hold the only copy of data
  mkdir -p "$TEST_VOLUMES_ROOT/alpha/.restore-in-progress.LEFTOVER"
  printf 'stale content\n' > "$TEST_VOLUMES_ROOT/alpha/.restore-in-progress.LEFTOVER/stale.txt"

  expect_rejected run_restore -i "alpha_${ts}.tar" -t alpha -C || return 1
  expect_rejected run_restore -X || return 1
  expect_rejected run_backup -v alpha -T 20250101_011113 || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/.restore-in-progress.LEFTOVER/stale.txt" "stale content" || return 1
}

test_reserved_names_from_users_are_never_removed() {
  setup_case "reserved_names_from_users_are_never_removed"
  make_volume_content "alpha"
  local fake_gid="0123456789abcdef0123456789abcdef"

  # An archive with a reserved name at its root is refused before any change
  mkdir -p "$TEST_VOLUMES_ROOT/alpha/.vb-restore.done.${fake_gid}"
  printf 'user data\n' > "$TEST_VOLUMES_ROOT/alpha/.vb-restore.done.${fake_gid}/data.txt"
  expect_rejected run_backup -v alpha -T 20250101_690000 || return 1

  local archive_dir="$CASE_ROOT/archive-src"
  mkdir -p "$archive_dir/.vb-restore-x"
  printf 'user data\n' > "$archive_dir/.vb-restore-x/data.txt"
  tar -cf "$TEST_BACKUP_ROOT/crafted_20250101_690001.tar" -C "$archive_dir" .
  sha256sum "$TEST_BACKUP_ROOT/crafted_20250101_690001.tar" > "$TEST_BACKUP_ROOT/crafted_20250101_690001.tar.sha256"
  replace_volume_with_marker "crafted" "old-crafted"
  expect_rejected run_restore -i crafted_20250101_690001.tar -t crafted -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/crafted/marker.txt" "old-crafted" || return 1
  assert_no_reserved_entries crafted || return 1

  # A user directory with a trash-like name (no signature) is never removed
  expect_rejected run_restore -X || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/.vb-restore.done.${fake_gid}/data.txt" "user data" || return 1

  # ... not even with a signature for another group id
  printf 'vb-restore-journal v1\ngid=%s\n' "fedcba9876543210fedcba9876543210" \
    > "$TEST_VOLUMES_ROOT/alpha/.vb-restore.done.${fake_gid}/VB-JOURNAL"
  expect_rejected run_restore -X || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/.vb-restore.done.${fake_gid}/data.txt" "user data" || return 1
}

test_interrupted_trash_cleanup_is_finished() {
  setup_case "interrupted_trash_cleanup_is_finished"
  make_volume_content "alpha"
  local ts="20250101_700000"
  run_backup -v alpha -T "$ts" || return 1
  copy_volume_snapshot "alpha" "$CASE_ROOT/new-alpha"
  replace_volume_with_marker "alpha" "old"

  restore_crashing_at txn_trash_rmdir:alpha -- -i "alpha_${ts}.tar" -t alpha -C || return 1
  local trash
  trash="$(reserved_entries "$TEST_VOLUMES_ROOT/alpha")"
  [[ "$trash" == .vb-restore.done.* && -z "$(ls -A "$TEST_VOLUMES_ROOT/alpha/$trash")" ]] || {
    log "Expected an empty trash directory, found: '$trash'"
    return 1
  }

  run_restore -X || return 1
  assert_no_reserved_entries alpha || return 1
  assert_dirs_equal "$CASE_ROOT/new-alpha" "$TEST_VOLUMES_ROOT/alpha" || return 1
  run_backup -v alpha -T 20250101_700001 || return 1
}

test_restore_requires_valid_checksum_file() {
  setup_case "restore_requires_valid_checksum_file"
  make_volume_content "alpha"
  local ts="20250101_710000"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"
  run_backup -v alpha -T "$ts" || return 1
  prepare_target_volume "alpha_restore"

  # The binary-mode form "<digest> *<name>" is accepted
  sed -i 's/  / */' "${archive}.sha256"
  grep -q '^[0-9a-f]\{64\} \*alpha_' "${archive}.sha256" || return 1
  run_restore -i "$archive" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1

  # Garbage is refused
  printf 'not a checksum\n' > "${archive}.sha256"
  expect_rejected run_restore -i "$archive" -t alpha_restore -C || return 1

  # A missing checksum file is refused unless -U is given
  rm -f "${archive}.sha256"
  expect_rejected run_restore -i "$archive" -t alpha_restore -C || return 1
  run_restore -i "$archive" -t alpha_restore -C -U || return 1
}

test_backup_refuses_lone_checksum_file() {
  setup_case "backup_refuses_lone_checksum_file"
  make_volume_content "alpha"
  local ts="20250101_720000"

  printf '%064d  alpha_%s.tar\n' 0 "$ts" > "$TEST_BACKUP_ROOT/alpha_${ts}.tar.sha256"
  expect_rejected run_backup -v alpha -T "$ts" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/alpha_${ts}.tar" || return 1
  [[ "$(cut -c1-8 "$TEST_BACKUP_ROOT/alpha_${ts}.tar.sha256")" == 00000000 ]] || {
    log "BUG: the existing checksum file was modified"
    return 1
  }
}

test_concurrent_local_backups_publish_one_pair() {
  setup_case "concurrent_local_backups_publish_one_pair"
  make_volume_content "alpha"
  local ts="20250101_730000"

  # A holds the BACKUP_ROOT lock while publishing; B with the same timestamp
  # passes its early check, waits for the lock, then must give up.
  start_paused_backup local_publish -- -v alpha -T "$ts"
  wait_for_point local_publish || return 1

  printf 'second version\n' > "$TEST_VOLUMES_ROOT/alpha/second.txt"
  run_backup_with_env VB_LOCK_TIMEOUT=60 -- -v alpha -T "$ts" > "$CASE_ROOT/b.log" 2>&1 &
  local b_pid=$!
  sleep 1

  resume_and_wait local_publish 2>/dev/null || return 1
  local b_rc=0
  wait "$b_pid" || b_rc=$?
  (( b_rc != 0 )) || {
    log "BUG: both backups reported success"
    return 1
  }

  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"
  [[ "$(sha256sum "$archive" | awk '{ print $1 }')" == "$(awk '{ print $1 }' "${archive}.sha256")" ]] || {
    log "BUG: the published checksum does not belong to the published archive"
    return 1
  }
  [[ -z "$(find "$TEST_BACKUP_ROOT" -name '*.part')" ]] || return 1
}

test_restore_requires_flock() {
  setup_case "restore_requires_flock"
  make_volume_content "alpha"
  local ts="20250101_740000"
  run_backup -v alpha -T "$ts" || return 1

  local stub="$CASE_ROOT/stub"
  mkdir -p "$stub"
  printf '#!/usr/bin/env bash\nexit 64\n' > "$stub/flock"
  chmod +x "$stub/flock"

  expect_rejected run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha -C || return 1
  expect_rejected run_backup_with_env PATH="$stub:$PATH" -- -v alpha -T 20250101_740001 || return 1
  assert_no_reserved_entries alpha || return 1
}

test_backup_stops_on_signal() {
  setup_case "backup_stops_on_signal"
  make_volume_content "alpha"

  start_paused_backup archive_stream:alpha -- -v alpha -T 20250101_800000 -c
  wait_for_point archive_stream:alpha || return 1
  signal_paused_script TERM 143 || return 1

  [[ -z "$(find "$TEST_BACKUP_ROOT" -mindepth 1 ! -name .vb.lock)" ]] || {
    log "BUG: an interrupted backup left files behind: $(ls -A "$TEST_BACKUP_ROOT")"
    return 1
  }
}

test_backup_all_stops_on_signal() {
  setup_case "backup_all_stops_on_signal"
  make_volume_content "alpha"
  make_volume_content "beta"

  start_paused_backup archive_stream:alpha,archive_stream:beta -- -a -j 2 -T 20250101_800100
  wait_for_point archive_stream:alpha || return 1
  wait_for_point archive_stream:beta || return 1
  # Not INT: background jobs of a non-interactive shell ignore SIGINT, and a
  # signal ignored at startup cannot be trapped
  signal_paused_script TERM 143 || return 1

  [[ -z "$(find "$TEST_BACKUP_ROOT" -mindepth 1 ! -name .vb.lock)" ]] || {
    log "BUG: an interrupted backup left files behind: $(ls -A "$TEST_BACKUP_ROOT")"
    return 1
  }
}

test_backup_all_does_not_wait_for_the_first_child() {
  setup_case "backup_all_does_not_wait_for_the_first_child"
  local vol
  for vol in alpha beta gamma; do
    make_volume_content "$vol"
  done
  local ts="20250101_800200"

  # alpha is stuck; beta finishes, so gamma must start without waiting for alpha
  start_paused_backup archive_stream:alpha -- -a -j 2 -T "$ts"
  wait_for_point archive_stream:alpha || return 1

  local i
  for (( i = 0; i < 300; i++ )); do
    [[ -e "$TEST_BACKUP_ROOT/gamma_${ts}.tar.sha256" ]] && break
    sleep 0.1
  done
  [[ -e "$TEST_BACKUP_ROOT/gamma_${ts}.tar.sha256" ]] || {
    log "BUG: the third backup did not start while the first one was still running"
    resume_and_wait archive_stream:alpha 2>/dev/null || true
    return 1
  }

  resume_and_wait archive_stream:alpha 2>/dev/null || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/alpha_${ts}.tar.sha256" || return 1
}

test_s3_backup_stops_on_signal_optional() {
  require_s3_or_skip || return $?
  setup_case "s3_backup_stops_on_signal_optional"
  make_volume_content "alpha"

  local ts="20250101_800300" prefix key
  prefix="$(t_s3_prefix signal)"
  key="${prefix}/alpha_${ts}.tar"

  start_paused_backup archive_stream:alpha -- -v alpha -T "$ts" -b "$TEST_S3_BUCKET" -f "$prefix"
  wait_for_point archive_stream:alpha || return 1
  [[ "$(t_s3_pending_uploads "$key")" == 1 ]] || {
    log "Expected one multipart upload in progress"
    return 1
  }
  signal_paused_script TERM 143 || return 1

  [[ "$(t_s3_head "$key")" == 404 ]] || return 1
  [[ "$(t_s3_pending_uploads "$key")" == 0 ]] || {
    log "BUG: the interrupted multipart upload was not aborted"
    return 1
  }
}

test_restore_stops_on_signal() {
  setup_case "restore_stops_on_signal"
  make_volume_content "alpha"
  make_volume_content "beta"
  local ts="20250101_800400"
  run_backup -a -T "$ts" || return 1
  replace_volume_with_marker "alpha" "old-alpha"
  replace_volume_with_marker "beta" "old-beta"

  # Single restore, interrupted while streaming
  start_paused_restore restore_stream:alpha -- -i "alpha_${ts}.tar" -t alpha -C
  wait_for_point restore_stream:alpha || return 1
  signal_paused_script TERM 143 || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old-alpha" || return 1
  assert_no_reserved_entries alpha || return 1

  # Restore of all volumes, interrupted while both are being staged
  rm -rf "$PAUSE_DIR"
  start_paused_restore restore_stream:alpha,restore_stream:beta -- -a -T "$ts" -C -j 2
  wait_for_point restore_stream:alpha || return 1
  wait_for_point restore_stream:beta || return 1
  signal_paused_script TERM 143 || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old-alpha" || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/beta/marker.txt" "old-beta" || return 1
  assert_no_reserved_entries alpha beta || return 1
}

test_backup_encrypts_to_every_recipient() {
  setup_case "backup_encrypts_to_every_recipient"
  generate_gpg_keypair_files first || return $?
  generate_gpg_keypair_files second || return $?
  make_volume_content "alpha"

  # One file with two keys
  cat "$TEST_GPG_ROOT/firstpublic.asc" "$TEST_GPG_ROOT/secondpublic.asc" > "$TEST_GPG_ROOT/both.asc"
  run_backup -v alpha -T 20250101_800500 -e -k both.asc || return 1

  # Two -k options, one of them an absolute path outside GPG_ROOT
  mkdir -p "$CASE_ROOT/elsewhere"
  mv "$TEST_GPG_ROOT/secondpublic.asc" "$CASE_ROOT/elsewhere/"
  run_backup -v alpha -T 20250101_800501 -e -k firstpublic.asc -k "$CASE_ROOT/elsewhere/secondpublic.asc" || return 1

  local ts key
  for ts in 20250101_800500 20250101_800501; do
    for key in first second; do
      prepare_target_volume "restore_${key}_${ts}"
      run_restore -i "alpha_${ts}.tar.gpg" -t "restore_${key}_${ts}" -k "${key}private.asc" || {
        log "Backup $ts cannot be decrypted with the $key key"
        return 1
      }
      assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/restore_${key}_${ts}" || return 1
    done
  done
}

test_backup_dry_run_validates_public_key() {
  setup_case "backup_dry_run_validates_public_key"
  generate_gpg_keypair_files || return $?
  make_volume_content "alpha"

  printf 'not a key\n' > "$TEST_GPG_ROOT/garbage.asc"
  expect_rejected run_backup -v alpha -T 20250101_800600 -e -k garbage.asc -n || return 1

  # A key that can only sign
  local home
  home="$(mktemp -d "$TEST_ROOT/kg.XXXXXX")"
  printf '%%no-protection\n%%transient-key\nKey-Type: eddsa\nKey-Curve: ed25519\nKey-Usage: sign\nName-Real: Sign Only\nExpire-Date: 0\n%%commit\n' \
    > "$CASE_ROOT/sign-only.conf"
  GNUPGHOME="$home" gpg --batch --gen-key "$CASE_ROOT/sign-only.conf" >/dev/null 2>&1 || return 1
  GNUPGHOME="$home" gpg --armor --export > "$TEST_GPG_ROOT/sign-only.asc" || return 1
  GNUPGHOME="$home" gpgconf --kill all >/dev/null 2>&1 || true
  expect_rejected run_backup -v alpha -T 20250101_800600 -e -k sign-only.asc -n || return 1
  expect_rejected run_backup -v alpha -T 20250101_800600 -e -k public.asc -k sign-only.asc || return 1
  expect_rejected run_backup -v alpha -T 20250101_800600 -e -k missing.asc -n || return 1
  run_backup -v alpha -T 20250101_800600 -e -k public.asc -n || return 1
  [[ -z "$(find "$TEST_BACKUP_ROOT" -mindepth 1)" ]] || return 1
}

test_restore_rejects_unencrypted_gpg_archive() {
  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"
  setup_case "restore_rejects_unencrypted_gpg_archive"
  make_volume_content "alpha"
  local ts="20250101_800700"
  run_backup -v alpha -T "$ts" || return 1

  # A bare OpenPGP literal packet: gpg --decrypt outputs it without a key
  local home="$CASE_ROOT/store-gnupg"
  local fake="$TEST_BACKUP_ROOT/alpha_20250101_800701.tar.gpg"
  mkdir -p "$home"
  chmod 700 "$home"
  GNUPGHOME="$home" gpg --batch --store --output "$fake" "$TEST_BACKUP_ROOT/alpha_${ts}.tar" 2>/dev/null || return 1
  printf '%s  %s\n' "$(sha256sum "$fake" | awk '{ print $1 }')" "${fake##*/}" > "${fake}.sha256"

  replace_volume_with_marker "alpha" "old"
  expect_rejected run_restore_with_env GPG_PASSPHRASE=anything -- -i "${fake##*/}" -t alpha -s -C || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "old" || return 1
  assert_no_reserved_entries alpha || return 1
}

test_passphrase_with_newline_warns() {
  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"
  setup_case "passphrase_with_newline_warns"
  make_volume_content "alpha"
  local ts="20250101_800800"

  run_backup_with_env GPG_PASSPHRASE=$'first\nsecond' -- -v alpha -T "$ts" -s 2> "$CASE_ROOT/backup.log" || return 1
  grep -q 'contains a newline' "$CASE_ROOT/backup.log" || {
    log "BUG: no warning about the newline in the passphrase"
    return 1
  }

  prepare_target_volume "alpha_restore"
  run_restore_with_env GPG_PASSPHRASE=$'first\nsecond' -- -i "alpha_${ts}.tar.gpg" -t alpha_restore -s 2>/dev/null || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_backup_refuses_backup_root_inside_volume() {
  setup_case "backup_refuses_backup_root_inside_volume"
  make_volume_content "alpha"

  expect_rejected run_backup_with_env BACKUP_ROOT="$TEST_VOLUMES_ROOT/alpha/backups" -- -v alpha -T 20250101_800900 || return 1
  expect_rejected run_backup -v alpha -T 20250101_800900 -d "$TEST_VOLUMES_ROOT/alpha" || return 1
  [[ -z "$(find "$TEST_VOLUMES_ROOT/alpha" -name '*.tar*')" && ! -e "$TEST_VOLUMES_ROOT/alpha/backups" ]] || {
    log "BUG: a backup was written into the volume it archives"
    return 1
  }
}

test_restore_refuses_source_inside_target() {
  setup_case "restore_refuses_source_inside_target"
  make_volume_content "alpha"
  local ts="20250101_801000"
  run_backup -v alpha -T "$ts" || return 1

  cp "$TEST_BACKUP_ROOT/alpha_${ts}.tar" "$TEST_BACKUP_ROOT/alpha_${ts}.tar.sha256" "$TEST_VOLUMES_ROOT/alpha/"
  expect_rejected run_restore -i "$TEST_VOLUMES_ROOT/alpha/alpha_${ts}.tar" -t alpha -C || return 1
  assert_file_exists "$TEST_VOLUMES_ROOT/alpha/alpha_${ts}.tar" || return 1
  assert_no_reserved_entries alpha || return 1

  # Same when the whole backup directory lives in a target volume
  expect_rejected run_restore -a -d "$TEST_VOLUMES_ROOT/alpha" -C || return 1
  assert_file_exists "$TEST_VOLUMES_ROOT/alpha/alpha_${ts}.tar" || return 1
}

test_backup_warns_about_nested_mounts() {
  setup_case "backup_warns_about_nested_mounts"
  make_volume_content "alpha"

  local real_alpha fake="$CASE_ROOT/mountinfo"
  real_alpha="$(cd "$TEST_VOLUMES_ROOT/alpha" && pwd -P)"
  { cat /proc/self/mountinfo; printf '9999 1 0:99 / %s/subdir rw - tmpfs tmpfs rw\n' "$real_alpha"; } > "$fake"

  run_backup_with_env VB_TEST_HOOKS=1 VB_TEST_MOUNTINFO="$fake" -- -v alpha -T 20250101_801100 2> "$CASE_ROOT/backup.log" || return 1
  grep -q 'contains other mount points' "$CASE_ROOT/backup.log" || {
    log "BUG: no warning about the mount point inside the volume"
    return 1
  }
}

test_restore_does_not_restore_selinux_labels() {
  tar --version 2>/dev/null | grep -q 'GNU tar' || return "$SKIP_RC"
  setup_case "restore_does_not_restore_selinux_labels"
  make_volume_content "alpha"
  local ts="20250101_801200"
  run_backup -v alpha -T "$ts" || return 1

  local stub="$CASE_ROOT/stub" real_tar
  real_tar="$(command -v tar)"
  mkdir -p "$stub"
  cat > "$stub/tar" <<STUB
#!/usr/bin/env bash
[[ " \$* " == *" --extract "* ]] && printf '%s\n' "\$*" >> '$stub/trace'
exec '$real_tar' "\$@"
STUB
  chmod +x "$stub/tar"

  prepare_target_volume "alpha_restore"
  run_restore_with_env PATH="$stub:$PATH" -- -i "alpha_${ts}.tar" -t alpha_restore || return 1
  [[ -s "$stub/trace" ]] || return 1
  if grep -v -- '--xattrs-exclude=security.selinux' "$stub/trace" | grep -q .; then
    log "BUG: an extraction restores SELinux labels:"
    cat "$stub/trace" >&2
    return 1
  fi
}

test_s3_errors_include_the_curl_message() {
  setup_case "s3_errors_include_the_curl_message"
  make_volume_content "alpha"

  local rc=0
  run_backup_with_env AWS_ENDPOINT_URL=http://127.0.0.1:9 AWS_ACCESS_KEY_ID=key AWS_SECRET_ACCESS_KEY=secret AWS_REGION=us-east-1 -- \
    -v alpha -T 20250101_801300 -b vb-test 2> "$CASE_ROOT/backup.log" || rc=$?
  (( rc != 0 )) || return 1
  grep -q 'curl: (7)' "$CASE_ROOT/backup.log" || {
    log "BUG: the error does not say why curl failed:"
    cat "$CASE_ROOT/backup.log" >&2
    return 1
  }
}

# ------------------------------------------------------------------------------
# Test runner
# ------------------------------------------------------------------------------

run_test() {
  local name="$1"
  shift

  # TEST_FILTER (a bash regex) selects tests by function name
  if [[ -n "${TEST_FILTER:-}" && ! "$1" =~ $TEST_FILTER ]]; then
    return 0
  fi

  TESTS_TOTAL=$((TESTS_TOTAL + 1))

  set +e
  "$@"
  local rc=$?
  set -e

  case "$rc" in
    0)
      TESTS_PASSED=$((TESTS_PASSED + 1))
      pass "$name"
      ;;
    "$SKIP_RC")
      TESTS_SKIPPED=$((TESTS_SKIPPED + 1))
      skip "$name"
      ;;
    *)
      TESTS_FAILED=$((TESTS_FAILED + 1))
      fail "$name"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Preflight
# ------------------------------------------------------------------------------

[[ -f "$BACKUP_BIN" ]] || die "Backup script not found: $BACKUP_BIN"
[[ -f "$RESTORE_BIN" ]] || die "Restore script not found: $RESTORE_BIN"

require_command bash
require_command tar
require_command find
require_command diff

if ! command -v gzip >/dev/null 2>&1 && ! command -v pigz >/dev/null 2>&1; then
  die "Neither gzip nor pigz found; compressed tests cannot run"
fi

if [[ "${REQUIRE_XATTR_TESTS:-0}" == 1 ]]; then
  for xattr_command in getfattr setfattr getfacl setfacl; do
    require_command "$xattr_command"
  done
  xattr_tests_enabled || die "REQUIRE_XATTR_TESTS=1, but user extended attributes are not supported under $TEST_ROOT"
fi

log "Using backup script:  $BACKUP_BIN"
log "Using restore script: $RESTORE_BIN"
log "Test root: $TEST_ROOT"

# ------------------------------------------------------------------------------
# Execute tests
# ------------------------------------------------------------------------------


#!/usr/bin/env bash
set -Eeuo pipefail

# ------------------------------------------------------------------------------
# Config
# ------------------------------------------------------------------------------

readonly SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_BIN="${BACKUP_BIN:-$SCRIPT_DIR/backup}"
RESTORE_BIN="${RESTORE_BIN:-$SCRIPT_DIR/restore}"

readonly SKIP_RC=200

TEST_ROOT="$(mktemp -d)"
CURRENT_CASE=""
CASE_ROOT=""
TEST_BACKUP_ROOT=""
TEST_VOLUMES_ROOT=""
TEST_GPG_ROOT=""

TESTS_TOTAL=0
TESTS_PASSED=0
TESTS_FAILED=0
TESTS_SKIPPED=0

# Optional S3 integration test:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_SESSION_TOKEN   (optional)
#   AWS_REGION          (optional, default us-east-1)
#   AWS_ENDPOINT_URL    (optional)
#   TEST_S3_BUCKET      (required for S3 tests)
#   TEST_S3_PREFIX      (optional)
#   REQUIRE_S3_TESTS=1  (optional, turn S3 skips into failures)
#
# TEST_FILTER=<regex> runs only the tests whose function name matches.
#
# REQUIRE_XATTR_TESTS=1 fails the run when extended attributes or ACLs cannot
# be tested (missing tools or no user xattr support under TMPDIR).

# ------------------------------------------------------------------------------
# Logging helpers
# ------------------------------------------------------------------------------

log() {
  printf '[test] %s\n' "$*" >&2
}

pass() {
  printf '[PASS] %s\n' "$*" >&2
}

fail() {
  printf '[FAIL] %s\n' "$*" >&2
}

skip() {
  printf '[SKIP] %s\n' "$*" >&2
}

die() {
  printf '[FATAL] %s\n' "$*" >&2
  exit 1
}

# ------------------------------------------------------------------------------
# Cleanup
# ------------------------------------------------------------------------------

cleanup() {
  if [[ -n "${T_S3_CONFIG:-}" && -f "$T_S3_CONFIG" ]]; then
    t_s3_delete_prefix "$S3_RUN_PREFIX" || true
  fi
  rm -rf "$TEST_ROOT"
}

trap cleanup EXIT

# ------------------------------------------------------------------------------
# Assertions
# ------------------------------------------------------------------------------

assert_file_exists() {
  local path="$1"
  [[ -f "$path" ]] || {
    log "Expected file to exist: $path"
    return 1
  }
}

assert_file_not_exists() {
  local path="$1"
  [[ ! -e "$path" ]] || {
    log "Expected path NOT to exist: $path"
    return 1
  }
}

assert_dir_exists() {
  local path="$1"
  [[ -d "$path" ]] || {
    log "Expected directory to exist: $path"
    return 1
  }
}

# Prints a canonical manifest of a tree: one line per entry below the root
# with type, mode, owner, group, size (files), whole-second mtime (not for
# symlinks) and symlink target.
tree_manifest() {
  (
    cd "$1" || exit 1
    find . -mindepth 1 -printf '%P\t%y\t%m\t%U\t%G\t%s\t%T@\t%l\n' \
      | awk -F'\t' 'BEGIN { OFS = "\t" }
        {
          split($7, t, ".")
          $7 = t[1]
          if ($2 == "d") $6 = "-"
          if ($2 == "l") $7 = "-"
          print
        }' \
      | LC_ALL=C sort
  )
}

# Prints groups of hard-linked paths (one sorted, space-separated group per line)
hardlink_groups() {
  (
    cd "$1" || exit 1
    find . -mindepth 1 -type f -links +1 -printf '%i\t%P\n' \
      | LC_ALL=C sort \
      | awk -F'\t' '
        $1 != prev { if (line != "") print line; line = $2; prev = $1; next }
        { line = line " " $2 }
        END { if (line != "") print line }' \
      | LC_ALL=C sort
  )
}

# Prints the ACLs and extended attributes of every entry (when the tools exist)
tree_extended_attributes() {
  (
    cd "$1" || exit 1
    local path
    while IFS= read -r -d '' path; do
      if command -v getfacl >/dev/null 2>&1; then
        printf '%s\tacl\t%s\n' "$path" "$(getfacl -p -n --omit-header -- "$path" 2>/dev/null | grep -v '^$' | tr '\n' ' ')"
      fi
      if command -v getfattr >/dev/null 2>&1; then
        printf '%s\txattr\t%s\n' "$path" "$(getfattr -h -d -m - --absolute-names -- "$path" 2>/dev/null \
          | grep -v -e '^#' -e '^$' -e '^security\.selinux=' | LC_ALL=C sort | tr '\n' ' ')"
      fi
    done < <(find . -mindepth 1 ! -type l -print0 | LC_ALL=C sort -z)
  )
}

assert_dirs_equal() {
  local left="$1"
  local right="$2"
  local kind l_out r_out

  for kind in tree_manifest hardlink_groups tree_extended_attributes; do
    l_out="$("$kind" "$left")" || true
    r_out="$("$kind" "$right")" || true
    [[ "$l_out" == "$r_out" ]] || {
      log "Trees differ ($kind):"
      log "  left:  $left"
      log "  right: $right"
      diff <(printf '%s\n' "$l_out") <(printf '%s\n' "$r_out") >&2 || true
      return 1
    }
  done

  diff -r "$left" "$right" >/dev/null 2>&1 || {
    log "File contents differ:"
    log "  left:  $left"
    log "  right: $right"
    diff -r "$left" "$right" >&2 || true
    return 1
  }
}

# Owner, group, mode and whole-second mtime of a directory itself
dir_root_metadata() {
  local mtime
  mtime="$(stat -c '%Y' "$1")"
  printf '%s\t%s\n' "$(stat -c '%u:%g %a' "$1")" "$mtime"
}

xattr_tests_enabled() {
  command -v setfattr >/dev/null 2>&1 && command -v getfattr >/dev/null 2>&1 || return 1
  local probe="$TEST_ROOT/.xattr-probe"
  : > "$probe"
  setfattr -n user.vbtest -v 1 "$probe" 2>/dev/null
}

# Runs the given command (with its arguments kept intact) and fails if it succeeds.
expect_rejected() {
  local rc=0
  "$@" 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: expected failure, but succeeded: $*"
    return 1
  }
}

assert_text_file_contains() {
  local path="$1"
  local expected="$2"

  grep -Fqx "$expected" "$path" || {
    log "Expected file '$path' to contain exact line: $expected"
    return 1
  }
}

# ------------------------------------------------------------------------------
# Command helpers
# ------------------------------------------------------------------------------

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

run_backup() {
  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    bash "$BACKUP_BIN" "$@"
}

run_backup_with_env() {
  local -a env_args=()

  while [[ $# -gt 0 ]]; do
    if [[ "$1" == -- ]]; then
      shift
      break
    fi
    env_args+=("$1")
    shift
  done

  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    "${env_args[@]}" \
    bash "$BACKUP_BIN" "$@"
}

run_restore() {
  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    bash "$RESTORE_BIN" "$@"
}

run_restore_with_env() {
  local -a env_args=()

  while [[ $# -gt 0 ]]; do
    if [[ "$1" == -- ]]; then
      shift
      break
    fi
    env_args+=("$1")
    shift
  done

  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    "${env_args[@]}" \
    bash "$RESTORE_BIN" "$@"
}

# ------------------------------------------------------------------------------
# Test workspace helpers
# ------------------------------------------------------------------------------

setup_case() {
  local name="$1"

  CURRENT_CASE="$name"
  CASE_ROOT="$TEST_ROOT/$name"
  TEST_BACKUP_ROOT="$CASE_ROOT/backups"
  TEST_VOLUMES_ROOT="$CASE_ROOT/volumes"
  TEST_GPG_ROOT="$CASE_ROOT/gpg"

  mkdir -p "$TEST_BACKUP_ROOT" "$TEST_VOLUMES_ROOT" "$TEST_GPG_ROOT"

  unset GPG_PUBLIC_KEY
  unset GPG_PRIVATE_KEY
  unset GPG_PASSPHRASE
}

make_volume_content() {
  local vol="$1"
  local root="$TEST_VOLUMES_ROOT/$vol"

  mkdir -p "$root/subdir" "$root/config" "$root/empty-dir" "$root/shared"

  printf 'hello from %s\n' "$vol" > "$root/hello.txt"
  printf 'nested file for %s\n' "$vol" > "$root/subdir/nested.txt"
  printf '{"volume":"%s","ok":true}\n' "$vol" > "$root/config/app.json"

  # small binary-ish content
  dd if=/dev/zero of="$root/subdir/blob.bin" bs=64 count=1 >/dev/null 2>&1
  printf 'tail-%s\n' "$vol" >> "$root/subdir/blob.bin"

  # names with spaces and non-ASCII characters
  printf 'spaces\n' > "$root/subdir/file with spaces.txt"
  printf 'unicode\n' > "$root/subdir/юникод-ñ.txt"

  # symlinks, hard links, special modes
  ln -s nested.txt "$root/subdir/link-to-nested"
  ln -s ../config "$root/subdir/link-to-config"
  printf 'linked\n' > "$root/shared/original.txt"
  ln "$root/shared/original.txt" "$root/shared/hardlink.txt"
  chmod 2750 "$root/shared"
  chmod 0640 "$root/config/app.json"
  chown 1234:2345 "$root/subdir/nested.txt" 2>/dev/null || true
  touch -d '2020-02-03 04:05:06' "$root/hello.txt"

  # extended attributes and ACLs, when the filesystem supports them
  if command -v setfattr >/dev/null 2>&1; then
    setfattr -n user.vbtest -v "value-$vol" "$root/hello.txt" 2>/dev/null || true
  fi
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -m u:4321:r "$root/config/app.json" 2>/dev/null || true
  fi
}

copy_volume_snapshot() {
  local vol="$1"
  local dst="$2"

  mkdir -p "$dst"
  cp -a "$TEST_VOLUMES_ROOT/$vol/." "$dst/"
}

clear_volume_dir() {
  local vol="$1"
  rm -rf "$TEST_VOLUMES_ROOT/$vol"
  mkdir -p "$TEST_VOLUMES_ROOT/$vol"
}

# Mirror Docker semantics: --volume name:/volumes/name always creates the
# mount point inside the container before our script runs. Tests that use
# a fresh target name must prepare it the same way.
prepare_target_volume() {
  local vol="$1"
  mkdir -p "$TEST_VOLUMES_ROOT/$vol"
}

replace_volume_with_marker() {
  local vol="$1"
  local marker="$2"

  rm -rf "$TEST_VOLUMES_ROOT/$vol"
  mkdir -p "$TEST_VOLUMES_ROOT/$vol"
  printf '%s\n' "$marker" > "$TEST_VOLUMES_ROOT/$vol/marker.txt"
}

# ------------------------------------------------------------------------------
# GPG helpers
# ------------------------------------------------------------------------------

# Writes <prefix>public.asc and <prefix>private.asc to TEST_GPG_ROOT
generate_gpg_keypair_files() {
  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"

  local prefix="${1:-}"
  # Short path: the agent socket path must fit in 108 bytes
  local keyhome
  keyhome="$(mktemp -d "$TEST_ROOT/kg.XXXXXX")"
  chmod 700 "$keyhome"
  printf 'allow-loopback-pinentry\n' > "$keyhome/gpg-agent.conf"

  GNUPGHOME="$keyhome" gpgconf --launch gpg-agent >/dev/null 2>&1 || true

  cat > "$CASE_ROOT/gpg-batch.conf" <<EOF
%no-protection
%transient-key
Key-Type: RSA
Key-Length: 2048
Subkey-Type: RSA
Subkey-Length: 2048
Name-Real: Backup Test ${prefix}
Name-Email: backup-test@example.invalid
Expire-Date: 0
%commit
EOF

  GNUPGHOME="$keyhome" gpg --batch --gen-key "$CASE_ROOT/gpg-batch.conf" >/dev/null 2>&1 || {
    log "Failed to generate test GPG keypair"
    GNUPGHOME="$keyhome" gpgconf --kill gpg-agent >/dev/null 2>&1 || true
    return 1
  }

  GNUPGHOME="$keyhome" gpg --armor --export > "$TEST_GPG_ROOT/${prefix}public.asc" || return 1
  GNUPGHOME="$keyhome" gpg --armor --export-secret-keys > "$TEST_GPG_ROOT/${prefix}private.asc" || return 1

  GNUPGHOME="$keyhome" gpgconf --kill gpg-agent >/dev/null 2>&1 || true
}

# ------------------------------------------------------------------------------
# Optional S3 helpers
# ------------------------------------------------------------------------------

# These helpers talk to S3 with plain curl on purpose: the tests must not rely
# on the S3 client code they are testing.

S3_RUN_PREFIX=""
T_S3_CONFIG=""

s3_tests_enabled() {
  [[ -n "${TEST_S3_BUCKET:-}" ]] || return 1
  [[ -n "${AWS_ACCESS_KEY_ID:-}" ]] || return 1
  [[ -n "${AWS_SECRET_ACCESS_KEY:-}" ]] || return 1
  command -v curl >/dev/null 2>&1 || return 1
  return 0
}

# Returns 0 when S3 tests can run, SKIP_RC when they cannot, and 1 instead of
# skipping when REQUIRE_S3_TESTS=1 (CI must not go green on silent skips).
require_s3_or_skip() {
  if s3_tests_enabled; then
    t_s3_init
    return 0
  fi

  if [[ "${REQUIRE_S3_TESTS:-0}" == 1 ]]; then
    log "S3 tests are required (REQUIRE_S3_TESTS=1) but S3 is not configured"
    return 1
  fi

  return "$SKIP_RC"
}

t_s3_init() {
  [[ -z "$T_S3_CONFIG" ]] || return 0

  local base_prefix="${TEST_S3_PREFIX:-docker-volume-tests}"
  base_prefix="${base_prefix#/}"
  base_prefix="${base_prefix%/}"
  S3_RUN_PREFIX="${base_prefix:+${base_prefix}/}run-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"

  T_S3_CONFIG="$TEST_ROOT/curl-s3.conf"
  (
    umask 077
    printf 'silent\nshow-error\n'
    printf 'user = "%s:%s"\n' "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY"
    printf 'aws-sigv4 = "aws:amz:%s:s3"\n' "${AWS_REGION:-us-east-1}"
    if [[ -n "${AWS_SESSION_TOKEN:-}" ]]; then
      printf 'header = "x-amz-security-token: %s"\n' "$AWS_SESSION_TOKEN"
    fi
  ) > "$T_S3_CONFIG"
}

# Unique per-test prefix below the per-run prefix
t_s3_prefix() {
  printf '%s/%s\n' "$S3_RUN_PREFIX" "$1"
}

t_s3_url() {
  local endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  printf '%s/%s/%s' "${endpoint%/}" "$TEST_S3_BUCKET" "$1"
}

# Prints the HTTP status of a HEAD request for the key
t_s3_head() {
  curl -K "$T_S3_CONFIG" -o /dev/null -w '%{http_code}' --head "$(t_s3_url "$1")" || true
}

t_s3_get() {
  curl -K "$T_S3_CONFIG" --fail -o "$2" "$(t_s3_url "$1")"
}

# Uploads a file unconditionally; prints the HTTP status
t_s3_put() {
  local key="$1" file="$2"
  shift 2
  curl -K "$T_S3_CONFIG" -o /dev/null -w '%{http_code}' --upload-file "$file" "$@" "$(t_s3_url "$key")" || true
}

# Prints the number of in-progress multipart uploads for the key
t_s3_pending_uploads() {
  local endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  curl -K "$T_S3_CONFIG" --fail "${endpoint%/}/${TEST_S3_BUCKET}?uploads&prefix=$1" \
    | grep -o '<UploadId>' | wc -l
}

# Deletes every object below a prefix (test cleanup only)
t_s3_delete_prefix() {
  local prefix="$1" endpoint key
  endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  [[ -n "$prefix" ]] || return 0

  curl -K "$T_S3_CONFIG" --fail "${endpoint%/}/${TEST_S3_BUCKET}?list-type=2&prefix=${prefix}/" 2>/dev/null \
    | tr '<' '\n' | awk -F'>' '$1 == "Key" { print $2 }' \
    | while IFS= read -r key; do
      curl -K "$T_S3_CONFIG" -o /dev/null -X DELETE "$(t_s3_url "$key")" || true
    done
}

# Creates a curl wrapper in <dir> that records every invocation's arguments in
# <dir>/curl.trace and can simulate S3 behaviour selected by <mode>:
#   trace                  pass everything through
#   deny                   answer every request with HTTP 403
#   complete-501           answer conditional CompleteMultipartUpload with 501
#   complete-lost          run the first CompleteMultipartUpload, then report a
#                          transport error (the response got lost)
#   complete-lost-foreign  instead of the first CompleteMultipartUpload, store a
#                          foreign object at the key and report a transport error
make_curl_stub() {
  local dir="$1" mode="$2" real_curl
  real_curl="$(command -v curl)"
  mkdir -p "$dir"

  cat > "$dir/curl" <<STUB
#!/usr/bin/env bash
real_curl='$real_curl'
mode='$mode'
state='$dir'
printf '%s\n' "\$*" >> "\$state/curl.trace"

out="" url="" conditional=0 is_post=0 has_w=0 prev=""
for arg in "\$@"; do
  case "\$prev" in
    -o) out="\$arg" ;;
    -w) has_w=1 ;;
    -X) [[ "\$arg" == POST ]] && is_post=1 ;;
    -H) [[ "\$arg" == "If-None-Match: *" ]] && conditional=1 ;;
  esac
  [[ "\$arg" == http://* || "\$arg" == https://* ]] && url="\$arg"
  prev="\$arg"
done
is_complete=0
[[ \$is_post == 1 && "\$url" == *"?uploadId="* ]] && is_complete=1

case "\$mode" in
  deny)
    [[ -n "\$out" && "\$out" != /dev/null && "\$out" != - ]] && printf '<Error><Code>AccessDenied</Code></Error>' > "\$out"
    if (( has_w )); then
      printf '403'
      exit 0
    fi
    exit 22
    ;;
  complete-501)
    if (( is_complete && conditional )); then
      printf '<Error><Code>NotImplemented</Code></Error>' > "\$out"
      printf '501'
      exit 0
    fi
    ;;
  complete-lost)
    if (( is_complete )) && [[ ! -e "\$state/lost.done" ]]; then
      : > "\$state/lost.done"
      "\$real_curl" "\$@" > /dev/null 2>&1
      printf '000'
      exit 52
    fi
    ;;
  complete-lost-foreign)
    if (( is_complete )) && [[ ! -e "\$state/lost.done" ]]; then
      : > "\$state/lost.done"
      printf 'foreign' > "\$state/foreign.bin"
      "\$real_curl" -K '$T_S3_CONFIG' -o /dev/null --upload-file "\$state/foreign.bin" "\${url%%\?*}"
      printf '000'
      exit 52
    fi
    ;;
esac

exec "\$real_curl" "\$@"
STUB
  chmod +x "$dir/curl"
}

# Prints the PIDs of a process and all of its descendants
process_tree_pids() {
  local root="$1" stat_file content pid ppid current
  local -A children=()

  for stat_file in /proc/[0-9]*/stat; do
    content="$(cat "$stat_file" 2>/dev/null)" || continue
    pid="${content%% *}"
    content="${content##*) }"
    ppid="${content#* }"
    ppid="${ppid%% *}"
    children[$ppid]+=" $pid"
  done

  local -a queue=("$root")
  while (( ${#queue[@]} > 0 )); do
    current="${queue[0]}"
    queue=("${queue[@]:1}")
    printf '%s\n' "$current"
    for pid in ${children[$current]:-}; do
      queue+=("$pid")
    done
  done
}

# Runs backup in the background, pausing at a test point:
#   start_paused_backup <point> [env assignments...] -- <backup args...>
start_paused_backup() {
  local point="$1"
  shift
  PAUSE_DIR="$CASE_ROOT/pause"
  mkdir -p "$PAUSE_DIR"

  run_backup_with_env VB_TEST_HOOKS=1 VB_TEST_PAUSE_AT="$point" VB_TEST_PAUSE_DIR="$PAUSE_DIR" "$@" \
    > "$CASE_ROOT/paused.log" 2>&1 &
  PAUSED_PID=$!
}

wait_for_point() {
  local point="$1" i
  for (( i = 0; i < 600; i++ )); do
    [[ -e "$PAUSE_DIR/${point}.reached" ]] && return 0
    kill -0 "$PAUSED_PID" 2>/dev/null || break
    sleep 0.1
  done
  log "Process did not reach test point '$point'"
  cat "$CASE_ROOT/paused.log" >&2 || true
  return 1
}

resume_and_wait() {
  local point="$1" rc=0
  : > "$PAUSE_DIR/${point}.continue"
  wait "$PAUSED_PID" || rc=$?
  cat "$CASE_ROOT/paused.log" >&2 || true
  return "$rc"
}

# Runs restore in the background, pausing at a test point:
#   start_paused_restore <point> [env assignments...] -- <restore args...>
start_paused_restore() {
  local point="$1"
  shift
  PAUSE_DIR="$CASE_ROOT/pause"
  mkdir -p "$PAUSE_DIR"

  run_restore_with_env VB_TEST_HOOKS=1 VB_TEST_PAUSE_AT="$point" VB_TEST_PAUSE_DIR="$PAUSE_DIR" "$@" \
    > "$CASE_ROOT/paused.log" 2>&1 &
  PAUSED_PID=$!
}

# Prints the PID of the backup or restore script started in the background
paused_script_pid() {
  local pid cmdline
  while IFS= read -r pid; do
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" || continue
    if [[ "$cmdline" == *" $BACKUP_BIN "* || "$cmdline" == *" $RESTORE_BIN "* ]]; then
      printf '%s\n' "$pid"
      return 0
    fi
  done < <(process_tree_pids "$PAUSED_PID")
  log "Could not find the script process below $PAUSED_PID"
  return 1
}

# Sends a signal to the paused script (only to it, not to its children) and
# checks that it exits with <expected rc> and leaves no process behind.
#   signal_paused_script <signal> <expected rc>
signal_paused_script() {
  local signal="$1" expected="$2" pid rc=0 i survivors=""
  pid="$(paused_script_pid)" || return 1
  kill "-$signal" "$pid"

  for (( i = 0; i < 600; i++ )); do
    kill -0 "$PAUSED_PID" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$PAUSED_PID" 2>/dev/null; then
    log "BUG: the script did not exit within 60 seconds after SIG$signal"
    # shellcheck disable=SC2046 # one PID per word
    kill -KILL $(process_tree_pids "$PAUSED_PID") 2>/dev/null || true
    wait "$PAUSED_PID" 2>/dev/null || true
    return 1
  fi
  wait "$PAUSED_PID" || rc=$?
  (( rc == expected )) || {
    log "Expected exit $expected after SIG$signal, got $rc"
    cat "$CASE_ROOT/paused.log" >&2 || true
    return 1
  }

  # Every process of the run inherited VB_TEST_PAUSE_DIR
  for (( i = 0; i < 50; i++ )); do
    survivors="$(processes_with_env "VB_TEST_PAUSE_DIR=$PAUSE_DIR")"
    [[ -n "$survivors" ]] || return 0
    sleep 0.1
  done
  log "Processes survived SIG$signal:"
  for pid in $survivors; do
    log "  $pid: $(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
  done
  return 1
}

# Lists processes whose environment contains <text>
processes_with_env() {
  local text="$1" environ pid
  for environ in /proc/[0-9]*/environ; do
    pid="${environ#/proc/}"
    pid="${pid%/environ}"
    [[ "$pid" != "$$" && "$pid" != "$BASHPID" ]] || continue
    if grep -qaF -- "$text" "$environ" 2>/dev/null; then
      printf '%s\n' "$pid"
    fi
  done
}

# ------------------------------------------------------------------------------
# Test functions
# ------------------------------------------------------------------------------

test_single_backup_restore_plain() {
  setup_case "single_backup_restore_plain"

  make_volume_content "alpha"

  local ts="20250101_010101"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"
  local checksum="${archive}.sha256"

  run_backup -v alpha -T "$ts" || return 1
  assert_file_exists "$archive" || return 1
  assert_file_exists "$checksum" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$archive" -t alpha_restore || return 1
  assert_dir_exists "$TEST_VOLUMES_ROOT/alpha_restore" || return 1

  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}


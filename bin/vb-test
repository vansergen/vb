test_invalid_flags_and_missing_args() {
  setup_case "invalid_flags_and_missing_args"

  make_volume_content "alpha"

  set +e
  run_backup -z >/dev/null 2>&1
  local backup_invalid_flag_rc=$?
  run_backup -v >/dev/null 2>&1
  local backup_missing_arg_rc=$?
  run_restore -z >/dev/null 2>&1
  local restore_invalid_flag_rc=$?
  run_restore -i "$TEST_BACKUP_ROOT/missing.tar" >/dev/null 2>&1
  local restore_missing_arg_rc=$?
  set -e

  (( backup_invalid_flag_rc != 0 )) || return 1
  (( backup_missing_arg_rc != 0 )) || return 1
  (( restore_invalid_flag_rc != 0 )) || return 1
  (( restore_missing_arg_rc != 0 )) || return 1
}

test_restore_leftover_tmp_does_not_block() {
  setup_case "restore_leftover_tmp_does_not_block"

  make_volume_content "alpha"

  local ts="20250101_011112"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"
  local snapshot="$CASE_ROOT/expected-alpha"

  run_backup -v alpha -T "$ts" || return 1
  copy_volume_snapshot "alpha" "$snapshot"

  clear_volume_dir "alpha"

  # Simulate a leftover tmp dir (with content) from a previously killed restore
  mkdir -p "$TEST_VOLUMES_ROOT/alpha/.restore-in-progress.LEFTOVER"
  printf 'stale content\n' > "$TEST_VOLUMES_ROOT/alpha/.restore-in-progress.LEFTOVER/stale.txt"

  # Restore without -C: target looks empty (only leftover present), should succeed
  run_restore -i "$archive" -t alpha || return 1

  assert_dirs_equal "$snapshot" "$TEST_VOLUMES_ROOT/alpha" || return 1

  [[ ! -e "$TEST_VOLUMES_ROOT/alpha/.restore-in-progress.LEFTOVER" ]] || {
    log "BUG: leftover staging dir survived restore"
    return 1
  }
}

test_restore_is_atomic_on_failure() {
  setup_case "restore_is_atomic_on_failure"

  make_volume_content "alpha"

  local ts="20250101_011111"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"

  run_backup -v alpha -T "$ts" || return 1

  # Remove the checksum so verification doesn't catch the corruption before clear_target_contents runs
  rm -f "${archive}.sha256"

  # Corrupt the archive so extraction will fail mid-stream
  printf 'this is not a valid tar archive' > "$archive"

  # Put a distinct marker in the volume — this must survive a failed restore
  replace_volume_with_marker "alpha" "original-content-must-survive"

  # Attempt restore with -C: without staged extraction, the volume would be
  # cleared BEFORE extracting, and a failed extract would leave it empty.
  local rc=0
  run_restore -i "$archive" -t alpha -C 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: restore succeeded with a corrupt archive"
    return 1
  }

  assert_text_file_contains "$TEST_VOLUMES_ROOT/alpha/marker.txt" "original-content-must-survive" || {
    log "BUG: non-atomic restore cleared the volume but failed to complete it — volume left empty"
    return 1
  }
}

test_backup_restore_sparse_file() {
  tar --version 2>/dev/null | grep -q 'GNU tar' || return "$SKIP_RC"

  setup_case "backup_restore_sparse_file"

  local ts="20250101_120001"
  local sparse_file="$TEST_VOLUMES_ROOT/alpha/sparse.img"

  mkdir -p "$TEST_VOLUMES_ROOT/alpha"

  # Create a 4MB sparse file (only last byte written — minimal actual disk use)
  dd if=/dev/zero of="$sparse_file" bs=1 count=1 seek=$((4*1024*1024-1)) 2>/dev/null

  local apparent_size
  apparent_size="$(wc -c < "$sparse_file")"

  run_backup -v alpha -T "$ts" || return 1

  # With --sparse, the archive should be much smaller than the apparent file size
  local archive_size
  archive_size="$(wc -c < "$TEST_BACKUP_ROOT/alpha_${ts}.tar")"
  (( archive_size < apparent_size / 2 )) || {
    log "BUG: archive ($archive_size bytes) is not smaller than apparent file size ($apparent_size bytes) — --sparse flag may be missing"
    return 1
  }

  clear_volume_dir "alpha"

  run_restore -i "$TEST_BACKUP_ROOT/alpha_${ts}.tar" -t alpha || return 1

  # Restored file must have the same apparent size
  local restored_size
  restored_size="$(wc -c < "$TEST_VOLUMES_ROOT/alpha/sparse.img")"
  (( restored_size == apparent_size )) || {
    log "Apparent size mismatch after restore: expected $apparent_size, got $restored_size"
    return 1
  }
}

test_restore_fails_when_volumes_root_missing() {
  setup_case "restore_fails_when_volumes_root_missing"

  make_volume_content "alpha"

  local ts="20250101_111111"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"

  run_backup -v alpha -T "$ts" || return 1

  # Simulate "user forgot --volume" — VOLUMES_ROOT itself does not exist.
  # In a docker run --rm without any volume mounts, /volumes never appears;
  # without the mount guard, restore would silently mkdir -p it on the
  # ephemeral overlay and report success while the data dies with the container.
  local missing_volumes="$CASE_ROOT/missing-volumes"
  rm -rf "$missing_volumes"

  local rc=0
  run_restore_with_env VOLUMES_ROOT="$missing_volumes" -- \
    -i "$archive" -t whatever 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: restore succeeded when VOLUMES_ROOT did not exist"
    return 1
  }

  [[ ! -e "$missing_volumes" ]] || {
    log "BUG: restore created VOLUMES_ROOT path that did not exist"
    return 1
  }
}

test_restore_fails_when_target_not_mounted() {
  setup_case "restore_fails_when_target_not_mounted"

  make_volume_content "alpha"

  local ts="20250101_111112"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"

  run_backup -v alpha -T "$ts" || return 1

  # VOLUMES_ROOT exists (setup_case made it), but the target subdirectory
  # does not — equivalent to forgetting --volume <name>:/volumes/<name>
  # while having some other unrelated mount under /volumes.
  local target_name="notmounted"
  rm -rf "$TEST_VOLUMES_ROOT/$target_name"

  local rc=0
  run_restore -i "$archive" -t "$target_name" 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: restore succeeded into a target subdirectory that was not mounted"
    return 1
  }

  [[ ! -d "$TEST_VOLUMES_ROOT/$target_name" ]] || {
    log "BUG: restore created the target subdirectory in VOLUMES_ROOT despite no mount"
    return 1
  }
}

test_local_checksum_detects_tampering_after_move() {
  setup_case "local_checksum_detects_tampering_after_move"

  make_volume_content "alpha"

  local ts="20250101_222222"
  local orig_archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"
  local orig_sha="${orig_archive}.sha256"

  run_backup -v alpha -T "$ts" || return 1
  assert_file_exists "$orig_archive" || return 1
  assert_file_exists "$orig_sha" || return 1

  # Copy archive + sidecar to a separate "new" backup root.
  # Leave the originals untouched at their original path — a path-based
  # `sha256sum -c` would happily verify against them instead of src_path.
  local new_root="$CASE_ROOT/moved-backups"
  mkdir -p "$new_root"
  cp "$orig_archive" "$new_root/"
  cp "$orig_sha" "$new_root/"

  # Tamper the moved archive in place — different but still valid tar
  local fake_dir="$CASE_ROOT/fake-source"
  mkdir -p "$fake_dir"
  printf 'TAMPERED\n' > "$fake_dir/tampered.txt"
  tar -cf "$new_root/alpha_${ts}.tar" -C "$fake_dir" tampered.txt

  # Pre-create the target so this test isolates the checksum bug from the
  # mount-guard fix landing alongside it.
  mkdir -p "$TEST_VOLUMES_ROOT/alpha_restore"

  local rc=0
  run_restore_with_env BACKUP_ROOT="$new_root" -- \
    -i "alpha_${ts}.tar" -t alpha_restore -C 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: restore accepted tampered archive — checksum was checked against the stale original"
    return 1
  }

  [[ ! -e "$TEST_VOLUMES_ROOT/alpha_restore/tampered.txt" ]] || {
    log "BUG: tampered content reached the target volume after a 'passed' verification"
    return 1
  }
}

test_rejects_dot_and_escaping_volume_names() {
  setup_case "rejects_dot_and_escaping_volume_names"

  make_volume_content "alpha"
  make_volume_content "victim"

  local ts="20250101_131313"
  local rejected_ts="20250101_131314"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"
  local snapshot="$CASE_ROOT/expected-victim"

  run_backup -v alpha -T "$ts" || return 1
  copy_volume_snapshot "victim" "$snapshot"

  # A symlink inside VOLUMES_ROOT must not be followed out of it
  mkdir -p "$CASE_ROOT/outside"
  printf 'outside\n' > "$CASE_ROOT/outside/keep.txt"
  ln -s ../outside "$TEST_VOLUMES_ROOT/escape"

  local name rc
  for name in . .. escape; do
    rc=0
    run_restore -i "$archive" -t "$name" -C 2>/dev/null || rc=$?
    (( rc != 0 )) || {
      log "BUG: restore accepted target volume '$name'"
      return 1
    }

    rc=0
    run_backup -v "$name" -T "$rejected_ts" 2>/dev/null || rc=$?
    (( rc != 0 )) || {
      log "BUG: backup accepted volume '$name'"
      return 1
    }
  done

  assert_dirs_equal "$snapshot" "$TEST_VOLUMES_ROOT/victim" || return 1
  assert_file_exists "$archive" || return 1
  assert_text_file_contains "$CASE_ROOT/outside/keep.txt" "outside" || return 1

  [[ -z "$(find "$TEST_BACKUP_ROOT" -name "*_${rejected_ts}.tar*")" ]] || {
    log "BUG: backup wrote an archive for a rejected volume name"
    return 1
  }
}

test_restore_all_skips_dot_named_backup_files() {
  setup_case "restore_all_skips_dot_named_backup_files"

  make_volume_content "alpha"
  make_volume_content "beta"

  local ts="20250101_141414"
  local newer="20250101_151515"
  local snapshot_alpha="$CASE_ROOT/expected-alpha"
  local snapshot_beta="$CASE_ROOT/expected-beta"

  run_backup -v alpha -T "$ts" || return 1
  copy_volume_snapshot "alpha" "$snapshot_alpha"
  copy_volume_snapshot "beta" "$snapshot_beta"

  # Stray files whose names parse as volumes '.', '..' and '._alpha'
  # (e.g. macOS AppleDouble files left on a NAS share)
  local stray
  for stray in "._${newer}.tar" ".._${newer}.tar" "._alpha_${newer}.tar"; do
    cp "$TEST_BACKUP_ROOT/alpha_${ts}.tar" "$TEST_BACKUP_ROOT/$stray"
  done

  replace_volume_with_marker "alpha" "alpha-mutated"

  run_restore -a -C || return 1

  assert_dirs_equal "$snapshot_alpha" "$TEST_VOLUMES_ROOT/alpha" || return 1
  assert_dirs_equal "$snapshot_beta" "$TEST_VOLUMES_ROOT/beta" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/alpha_${ts}.tar" || return 1
}

test_jobs_value_is_validated_before_use() {
  setup_case "jobs_value_is_validated_before_use"

  make_volume_content "alpha"

  local marker="$CASE_ROOT/injected"
  # Must reach the script as ONE argument: a subscript with a command
  # substitution that bash would run if -j were used in (( )) unvalidated.
  local payload="PATH[\$(touch $marker)]"

  expect_rejected run_backup -v alpha -n -j "$payload" || return 1
  expect_rejected run_backup -a -n -j "$payload" || return 1
  expect_rejected run_restore -i missing.tar -t alpha -j "$payload" || return 1
  expect_rejected run_restore -a -n -j "$payload" || return 1

  assert_file_not_exists "$marker" || {
    log "BUG: -j value was evaluated as an arithmetic expression"
    return 1
  }

  expect_rejected run_backup -a -n -j 0 || return 1
  expect_rejected run_backup -a -n -j 100 || return 1
  expect_rejected run_backup -a -n -j 1x || return 1

  run_backup -a -n -j 99 2>/dev/null || {
    log "Expected -j 99 to be accepted"
    return 1
  }
}

test_s3_roundtrip_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_roundtrip_optional"

  make_volume_content "alpha"

  local ts="20250101_040000"
  local base_prefix="${TEST_S3_PREFIX:-docker-volume-tests}"
  base_prefix="${base_prefix#/}"
  base_prefix="${base_prefix%/}"

  local suffix="$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"
  local prefix="$suffix"
  if [[ -n "$base_prefix" ]]; then
    prefix="${base_prefix}/${suffix}"
  fi

  local key="alpha_${ts}.tar.gz"
  local s3_uri="s3://${TEST_S3_BUCKET}/${prefix}/${key}"

  run_backup -v alpha -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$s3_uri" -t alpha_restore -C || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_s3_checksum_roundtrip_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_checksum_roundtrip_optional"

  make_volume_content "alpha"

  local ts="20250101_040001"
  local base_prefix="${TEST_S3_PREFIX:-docker-volume-tests}"
  base_prefix="${base_prefix#/}"
  base_prefix="${base_prefix%/}"

  local suffix="chk-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"
  local prefix="$suffix"
  if [[ -n "$base_prefix" ]]; then
    prefix="${base_prefix}/${suffix}"
  fi

  local key="alpha_${ts}.tar.gz"
  local s3_uri="s3://${TEST_S3_BUCKET}/${prefix}/${key}"

  run_backup -v alpha -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  # Verify .sha256 was uploaded alongside the archive using mc directly
  local mc_cfg
  mc_cfg="$(mktemp -d)"
  local endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  local -a st_flags=()
  [[ -z "${AWS_SESSION_TOKEN:-}" ]] || st_flags=(--session-token "$AWS_SESSION_TOKEN")
  mc --config-dir "$mc_cfg" alias set vb "$endpoint" \
    "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY" "${st_flags[@]}" >/dev/null 2>&1
  local sha_exists=0
  mc --config-dir "$mc_cfg" stat "vb/${TEST_S3_BUCKET}/${prefix}/${key}.sha256" \
    >/dev/null 2>&1 && sha_exists=1
  rm -rf "$mc_cfg"

  (( sha_exists )) || {
    log "BUG: .sha256 was not uploaded to S3 alongside the archive"
    return 1
  }

  # Restore normally — checksum is verified automatically during download
  prepare_target_volume "alpha_restore"
  run_restore -i "$s3_uri" -t alpha_restore -C || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_s3_backup_fails_closed_on_stat_error() {
  setup_case "s3_backup_fails_closed_on_stat_error"
  make_volume_content "alpha"

  # Stub `mc` that simulates a non-"not found" error from `mc stat`
  # (e.g. access denied, network issue) while letting alias/pipe pass.
  local stub_bin="$CASE_ROOT/stub-bin"
  mkdir -p "$stub_bin"
  cat > "$stub_bin/mc" <<'EOF'
#!/usr/bin/env bash
# args: --config-dir <dir> <verb> ...
verb="$3"
if [[ "$verb" == "stat" ]]; then
  printf 'mc: <ERROR> Unable to stat: Access Denied.\n' >&2
  exit 1
fi
# Pretend other verbs succeed silently — the script must die before reaching them.
exit 0
EOF
  chmod +x "$stub_bin/mc"

  local rc=0
  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    AWS_ACCESS_KEY_ID=dummy \
    AWS_SECRET_ACCESS_KEY=dummy \
    PATH="$stub_bin:$PATH" \
    bash "$BACKUP_BIN" -v alpha -T 20250101_444444 -c -b irrelevant 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: backup proceeded despite ambiguous mc stat error — should fail closed"
    return 1
  }
}

test_s3_backup_fails_on_overwrite_optional() {
  require_s3_or_skip || return $?

  setup_case "s3_backup_fails_on_overwrite_optional"

  make_volume_content "alpha"

  local ts="20250101_333333"
  local base_prefix="${TEST_S3_PREFIX:-docker-volume-tests}"
  base_prefix="${base_prefix#/}"
  base_prefix="${base_prefix%/}"

  local suffix="overwrite-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"
  local prefix="$suffix"
  if [[ -n "$base_prefix" ]]; then
    prefix="${base_prefix}/${suffix}"
  fi

  # First backup — must succeed
  run_backup -v alpha -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  # Mutate the source so a re-run would produce different bytes
  printf 'second-version\n' > "$TEST_VOLUMES_ROOT/alpha/second.txt"

  # Second backup with the same timestamp must fail — the local backup path
  # already protects against this via [[ ! -e ]], so the default for S3
  # should match. A silent overwrite destroys the original recovery point.
  local rc=0
  run_backup -v alpha -T "$ts" -c -b "$TEST_S3_BUCKET" -f "$prefix" 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: S3 backup silently overwrote an existing object with the same timestamp"
    return 1
  }
}

test_s3_roundtrip_encrypted_optional() {
  require_s3_or_skip || return $?
  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"

  setup_case "s3_roundtrip_encrypted_optional"

  make_volume_content "alpha"
  export GPG_PASSPHRASE="test-s3-encrypted-passphrase"

  local ts="20250101_090006"
  local base_prefix="${TEST_S3_PREFIX:-docker-volume-tests}"
  base_prefix="${base_prefix#/}"
  base_prefix="${base_prefix%/}"

  local suffix="enc-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"
  local prefix="$suffix"
  if [[ -n "$base_prefix" ]]; then
    prefix="${base_prefix}/${suffix}"
  fi

  local key="alpha_${ts}.tar.gz.gpg"
  local s3_uri="s3://${TEST_S3_BUCKET}/${prefix}/${key}"

  run_backup -v alpha -T "$ts" -c -s -b "$TEST_S3_BUCKET" -f "$prefix" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$s3_uri" -t alpha_restore -s -C || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

# ------------------------------------------------------------------------------
# Test runner
# ------------------------------------------------------------------------------

run_test() {
  local name="$1"
  shift

  TESTS_TOTAL=$((TESTS_TOTAL + 1))

  set +e
  "$@"
  local rc=$?
  set -e

  case "$rc" in
    0)
      TESTS_PASSED=$((TESTS_PASSED + 1))
      pass "$name"
      ;;
    "$SKIP_RC")
      TESTS_SKIPPED=$((TESTS_SKIPPED + 1))
      skip "$name"
      ;;
    *)
      TESTS_FAILED=$((TESTS_FAILED + 1))
      fail "$name"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Preflight
# ------------------------------------------------------------------------------

[[ -f "$BACKUP_BIN" ]] || die "Backup script not found: $BACKUP_BIN"
[[ -f "$RESTORE_BIN" ]] || die "Restore script not found: $RESTORE_BIN"

require_command bash
require_command tar
require_command find
require_command diff

if ! command -v gzip >/dev/null 2>&1 && ! command -v pigz >/dev/null 2>&1; then
  die "Neither gzip nor pigz found; compressed tests cannot run"
fi

log "Using backup script:  $BACKUP_BIN"
log "Using restore script: $RESTORE_BIN"
log "Test root: $TEST_ROOT"

# ------------------------------------------------------------------------------
# Execute tests
# ------------------------------------------------------------------------------

run_test "single backup/restore plain"              test_single_backup_restore_plain
run_test "single backup/restore compressed"         test_single_backup_restore_compressed
run_test "single backup/restore symmetric"          test_single_backup_restore_symmetric
run_test "single backup/restore asymmetric"         test_single_backup_restore_asymmetric
run_test "all-mode filters + parallel"              test_all_mode_with_filters_and_parallel
run_test "backup single dry-run"                    test_backup_single_dry_run_creates_nothing
run_test "backup all dry-run"                       test_backup_all_dry_run_creates_nothing
run_test "restore single dry-run"                   test_restore_single_dry_run_changes_nothing
run_test "restore fails without -C on non-empty"    test_restore_fails_on_non_empty_without_clear_flag
run_test "backup fails on duplicate timestamp"      test_backup_fails_on_duplicate_timestamp
run_test "restore all: picks latest without -T"     test_restore_all_no_timestamp_picks_latest
run_test "restore all dry-run"                      test_restore_all_dry_run_changes_nothing
run_test "restore single: filename-only source"     test_restore_single_source_filename_only
run_test "backup root override (-d)"                test_backup_root_override
run_test "asymmetric GPG via env vars"              test_backup_restore_asymmetric_env_keys
run_test "single backup/restore .tar.gpg"           test_single_backup_restore_tar_gpg
run_test "volume names with dots and dashes"        test_volume_names_with_dots_and_dashes
run_test "BACKUP_TIMESTAMP via env var"             test_backup_timestamp_env_var
run_test "invalid flags and missing args"           test_invalid_flags_and_missing_args
run_test "restore: leftover tmp does not block"     test_restore_leftover_tmp_does_not_block
run_test "restore is atomic on failure"             test_restore_is_atomic_on_failure
run_test "backup/restore sparse file"               test_backup_restore_sparse_file
run_test "restore fails: VOLUMES_ROOT missing"      test_restore_fails_when_volumes_root_missing
run_test "restore fails: target not mounted"        test_restore_fails_when_target_not_mounted
run_test "local checksum detects tampering"         test_local_checksum_detects_tampering_after_move
run_test "rejects ./.. and escaping volume names"   test_rejects_dot_and_escaping_volume_names
run_test "restore all: skips dot-named files"       test_restore_all_skips_dot_named_backup_files
run_test "-j is validated before use"               test_jobs_value_is_validated_before_use
run_test "s3 roundtrip (optional)"                  test_s3_roundtrip_optional
run_test "s3 checksum roundtrip (optional)"         test_s3_checksum_roundtrip_optional
run_test "s3 backup fails closed on stat error"     test_s3_backup_fails_closed_on_stat_error
run_test "s3 backup fails on overwrite (optional)"  test_s3_backup_fails_on_overwrite_optional
run_test "s3 roundtrip encrypted (optional)"        test_s3_roundtrip_encrypted_optional

# ------------------------------------------------------------------------------
# Summary
# ------------------------------------------------------------------------------

printf '\n' >&2
printf 'Tests total : %d\n' "$TESTS_TOTAL" >&2
printf 'Passed      : %d\n' "$TESTS_PASSED" >&2
printf 'Skipped     : %d\n' "$TESTS_SKIPPED" >&2
printf 'Failed      : %d\n' "$TESTS_FAILED" >&2

if (( TESTS_FAILED > 0 )); then
  exit 1
fi

exit 0

#!/usr/bin/env bash
set -Eeuo pipefail

# ------------------------------------------------------------------------------
# Config
# ------------------------------------------------------------------------------

readonly SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_BIN="${BACKUP_BIN:-$SCRIPT_DIR/backup}"
RESTORE_BIN="${RESTORE_BIN:-$SCRIPT_DIR/restore}"

readonly SKIP_RC=200

TEST_ROOT="$(mktemp -d)"
CURRENT_CASE=""
CASE_ROOT=""
TEST_BACKUP_ROOT=""
TEST_VOLUMES_ROOT=""
TEST_GPG_ROOT=""

TESTS_TOTAL=0
TESTS_PASSED=0
TESTS_FAILED=0
TESTS_SKIPPED=0

# Optional S3 integration test:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_SESSION_TOKEN   (optional)
#   AWS_REGION          (optional, default us-east-1)
#   AWS_ENDPOINT_URL    (optional)
#   TEST_S3_BUCKET      (required for S3 tests)
#   TEST_S3_PREFIX      (optional)
#   REQUIRE_S3_TESTS=1  (optional, turn S3 skips into failures)

# ------------------------------------------------------------------------------
# Logging helpers
# ------------------------------------------------------------------------------

log() {
  printf '[test] %s\n' "$*" >&2
}

pass() {
  printf '[PASS] %s\n' "$*" >&2
}

fail() {
  printf '[FAIL] %s\n' "$*" >&2
}

skip() {
  printf '[SKIP] %s\n' "$*" >&2
}

die() {
  printf '[FATAL] %s\n' "$*" >&2
  exit 1
}

# ------------------------------------------------------------------------------
# Cleanup
# ------------------------------------------------------------------------------

cleanup() {
  if [[ -n "${T_S3_CONFIG:-}" && -f "$T_S3_CONFIG" ]]; then
    t_s3_delete_prefix "$S3_RUN_PREFIX" || true
  fi
  rm -rf "$TEST_ROOT"
}

trap cleanup EXIT

# ------------------------------------------------------------------------------
# Assertions
# ------------------------------------------------------------------------------

assert_file_exists() {
  local path="$1"
  [[ -f "$path" ]] || {
    log "Expected file to exist: $path"
    return 1
  }
}

assert_file_not_exists() {
  local path="$1"
  [[ ! -e "$path" ]] || {
    log "Expected path NOT to exist: $path"
    return 1
  }
}

assert_dir_exists() {
  local path="$1"
  [[ -d "$path" ]] || {
    log "Expected directory to exist: $path"
    return 1
  }
}

assert_dirs_equal() {
  local left="$1"
  local right="$2"

  local l_list r_list
  l_list="$(cd "$left" 2>/dev/null && find . -mindepth 1 | sort)" || true
  r_list="$(cd "$right" 2>/dev/null && find . -mindepth 1 | sort)" || true

  [[ "$l_list" == "$r_list" ]] || {
    log "Directory listings differ:"
    log "  left:  $left"
    log "  right: $right"
    diff <(printf '%s\n' "$l_list") <(printf '%s\n' "$r_list") >&2 || true
    return 1
  }

  diff -ruN "$left" "$right" >/dev/null 2>&1 || {
    log "File contents differ:"
    log "  left:  $left"
    log "  right: $right"
    diff -ruN "$left" "$right" >&2 || true
    return 1
  }
}

# Runs the given command (with its arguments kept intact) and fails if it succeeds.
expect_rejected() {
  local rc=0
  "$@" 2>/dev/null || rc=$?

  (( rc != 0 )) || {
    log "BUG: expected failure, but succeeded: $*"
    return 1
  }
}

assert_text_file_contains() {
  local path="$1"
  local expected="$2"

  grep -Fqx "$expected" "$path" || {
    log "Expected file '$path' to contain exact line: $expected"
    return 1
  }
}

# ------------------------------------------------------------------------------
# Command helpers
# ------------------------------------------------------------------------------

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

run_backup() {
  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    bash "$BACKUP_BIN" "$@"
}

run_backup_with_env() {
  local -a env_args=()

  while [[ $# -gt 0 ]]; do
    if [[ "$1" == -- ]]; then
      shift
      break
    fi
    env_args+=("$1")
    shift
  done

  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    "${env_args[@]}" \
    bash "$BACKUP_BIN" "$@"
}

run_restore() {
  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    bash "$RESTORE_BIN" "$@"
}

run_restore_with_env() {
  local -a env_args=()

  while [[ $# -gt 0 ]]; do
    if [[ "$1" == -- ]]; then
      shift
      break
    fi
    env_args+=("$1")
    shift
  done

  env \
    NO_COLOR=1 \
    BACKUP_ROOT="$TEST_BACKUP_ROOT" \
    VOLUMES_ROOT="$TEST_VOLUMES_ROOT" \
    GPG_ROOT="$TEST_GPG_ROOT" \
    "${env_args[@]}" \
    bash "$RESTORE_BIN" "$@"
}

# ------------------------------------------------------------------------------
# Test workspace helpers
# ------------------------------------------------------------------------------

setup_case() {
  local name="$1"

  CURRENT_CASE="$name"
  CASE_ROOT="$TEST_ROOT/$name"
  TEST_BACKUP_ROOT="$CASE_ROOT/backups"
  TEST_VOLUMES_ROOT="$CASE_ROOT/volumes"
  TEST_GPG_ROOT="$CASE_ROOT/gpg"

  mkdir -p "$TEST_BACKUP_ROOT" "$TEST_VOLUMES_ROOT" "$TEST_GPG_ROOT"

  unset GPG_PUBLIC_KEY
  unset GPG_PRIVATE_KEY
  unset GPG_PASSPHRASE
}

make_volume_content() {
  local vol="$1"
  local root="$TEST_VOLUMES_ROOT/$vol"

  mkdir -p "$root/subdir" "$root/config"

  printf 'hello from %s\n' "$vol" > "$root/hello.txt"
  printf 'nested file for %s\n' "$vol" > "$root/subdir/nested.txt"
  printf '{"volume":"%s","ok":true}\n' "$vol" > "$root/config/app.json"

  # small binary-ish content
  dd if=/dev/zero of="$root/subdir/blob.bin" bs=64 count=1 >/dev/null 2>&1
  printf 'tail-%s\n' "$vol" >> "$root/subdir/blob.bin"
}

copy_volume_snapshot() {
  local vol="$1"
  local dst="$2"

  mkdir -p "$dst"
  cp -a "$TEST_VOLUMES_ROOT/$vol/." "$dst/"
}

clear_volume_dir() {
  local vol="$1"
  rm -rf "$TEST_VOLUMES_ROOT/$vol"
  mkdir -p "$TEST_VOLUMES_ROOT/$vol"
}

# Mirror Docker semantics: --volume name:/volumes/name always creates the
# mount point inside the container before our script runs. Tests that use
# a fresh target name must prepare it the same way.
prepare_target_volume() {
  local vol="$1"
  mkdir -p "$TEST_VOLUMES_ROOT/$vol"
}

replace_volume_with_marker() {
  local vol="$1"
  local marker="$2"

  rm -rf "$TEST_VOLUMES_ROOT/$vol"
  mkdir -p "$TEST_VOLUMES_ROOT/$vol"
  printf '%s\n' "$marker" > "$TEST_VOLUMES_ROOT/$vol/marker.txt"
}

# ------------------------------------------------------------------------------
# GPG helpers
# ------------------------------------------------------------------------------

generate_gpg_keypair_files() {
  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"

  local keyhome="$CASE_ROOT/keygen-gnupg"
  mkdir -p "$keyhome"
  chmod 700 "$keyhome"
  printf 'allow-loopback-pinentry\n' > "$keyhome/gpg-agent.conf"

  GNUPGHOME="$keyhome" gpgconf --launch gpg-agent >/dev/null 2>&1 || true

  cat > "$CASE_ROOT/gpg-batch.conf" <<'EOF'
%no-protection
%transient-key
Key-Type: RSA
Key-Length: 2048
Subkey-Type: RSA
Subkey-Length: 2048
Name-Real: Backup Test
Name-Email: backup-test@example.invalid
Expire-Date: 0
%commit
EOF

  GNUPGHOME="$keyhome" gpg --batch --gen-key "$CASE_ROOT/gpg-batch.conf" >/dev/null 2>&1 || {
    log "Failed to generate test GPG keypair"
    GNUPGHOME="$keyhome" gpgconf --kill gpg-agent >/dev/null 2>&1 || true
    return 1
  }

  GNUPGHOME="$keyhome" gpg --armor --export > "$TEST_GPG_ROOT/public.asc" || return 1
  GNUPGHOME="$keyhome" gpg --armor --export-secret-keys > "$TEST_GPG_ROOT/private.asc" || return 1

  GNUPGHOME="$keyhome" gpgconf --kill gpg-agent >/dev/null 2>&1 || true
}

# ------------------------------------------------------------------------------
# Optional S3 helpers
# ------------------------------------------------------------------------------

# These helpers talk to S3 with plain curl on purpose: the tests must not rely
# on the S3 client code they are testing.

S3_RUN_PREFIX=""
T_S3_CONFIG=""

s3_tests_enabled() {
  [[ -n "${TEST_S3_BUCKET:-}" ]] || return 1
  [[ -n "${AWS_ACCESS_KEY_ID:-}" ]] || return 1
  [[ -n "${AWS_SECRET_ACCESS_KEY:-}" ]] || return 1
  command -v curl >/dev/null 2>&1 || return 1
  return 0
}

# Returns 0 when S3 tests can run, SKIP_RC when they cannot, and 1 instead of
# skipping when REQUIRE_S3_TESTS=1 (CI must not go green on silent skips).
require_s3_or_skip() {
  if s3_tests_enabled; then
    t_s3_init
    return 0
  fi

  if [[ "${REQUIRE_S3_TESTS:-0}" == 1 ]]; then
    log "S3 tests are required (REQUIRE_S3_TESTS=1) but S3 is not configured"
    return 1
  fi

  return "$SKIP_RC"
}

t_s3_init() {
  [[ -z "$T_S3_CONFIG" ]] || return 0

  local base_prefix="${TEST_S3_PREFIX:-docker-volume-tests}"
  base_prefix="${base_prefix#/}"
  base_prefix="${base_prefix%/}"
  S3_RUN_PREFIX="${base_prefix:+${base_prefix}/}run-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"

  T_S3_CONFIG="$TEST_ROOT/curl-s3.conf"
  (
    umask 077
    printf 'silent\nshow-error\n'
    printf 'user = "%s:%s"\n' "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY"
    printf 'aws-sigv4 = "aws:amz:%s:s3"\n' "${AWS_REGION:-us-east-1}"
    if [[ -n "${AWS_SESSION_TOKEN:-}" ]]; then
      printf 'header = "x-amz-security-token: %s"\n' "$AWS_SESSION_TOKEN"
    fi
  ) > "$T_S3_CONFIG"
}

# Unique per-test prefix below the per-run prefix
t_s3_prefix() {
  printf '%s/%s\n' "$S3_RUN_PREFIX" "$1"
}

t_s3_url() {
  local endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  printf '%s/%s/%s' "${endpoint%/}" "$TEST_S3_BUCKET" "$1"
}

# Prints the HTTP status of a HEAD request for the key
t_s3_head() {
  curl -K "$T_S3_CONFIG" -o /dev/null -w '%{http_code}' --head "$(t_s3_url "$1")" || true
}

t_s3_get() {
  curl -K "$T_S3_CONFIG" --fail -o "$2" "$(t_s3_url "$1")"
}

# Uploads a file unconditionally; prints the HTTP status
t_s3_put() {
  local key="$1" file="$2"
  shift 2
  curl -K "$T_S3_CONFIG" -o /dev/null -w '%{http_code}' --upload-file "$file" "$@" "$(t_s3_url "$key")" || true
}

# Prints the number of in-progress multipart uploads for the key
t_s3_pending_uploads() {
  local endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  curl -K "$T_S3_CONFIG" --fail "${endpoint%/}/${TEST_S3_BUCKET}?uploads&prefix=$1" \
    | grep -o '<UploadId>' | wc -l
}

# Deletes every object below a prefix (test cleanup only)
t_s3_delete_prefix() {
  local prefix="$1" endpoint key
  endpoint="${AWS_ENDPOINT_URL:-https://s3.${AWS_REGION:-us-east-1}.amazonaws.com}"
  [[ -n "$prefix" ]] || return 0

  curl -K "$T_S3_CONFIG" --fail "${endpoint%/}/${TEST_S3_BUCKET}?list-type=2&prefix=${prefix}/" 2>/dev/null \
    | tr '<' '\n' | awk -F'>' '$1 == "Key" { print $2 }' \
    | while IFS= read -r key; do
      curl -K "$T_S3_CONFIG" -o /dev/null -X DELETE "$(t_s3_url "$key")" || true
    done
}

# Creates a curl wrapper in <dir> that records every invocation's arguments in
# <dir>/curl.trace and can simulate S3 behaviour selected by <mode>:
#   trace                  pass everything through
#   deny                   answer every request with HTTP 403
#   complete-501           answer conditional CompleteMultipartUpload with 501
#   complete-lost          run the first CompleteMultipartUpload, then report a
#                          transport error (the response got lost)
#   complete-lost-foreign  instead of the first CompleteMultipartUpload, store a
#                          foreign object at the key and report a transport error
make_curl_stub() {
  local dir="$1" mode="$2" real_curl
  real_curl="$(command -v curl)"
  mkdir -p "$dir"

  cat > "$dir/curl" <<STUB
#!/usr/bin/env bash
real_curl='$real_curl'
mode='$mode'
state='$dir'
printf '%s\n' "\$*" >> "\$state/curl.trace"

out="" url="" conditional=0 is_post=0 has_w=0 prev=""
for arg in "\$@"; do
  case "\$prev" in
    -o) out="\$arg" ;;
    -w) has_w=1 ;;
    -X) [[ "\$arg" == POST ]] && is_post=1 ;;
    -H) [[ "\$arg" == "If-None-Match: *" ]] && conditional=1 ;;
  esac
  [[ "\$arg" == http://* || "\$arg" == https://* ]] && url="\$arg"
  prev="\$arg"
done
is_complete=0
[[ \$is_post == 1 && "\$url" == *"?uploadId="* ]] && is_complete=1

case "\$mode" in
  deny)
    [[ -n "\$out" && "\$out" != /dev/null && "\$out" != - ]] && printf '<Error><Code>AccessDenied</Code></Error>' > "\$out"
    if (( has_w )); then
      printf '403'
      exit 0
    fi
    exit 22
    ;;
  complete-501)
    if (( is_complete && conditional )); then
      printf '<Error><Code>NotImplemented</Code></Error>' > "\$out"
      printf '501'
      exit 0
    fi
    ;;
  complete-lost)
    if (( is_complete )) && [[ ! -e "\$state/lost.done" ]]; then
      : > "\$state/lost.done"
      "\$real_curl" "\$@" > /dev/null 2>&1
      printf '000'
      exit 52
    fi
    ;;
  complete-lost-foreign)
    if (( is_complete )) && [[ ! -e "\$state/lost.done" ]]; then
      : > "\$state/lost.done"
      printf 'foreign' > "\$state/foreign.bin"
      "\$real_curl" -K '$T_S3_CONFIG' -o /dev/null --upload-file "\$state/foreign.bin" "\${url%%\?*}"
      printf '000'
      exit 52
    fi
    ;;
esac

exec "\$real_curl" "\$@"
STUB
  chmod +x "$dir/curl"
}

# Prints the PIDs of a process and all of its descendants
process_tree_pids() {
  local root="$1" stat_file content pid ppid current
  local -A children=()

  for stat_file in /proc/[0-9]*/stat; do
    content="$(cat "$stat_file" 2>/dev/null)" || continue
    pid="${content%% *}"
    content="${content##*) }"
    ppid="${content#* }"
    ppid="${ppid%% *}"
    children[$ppid]+=" $pid"
  done

  local -a queue=("$root")
  while (( ${#queue[@]} > 0 )); do
    current="${queue[0]}"
    queue=("${queue[@]:1}")
    printf '%s\n' "$current"
    for pid in ${children[$current]:-}; do
      queue+=("$pid")
    done
  done
}

# Runs backup in the background, pausing at a test point:
#   start_paused_backup <point> [env assignments...] -- <backup args...>
start_paused_backup() {
  local point="$1"
  shift
  PAUSE_DIR="$CASE_ROOT/pause"
  mkdir -p "$PAUSE_DIR"

  run_backup_with_env VB_TEST_HOOKS=1 VB_TEST_PAUSE_AT="$point" VB_TEST_PAUSE_DIR="$PAUSE_DIR" "$@" \
    > "$CASE_ROOT/paused.log" 2>&1 &
  PAUSED_PID=$!
}

wait_for_point() {
  local point="$1" i
  for (( i = 0; i < 600; i++ )); do
    [[ -e "$PAUSE_DIR/${point}.reached" ]] && return 0
    kill -0 "$PAUSED_PID" 2>/dev/null || break
    sleep 0.1
  done
  log "Process did not reach test point '$point'"
  cat "$CASE_ROOT/paused.log" >&2 || true
  return 1
}

resume_and_wait() {
  local point="$1" rc=0
  : > "$PAUSE_DIR/${point}.continue"
  wait "$PAUSED_PID" || rc=$?
  cat "$CASE_ROOT/paused.log" >&2 || true
  return "$rc"
}

# ------------------------------------------------------------------------------
# Test functions
# ------------------------------------------------------------------------------

test_single_backup_restore_plain() {
  setup_case "single_backup_restore_plain"

  make_volume_content "alpha"

  local ts="20250101_010101"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"
  local checksum="${archive}.sha256"

  run_backup -v alpha -T "$ts" || return 1
  assert_file_exists "$archive" || return 1
  assert_file_exists "$checksum" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$archive" -t alpha_restore || return 1
  assert_dir_exists "$TEST_VOLUMES_ROOT/alpha_restore" || return 1

  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_single_backup_restore_compressed() {
  setup_case "single_backup_restore_compressed"

  make_volume_content "alpha"

  local ts="20250101_010102"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz"

  run_backup -v alpha -T "$ts" -c || return 1
  assert_file_exists "$archive" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$archive" -t alpha_restore || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_single_backup_restore_symmetric() {
  setup_case "single_backup_restore_symmetric"

  command -v gpg >/dev/null 2>&1 || return "$SKIP_RC"

  make_volume_content "alpha"

  local ts="20250101_010103"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz.gpg"

  export GPG_PASSPHRASE="test-symmetric-passphrase"

  run_backup -v alpha -T "$ts" -c -s || return 1
  assert_file_exists "$archive" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$archive" -t alpha_restore -s || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_single_backup_restore_asymmetric() {
  setup_case "single_backup_restore_asymmetric"

  generate_gpg_keypair_files || return $?

  make_volume_content "alpha"

  local ts="20250101_010104"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz.gpg"

  run_backup -v alpha -T "$ts" -c -e -k public.asc || return 1
  assert_file_exists "$archive" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$archive" -t alpha_restore -k private.asc || return 1
  assert_dirs_equal "$TEST_VOLUMES_ROOT/alpha" "$TEST_VOLUMES_ROOT/alpha_restore" || return 1
}

test_all_mode_with_filters_and_parallel() {
  setup_case "all_mode_with_filters_and_parallel"

  make_volume_content "alpha"
  make_volume_content "beta"
  make_volume_content "gamma"

  mkdir -p "$CASE_ROOT/expected-alpha" "$CASE_ROOT/expected-beta"
  copy_volume_snapshot "alpha" "$CASE_ROOT/expected-alpha"
  copy_volume_snapshot "beta" "$CASE_ROOT/expected-beta"

  local ts="20250101_020000"

  run_backup -a -v alpha -v beta -T "$ts" -c -j 2 || return 1

  assert_file_exists "$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz" || return 1
  assert_file_exists "$TEST_BACKUP_ROOT/beta_${ts}.tar.gz" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/gamma_${ts}.tar.gz" || return 1

  replace_volume_with_marker "alpha" "alpha-mutated"
  replace_volume_with_marker "beta" "beta-mutated"
  replace_volume_with_marker "gamma" "gamma-must-stay-untouched"

  run_restore -a -v alpha -v beta -T "$ts" -j 2 -C || return 1

  assert_dirs_equal "$CASE_ROOT/expected-alpha" "$TEST_VOLUMES_ROOT/alpha" || return 1
  assert_dirs_equal "$CASE_ROOT/expected-beta" "$TEST_VOLUMES_ROOT/beta" || return 1
  assert_text_file_contains "$TEST_VOLUMES_ROOT/gamma/marker.txt" "gamma-must-stay-untouched" || return 1
}

test_backup_single_dry_run_creates_nothing() {
  setup_case "backup_single_dry_run_creates_nothing"

  make_volume_content "alpha"

  local ts="20250101_030001"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz"

  run_backup -v alpha -T "$ts" -c -n || return 1
  assert_file_not_exists "$archive" || return 1
}

test_backup_all_dry_run_creates_nothing() {
  setup_case "backup_all_dry_run_creates_nothing"

  make_volume_content "alpha"
  make_volume_content "beta"

  local ts="20250101_030002"

  run_backup -a -T "$ts" -c -n || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/alpha_${ts}.tar.gz" || return 1
  assert_file_not_exists "$TEST_BACKUP_ROOT/beta_${ts}.tar.gz" || return 1
}

test_restore_single_dry_run_changes_nothing() {
  setup_case "restore_single_dry_run_changes_nothing"

  make_volume_content "alpha"

  local ts="20250101_030003"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"

  run_backup -v alpha -T "$ts" || return 1
  assert_file_exists "$archive" || return 1

  prepare_target_volume "alpha_restore"
  run_restore -i "$archive" -t alpha_restore -n || return 1
  [[ -z "$(ls -A "$TEST_VOLUMES_ROOT/alpha_restore")" ]] || {
    log "restore dry-run modified target directory unexpectedly"
    return 1
  }
}

test_restore_fails_on_non_empty_without_clear_flag() {
  setup_case "restore_fails_on_non_empty_without_clear_flag"

  make_volume_content "alpha"

  local ts="20250101_050001"
  local archive="$TEST_BACKUP_ROOT/alpha_${ts}.tar"

  run_backup -v alpha -T "$ts" || return 1

  # Put something in the target to make it non-empty
  mkdir -p "$TEST_VOLUMES_ROOT/alpha_restore"
  printf 'existing content\n' > "$TEST_VOLUMES_ROOT/alpha_restore/existing.txt"

  set +e
  run_restore -i "$archive" -t alpha_restore
  local rc=$?
  set -e

  (( rc != 0 )) || {
    log "Expected restore to fail on non-empty volume without -C, but it succeeded"
    return 1
  }
}

test_backup_fails_on_duplicate_timestamp() {
  setup_case "backup_fails_on_duplicate_timestamp"

  make_volume_content "alpha"

  local ts="20250101_050002"

  run_backup -v alpha -T "$ts" || return 1

  set +e
  run_backup -v alpha -T "$ts"
  local rc=$?
  set -e

  (( rc != 0 )) || {
    log "Expected second backup with same timestamp to fail, but it succeeded"
    return 1
  }
}

test_restore_all_no_timestamp_picks_latest() {
  setup_case "restore_all_no_timestamp_picks_latest"

  make_volume_content "alpha"
  make_volume_content "beta"

  local ts_old="20250101_060001"
  local ts_new="20250101_060002"

  # Backup at older timestamp
  run_backup -v alpha -T "$ts_old" -c || return 1
  run_backup -v beta  -T "$ts_old" -c || return 1

  # Modify volumes and backup at newer timestamp
  printf 'newer-alpha\n' > "$TEST_VOLUMES_ROOT/alpha/newer.txt"
  printf 'newer-beta\n'  > "$TEST_VOLUMES_ROOT/beta/newer.txt"

  run_backup -v alpha -T "$ts_new" -c || return 1
  run_backup -v beta  -T "$ts_new" -c || return 1

  local snapshot_alpha="$CASE_ROOT/expected-alpha"
  local snapshot_beta="$CASE_ROOT/expected-beta"
  copy_volume_snapshot "alpha" "$snapshot_alpha"
  copy_volume_snapshot "beta"  "$snapshot_beta"

  replace_volume_with_marker "alpha" "alpha-mutated"
  replace_volume_with_marker "beta"  "beta-mutated"

  # No -T: should pick ts_new (latest) for both, restoring the newer content
  run_restore -a -C || return 1

  assert_dirs_equal "$snapshot_alpha" "$TEST_VOLUMES_ROOT/alpha" || return 1
  assert_dirs_equal "$snapshot_beta"  "$TEST_VOLUMES_ROOT/beta"  || return 1
}


#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
SCRIPT_REAL="$(realpath -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s\n' "${BASH_SOURCE[0]}")"
readonly SCRIPT_REAL
readonly SELF_SCRIPT="${DVR_SELF:-$SCRIPT_REAL}"
readonly VB_LIB_DIR="${VB_LIB_DIR:-$(dirname -- "$SCRIPT_REAL")/../lib/vb}"

[[ -r "${VB_LIB_DIR}/common.sh" && -r "${VB_LIB_DIR}/s3.sh" && -r "${VB_LIB_DIR}/txn.sh" ]] || {
  printf '%s: library directory not found: %s (set VB_LIB_DIR)\n' "$SCRIPT_NAME" "$VB_LIB_DIR" >&2
  exit 1
}
# shellcheck source=SCRIPTDIR/../lib/vb/common.sh
source "${VB_LIB_DIR}/common.sh"
# shellcheck source=SCRIPTDIR/../lib/vb/s3.sh
source "${VB_LIB_DIR}/s3.sh"
# shellcheck source=SCRIPTDIR/../lib/vb/txn.sh
source "${VB_LIB_DIR}/txn.sh"

readonly DEFAULT_BACKUP_ROOT="${BACKUP_ROOT:-/backups}"
readonly VOLUMES_ROOT="${VOLUMES_ROOT:-/volumes}"
readonly GPG_ROOT="${GPG_ROOT:-/gpg}"

# Set for internal stage workers started by an "all" restore
readonly RESTORE_PHASE="${VB_RESTORE_PHASE:-}"

backup_root="$DEFAULT_BACKUP_ROOT"

source_arg=""
target_volume=""
private_key_file="private.gpg"

all_volumes=0
recover_only=0
timestamp_filter=""
jobs=1
dry_run=0
clear_target=0
symmetric=0
allow_unverified=0

declare -A volume_filters=()
declare -A latest_file=()
declare -A latest_ts=()
declare -A unique_timestamps=()

# Participants of the restore transaction (sorted by volume name)
declare -a part_volumes=()
declare -a part_sources=()
declare -a part_paths=()
declare -a part_local_sources=()

# Transaction state (orchestrator)
txn_gid=""
txn_coordinator_path=""
txn_started=0
txn_committed=0
txn_done=0
declare -a stage_pids=()
declare -A stage_pid_volume=()
pipeline_pid=""
checksum_pid=""

# State of the source being processed
download_from_s3=0
decrypt=0
compressed=0
src_path=""
source_name=""
s3_bucket=""
s3_key=""
expected_digest=""

parsed_volume=""
parsed_timestamp=""

gpg_raw_private_key="${GPG_PRIVATE_KEY:-}"
gpg_passphrase="${GPG_PASSPHRASE:-}"

decompressor_cmd=()
decompressor_name="none"

# ------------------------------------------------------------------------------
# Usage
# ------------------------------------------------------------------------------

usage() {
  cat <<EOF
Usage:
  # Restore one volume
  $SCRIPT_NAME -i <backup-file|s3://bucket/key> -t <target-volume> [options]

  # Restore all volumes from local BACKUP_ROOT
  $SCRIPT_NAME -a [options]

  # Restore selected volumes in "all" mode
  $SCRIPT_NAME -a -v <VOLUME_NAME> [-v <VOLUME_NAME> ...] [options]

  # Finish or roll back an interrupted restore
  $SCRIPT_NAME -X

Options:
  Modes:
    -a          Restore all mounted volumes from local backup files in BACKUP_ROOT
    -i <source> Backup source:
                  - file name inside current BACKUP_ROOT
                  - absolute/relative local path
                  - s3://bucket/key
    -t <name>   Target volume name inside ${VOLUMES_ROOT}
    -X          Recover: complete or roll back interrupted restores on all
                mounted volumes, then exit

                Without -a:
                  -i and -t are required
                With -a:
                  -i and -t must not be used
                  -v acts as a volume filter and may be repeated

  General:
    -d <dir>    Local backup directory override (default: ${DEFAULT_BACKUP_ROOT})
    -T <ts>     In -a mode, restore only backups with this timestamp
                Format: YYYYMMDD_HHMMSS
    -v <name>   In -a mode, restore only this volume (repeatable)
    -j <N>      Number of volumes staged in parallel in -a mode (1-99, default: 1)
    -C          Replace the existing contents of the target volume
    -U          Allow restoring a backup without a .sha256 checksum file
    -n          Dry-run
    -h          Show help

  Decryption:
    -s          Symmetric GPG decryption
    -k <file>   Private key file for asymmetric GPG decryption
                (absolute path or file inside ${GPG_ROOT}, default: private.gpg)

Environment variables:
  BACKUP_ROOT           Local backup directory (default: /backups)
  VOLUMES_ROOT          Mounted volumes root (default: /volumes)
  GPG_ROOT              Mounted GPG directory (default: /gpg)
  GPG_PRIVATE_KEY       Private key content for asymmetric decryption
  GPG_PASSPHRASE        Passphrase for symmetric decryption or private key
  AWS_ACCESS_KEY_ID     S3 access key ID (required for S3 restore)
  AWS_SECRET_ACCESS_KEY S3 secret access key (required for S3 restore)
  AWS_SESSION_TOKEN     Optional session token for temporary credentials
  AWS_REGION            S3 region (AWS: detected from the bucket when unset; custom endpoints: us-east-1)
  AWS_DEFAULT_REGION    Fallback for AWS_REGION
  AWS_ENDPOINT_URL      Optional custom S3 endpoint, scheme://host[:port] (MinIO, Yandex Cloud, DO Spaces, etc.)
  S3_ADDRESSING_STYLE   auto (default), path or virtual
  NO_COLOR              Disable colors in logs

Supported formats:
  .tar
  .tar.gz
  .tar.gpg
  .tar.gz.gpg

Examples:
  # Single restore
  $SCRIPT_NAME -i postgres_data_20250411_120000.tar.gz -t postgres_data
  GPG_PASSPHRASE='secret' $SCRIPT_NAME -i backup.tar.gz.gpg -t postgres_data -s -C
  GPG_PASSPHRASE='key-pass' $SCRIPT_NAME -i s3://my-bucket/daily/app/backup.tar.gpg -t postgres_data -k private.asc -C

  # Restore all
  $SCRIPT_NAME -a -C
  $SCRIPT_NAME -a -T 20250411_120000 -C
  $SCRIPT_NAME -a -v postgres_data -v redis_data -C
  $SCRIPT_NAME -a -j 4 -C
  GPG_PASSPHRASE='secret' $SCRIPT_NAME -a -s -C

Notes:
  - Restores are transactional. Every selected archive is extracted and
    verified inside its target volume first; only then are the volumes
    switched, and the old data is deleted only after all of them switched.
    A failure or interruption before that point leaves every volume with its
    original data. The target volume needs room for both copies.
  - After a crash, the next restore of the affected volumes (or -X) completes
    or rolls back the interrupted one.
  - A restore locks its target volumes and a backup its source volume, so
    they never run on the same volume at the same time.
  - Top-level names starting with .vb-restore are reserved for the journal.
  - In -a mode, backups of volumes that are not mounted are skipped.
  - Without -T, the latest backup is selected independently for each volume.
    If selected backups have different timestamps, the volumes may not form a
    consistent snapshot. Prefer -T for a full snapshot restore.
EOF
}

# ------------------------------------------------------------------------------
# Cleanup / signals
# ------------------------------------------------------------------------------

stop_stage_workers() {
  local pid
  for pid in "${stage_pids[@]}"; do
    stop_process_tree "$pid" TERM
  done
  stage_pids=()
}

cleanup() {
  stop_stage_workers
  if [[ -n "$pipeline_pid" ]]; then
    stop_process_tree "$pipeline_pid" TERM
    pipeline_pid=""
  fi
  # Blocked opening its FIFO if the pipeline never started writing
  if [[ -n "$checksum_pid" ]]; then
    stop_process_tree "$checksum_pid" TERM
    checksum_pid=""
  fi

  if [[ -z "$RESTORE_PHASE" ]]; then
    if (( txn_started && ! txn_committed && ! txn_done )); then
      log WARN "Rolling back; the target volumes keep their original data"
      if ! ( abort_transaction ); then
        log ERROR "Rollback did not finish; run '$SCRIPT_NAME -X' to complete it"
      fi
    elif (( txn_committed && ! txn_done )); then
      log WARN "Interrupted after the commit point; run '$SCRIPT_NAME -X' to finish the restore"
    fi
  fi

  cleanup_work_dir
}

on_signal() {
  trap '' INT TERM
  log WARN "Received SIG$1, stopping"
  exit "$2"
}

trap cleanup EXIT
trap 'on_signal INT 130' INT
trap 'on_signal TERM 143' TERM
trap 'report_unexpected_error $? $LINENO "$BASH_COMMAND"' ERR

# ------------------------------------------------------------------------------
# Sources
# ------------------------------------------------------------------------------

dir_has_entries() {
  [[ -n "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]
}

# Resolves a source argument and detects its format.
setup_source() {
  local source="$1"
  download_from_s3=0
  decrypt=0
  compressed=0
  s3_bucket=""
  s3_key=""

  if [[ "$source" == s3://* ]]; then
    download_from_s3=1
    src_path="$source"
    source_name="${src_path##*/}"
  else
    if [[ "$source" == /* || "$source" == ./* || "$source" == ../* || -f "$source" ]]; then
      src_path="$source"
    else
      src_path="${backup_root%/}/$source"
    fi
    [[ -f "$src_path" ]] || die "Backup file not found: $src_path"
    source_name="$(basename "$src_path")"
  fi

  local name="$source_name"
  if [[ "$name" == *.gpg ]]; then
    decrypt=1
    name="${name%.gpg}"
  fi
  if [[ "$name" == *.gz ]]; then
    compressed=1
    name="${name%.gz}"
  fi
  [[ "$name" == *.tar ]] || die "Unsupported backup format: $source_name. Expected .tar[.gz][.gpg]"

  if (( download_from_s3 )); then
    local path="${src_path#s3://}"
    s3_bucket="${path%%/*}"
    s3_key="${path#*/}"
    [[ -n "$s3_bucket" && "$s3_bucket" != "$path" && -n "$s3_key" ]] || die "Invalid S3 path: $src_path"
    s3_validate_bucket "$s3_bucket"
    s3_validate_key "$s3_key"
  fi
}

check_decryption_prerequisites() {
  (( decrypt )) || return 0
  require_command gpg

  if [[ -z "$RESTORE_PHASE" ]]; then
    check_passphrase_newline "$gpg_passphrase"
  fi

  if (( symmetric )); then
    [[ -n "$gpg_passphrase" ]] || die "GPG_PASSPHRASE environment variable is not set"
  elif [[ -z "$gpg_raw_private_key" ]]; then
    local key_source="$private_key_file"
    [[ "$key_source" == /* ]] || key_source="${GPG_ROOT%/}/$private_key_file"
    [[ -f "$key_source" ]] || die "Private key file not found: $key_source"
  fi
}

prepare_decompressor() {
  (( compressed )) || return 0

  if command -v pigz >/dev/null 2>&1; then
    decompressor_cmd=(pigz -dc)
    decompressor_name="pigz"
  elif command -v gzip >/dev/null 2>&1; then
    decompressor_cmd=(gzip -dc)
    decompressor_name="gzip"
    log WARN "pigz not found, falling back to gzip"
  else
    die "Compressed backup detected, but neither pigz nor gzip is installed"
  fi
}

prepare_asymmetric_gpg() {
  local key_source

  prepare_gpg_home

  if [[ -n "$gpg_raw_private_key" ]]; then
    key_source="${work_dir}/private.key"
    printf '%s' "$gpg_raw_private_key" > "$key_source"
    chmod 600 "$key_source"
  elif [[ "$private_key_file" == /* ]]; then
    key_source="$private_key_file"
  else
    key_source="${GPG_ROOT%/}/$private_key_file"
  fi

  [[ -f "$key_source" ]] || die "Private key file not found: $key_source"
  gpg --batch --import "$key_source" >/dev/null 2>&1 || die "Failed to import private key"
}

prepare_decryption() {
  (( decrypt )) || return 0
  check_decryption_prerequisites

  if (( symmetric )); then
    prepare_gpg_home
  else
    prepare_asymmetric_gpg
  fi
}

# Loads the expected digest from the .sha256 sidecar. The sidecar is
# mandatory unless -U was given; any error other than "not found" is fatal.
load_expected_digest() {
  local sidecar
  expected_digest=""
  ensure_work_dir

  if (( download_from_s3 )); then
    sidecar="${work_dir}/expected.sha256"
    if s3_head "$s3_bucket" "${s3_key}.sha256"; then
      s3_get_file "$s3_bucket" "${s3_key}.sha256" "$sidecar" || die "Checksum file disappeared from S3: ${src_path}.sha256"
      expected_digest="$(read_sidecar_digest "$sidecar")" || die "Checksum file is empty or malformed: ${src_path}.sha256"
      return 0
    fi
  else
    sidecar="${src_path}.sha256"
    if [[ -f "$sidecar" ]]; then
      expected_digest="$(read_sidecar_digest "$sidecar")" || die "Checksum file is empty or malformed: $sidecar"
      return 0
    fi
  fi

  (( allow_unverified )) || die \
    "Checksum file not found: ${src_path}.sha256. The backup may be incomplete; use -U to restore it without verification"
  log WARN "No checksum file for ${src_path}; restoring without verification (-U)"
}

source_stream() {
  if (( download_from_s3 )); then
    s3_get "$s3_bucket" "$s3_key"
  else
    cat -- "$src_path"
  fi
}

decrypt_stream() {
  if (( decrypt == 0 )); then
    cat
    return
  fi

  # The status file proves that the data was actually decrypted: gpg also
  # "decrypts" unencrypted OpenPGP data (a bare literal packet) with exit 0.
  if [[ -n "$gpg_passphrase" ]]; then
    gpg \
      --batch \
      --yes \
      --no-tty \
      --pinentry-mode loopback \
      --status-file "${work_dir}/gpg.status" \
      --passphrase-fd 3 \
      --decrypt \
      --output - \
      3<<<"$gpg_passphrase"
  else
    gpg \
      --batch \
      --yes \
      --no-tty \
      --pinentry-mode loopback \
      --status-file "${work_dir}/gpg.status" \
      --decrypt \
      --output -
  fi
}

decompress_stream() {
  if (( compressed )); then
    "${decompressor_cmd[@]}"
  else
    cat
  fi
}

extract_stream() {
  tar \
    --extract \
    --file - \
    --directory "$1" \
    --numeric-owner \
    --same-owner \
    --preserve-permissions \
    "${tar_extract_flags[@]}"
}

# ------------------------------------------------------------------------------
# Staging (phase 1)
# ------------------------------------------------------------------------------

# Extracts and verifies one archive into the journal of its target volume
# (created beforehand by the orchestrator).
#   stage_participant <volume> <source> <target-path> <gid>
stage_participant() {
  local volume="$1" source="$2" target="$3" gid="$4"
  local journal="${target}/${TXN_NAME}"
  local sha_fifo sha_out actual rc=0 sha_rc=0

  [[ "$(txn_signature_gid "$journal" 2>/dev/null)" == "$gid" && "$(txn_state "$journal")" == staging ]] || die \
    "Journal of ${target} does not belong to this restore"

  setup_source "$source"
  if (( symmetric && ! decrypt )); then
    die "Invalid flag usage: -s. Source does not have a '.gpg' extension"
  fi
  prepare_decompressor
  prepare_decryption
  if (( download_from_s3 )); then
    s3_init "$s3_bucket"
  fi
  load_expected_digest

  local decryption="none"
  if (( decrypt )); then
    if (( symmetric )); then decryption="symmetric GPG"; else decryption="asymmetric GPG"; fi
  fi
  log INFO "Staging ${volume} from ${src_path} (compression: ${decompressor_name}, decryption: ${decryption})"

  ensure_work_dir
  sha_fifo="${work_dir}/sha.fifo"
  sha_out="${work_dir}/sha.out"
  rm -f -- "$sha_fifo" "${work_dir}/gpg.status"
  mkfifo "$sha_fifo"

  # Readers first, then the writers; the checksum reader is a direct child so
  # it can be waited for.
  sha256sum < "$sha_fifo" > "$sha_out" &
  checksum_pid=$!

  # The pipeline runs in the background so signals are handled promptly.
  (
    vb_test_point "restore_stream" "$volume"
    source_stream | tee "$sha_fifo" | decrypt_stream | decompress_stream | extract_stream "${journal}/new"
  ) &
  pipeline_pid=$!

  wait "$pipeline_pid" || rc=$?
  pipeline_pid=""
  wait "$checksum_pid" || sha_rc=$?
  checksum_pid=""

  (( rc == 0 )) || die "Failed to read, decrypt, decompress or extract ${src_path}"
  (( sha_rc == 0 )) || die "Failed to compute the checksum of ${src_path}"
  if (( decrypt )); then
    grep -q '^\[GNUPG:\] DECRYPTION_OKAY' "${work_dir}/gpg.status" 2>/dev/null || die \
      "GPG did not confirm the decryption of ${src_path}; the archive is not encrypted or not intact"
  fi

  if [[ -n "$expected_digest" ]]; then
    actual="$(awk '{ print $1 }' "$sha_out")"
    [[ "$actual" == "$expected_digest" ]] || die \
      "Checksum verification failed for ${src_path} (expected: ${expected_digest}, got: ${actual})"
    log INFO "Checksum verification passed: ${src_path}"
  fi

  txn_stage_complete "$target"
  log INFO "Staged ${volume}"
}

launch_stage_worker() {
  local index="$1"
  local -a args=(-i "${part_sources[index]}" -t "${part_volumes[index]}")

  if (( symmetric )) && [[ "${part_sources[index]}" == *.gpg ]]; then
    args+=(-s)
  fi
  if [[ "$private_key_file" != "private.gpg" ]]; then
    args+=(-k "$private_key_file")
  fi
  if (( allow_unverified )); then
    args+=(-U)
  fi

  VB_RESTORE_PHASE=stage \
    VB_TXN_GID="$txn_gid" \
    BACKUP_ROOT="$backup_root" \
    bash "$SELF_SCRIPT" "${args[@]}" &

  stage_pids+=("$!")
  stage_pid_volume[$!]="${part_volumes[index]}"
}

# Waits until at least one stage worker has finished. Returns 1 if any of
# the finished workers failed.
reap_stage_workers() {
  local i pid failed=0
  local -a running=()

  vb_wait_any "${stage_pids[@]}"
  for i in "${!vb_done_pids[@]}"; do
    pid="${vb_done_pids[i]}"
    if (( vb_done_status[i] != 0 )); then
      log ERROR "Failed to stage ${stage_pid_volume[$pid]}"
      failed=1
    fi
  done

  for pid in "${stage_pids[@]}"; do
    [[ " ${vb_done_pids[*]} " == *" ${pid} "* ]] || running+=("$pid")
  done
  stage_pids=("${running[@]}")

  return "$failed"
}

stage_all_participants() {
  local failed=0 index
  local -a pending=("${!part_volumes[@]}")

  if (( ${#part_volumes[@]} == 1 )); then
    stage_participant "${part_volumes[0]}" "${part_sources[0]}" "${part_paths[0]}" "$txn_gid"
    return
  fi

  while (( ${#pending[@]} > 0 || ${#stage_pids[@]} > 0 )); do
    while (( ! failed && ${#pending[@]} > 0 && ${#stage_pids[@]} < jobs )); do
      index="${pending[0]}"
      pending=("${pending[@]:1}")
      launch_stage_worker "$index"
    done

    if (( ${#stage_pids[@]} > 0 )) && ! reap_stage_workers; then
      failed=1
      pending=()
      stop_stage_workers
    fi
  done

  (( ! failed )) || die "Staging failed; no volume was changed"
}

# Rolls back every participant and removes leftovers of this transaction.
abort_transaction() {
  local path
  txn_abort_group "$txn_coordinator_path" "${part_paths[@]}"
  for path in "${part_paths[@]}"; do
    txn_cleanup_trash "${path}/${TXN_NAME}.new.${txn_gid}"
  done
  txn_done=1
}

# ------------------------------------------------------------------------------
# Transaction
# ------------------------------------------------------------------------------

run_transaction() {
  local coordinator="${part_volumes[0]}"
  local participants="${part_volumes[*]}"
  local index

  txn_gid="$(random_hex 16)"
  txn_coordinator_path="${part_paths[0]}"
  txn_started=1

  # Journals are created in order, coordinator first: a participant journal
  # therefore never exists without the coordinator journal, which recovery
  # relies on to decide the outcome of the group.
  for index in "${!part_paths[@]}"; do
    # shellcheck disable=SC2086 # volume names never contain whitespace
    txn_create "${part_paths[index]}" "$txn_gid" "${part_volumes[index]}" "$coordinator" $participants
  done

  # Phase 1: extract and verify every archive; no volume changes yet
  stage_all_participants

  # Phase 2: switch every volume (renames only)
  for index in "${!part_paths[@]}"; do
    log INFO "Switching ${part_volumes[index]}"
    txn_aside "${part_paths[index]}"
    txn_swap "${part_paths[index]}"
  done

  # Commit point: from here on the new data wins, even after a crash
  vb_test_point "txn_before_decision"
  txn_write "${txn_coordinator_path}/${TXN_NAME}" decision commit
  txn_committed=1
  vb_test_point "txn_after_decision"

  # Phase 3: delete the old data and restore the root metadata
  txn_finalize_group "$txn_coordinator_path" "${part_paths[@]}"
  txn_done=1
}

# ------------------------------------------------------------------------------
# Participants
# ------------------------------------------------------------------------------

parse_backup_filename() {
  local name="$1"

  parsed_volume=""
  parsed_timestamp=""

  if [[ "$name" == *.gpg ]]; then
    name="${name%.gpg}"
  fi

  if [[ "$name" == *.gz ]]; then
    name="${name%.gz}"
  fi

  [[ "$name" == *.tar ]] || return 1
  name="${name%.tar}"

  if [[ "$name" =~ ^(.+)_([0-9]{8}_[0-9]{6})$ ]]; then
    parsed_volume="${BASH_REMATCH[1]}"
    parsed_timestamp="${BASH_REMATCH[2]}"
    return 0
  fi

  return 1
}

collect_backups_for_all_mode() {
  [[ -d "$backup_root" ]] || die "Backup directory not found: $backup_root"

  local filepath filename vol ts
  local -A seen=()

  while IFS= read -r -d '' filepath; do
    filename="$(basename "$filepath")"

    if ! parse_backup_filename "$filename"; then
      log WARN "Skipping unsupported file: $filename"
      continue
    fi

    vol="$parsed_volume"
    ts="$parsed_timestamp"

    if ! is_valid_volume_name "$vol"; then
      log WARN "Skipping backup with unsafe volume name '${vol}': $filename"
      continue
    fi

    if (( ${#volume_filters[@]} > 0 )) && [[ -z "${volume_filters[$vol]:-}" ]]; then
      continue
    fi

    if [[ -n "$timestamp_filter" && "$ts" != "$timestamp_filter" ]]; then
      continue
    fi

    if [[ -n "${seen[${vol}_${ts}]:-}" ]]; then
      die "Ambiguous backups for volume '${vol}' at ${ts}: $(basename "${seen[${vol}_${ts}]}") and ${filename}"
    fi
    seen[${vol}_${ts}]="$filepath"

    if [[ -z "${latest_ts[$vol]:-}" || "$ts" > "${latest_ts[$vol]}" ]]; then
      latest_file["$vol"]="$filepath"
      latest_ts["$vol"]="$ts"
    fi
  done < <(
    find "$backup_root" -maxdepth 1 -type f \
      \( -name '*.tar' -o -name '*.tar.gz' -o -name '*.tar.gpg' -o -name '*.tar.gz.gpg' \) \
      -print0
  )
}

build_participants_for_all_mode() {
  local vol requested missing=0

  if [[ -n "$timestamp_filter" ]]; then
    [[ "$timestamp_filter" =~ ^[0-9]{8}_[0-9]{6}$ ]] || die \
      "Invalid timestamp format: '$timestamp_filter'. Expected YYYYMMDD_HHMMSS"
  fi

  collect_backups_for_all_mode

  if (( ${#volume_filters[@]} > 0 )); then
    while IFS= read -r requested; do
      if [[ -z "${latest_file[$requested]:-}" ]]; then
        log ERROR "No backup found for requested volume: $requested"
        missing=1
      fi
    done < <(printf '%s\n' "${!volume_filters[@]}" | sort)
    (( missing == 0 )) || die "One or more requested volumes have no matching backups"
  else
    # Without -v, restore what is mounted (like backup -a) and skip the rest
    for vol in "${!latest_file[@]}"; do
      if [[ ! -d "${VOLUMES_ROOT%/}/${vol}" ]]; then
        log WARN "Skipping ${vol}: a backup exists but the volume is not mounted into ${VOLUMES_ROOT}"
        unset 'latest_file[$vol]' 'latest_ts[$vol]'
      fi
    done
  fi

  if (( ${#latest_file[@]} == 0 )); then
    [[ -z "$timestamp_filter" ]] || die "No backup files found in $backup_root for timestamp $timestamp_filter"
    die "No backup files found in $backup_root for the mounted volumes"
  fi

  while IFS= read -r vol; do
    part_volumes+=("$vol")
    part_sources+=("${latest_file[$vol]}")
    unique_timestamps["${latest_ts[$vol]}"]=1
  done < <(printf '%s\n' "${!latest_file[@]}" | sort)
}

# Read-only checks of one participant; fills part_paths.
preflight_participant() {
  local index="$1"
  local volume="${part_volumes[index]}" source="${part_sources[index]}" path mounts

  validate_volume_name "$volume"
  [[ -d "${VOLUMES_ROOT%/}/${volume}" ]] || die \
    "Target volume '${volume}' is not mounted into ${VOLUMES_ROOT}. Add --volume ${volume}:${VOLUMES_ROOT%/}/${volume} to your docker run command."
  path="$(resolve_volume_dir "$volume")" || die \
    "Refusing target volume '${volume}': it does not resolve to a directory directly inside ${VOLUMES_ROOT}"
  part_paths[index]="$path"

  mounts="$(mounts_below "$path")"
  [[ -z "$mounts" ]] || die \
    "Target volume '${volume}' contains other mount points, which a restore cannot replace: $(printf '%s ' "$mounts")"

  setup_source "$source"
  if (( symmetric && ! decrypt && ! all_volumes )); then
    die "Invalid flag usage: -s. Source does not have a '.gpg' extension"
  fi
  check_decryption_prerequisites
  if (( ! download_from_s3 )); then
    part_local_sources[index]="$(realpath -e -- "$src_path")"
  fi

  if (( ! download_from_s3 && ! allow_unverified )) && [[ ! -f "${src_path}.sha256" ]]; then
    die "Checksum file not found: ${src_path}.sha256. The backup may be incomplete; use -U to restore it without verification"
  fi
}

# A restore replaces the whole target, so an archive stored inside one of the
# targets would be moved aside and deleted with the old data.
check_sources_outside_targets() {
  local source path
  for source in "${part_local_sources[@]}"; do
    for path in "${part_paths[@]}"; do
      [[ "$source" != "$path"/* ]] || die \
        "Backup file ${source} is stored inside the target volume ${path}; move it out of the volume first"
    done
  done
}

# Checks that a target can be used once the locks are held.
check_target_usable() {
  local volume="$1" path="$2" reserved

  reserved="$(txn_describe_reserved "$path")"
  [[ -z "$reserved" ]] || die \
    "Target volume '${volume}' holds reserved entries ($(printf '%s; ' "$reserved")); run '$SCRIPT_NAME -X' or move them away"

  if dir_has_entries "$path" && (( clear_target == 0 )); then
    die "Target volume is not empty: ${path}. Use -C to replace its contents"
  fi
}

dry_run_participant() {
  local index="$1" actual reserved

  setup_source "${part_sources[index]}"
  log INFO "  ${part_volumes[index]}  <-  ${src_path}"

  reserved="$(txn_describe_reserved "${part_paths[index]}")"
  if [[ -n "$reserved" ]]; then
    log WARN "  ${part_volumes[index]} holds reserved entries; the restore will recover them first: $(printf '%s; ' "$reserved")"
  elif dir_has_entries "${part_paths[index]}" && (( clear_target == 0 )); then
    die "Target volume is not empty: ${part_paths[index]}. Use -C to replace its contents"
  fi

  if (( download_from_s3 )); then
    s3_init "$s3_bucket"
    s3_head "$s3_bucket" "$s3_key" || die "Backup object not found: $src_path"
  fi

  load_expected_digest
  if [[ -n "$expected_digest" && "$download_from_s3" == 0 ]]; then
    actual="$(sha256sum -- "$src_path" | awk '{ print $1 }')"
    [[ "$actual" == "$expected_digest" ]] || die \
      "Checksum verification failed for ${src_path} (expected: ${expected_digest}, got: ${actual})"
    log INFO "  Checksum verification passed"
  fi
}

# ------------------------------------------------------------------------------
# Modes
# ------------------------------------------------------------------------------

run_stage_worker() {
  local path
  validate_volume_name "$target_volume"
  path="$(resolve_volume_dir "$target_volume")" || die "Target volume '${target_volume}' is not usable"
  prepare_tar_flags

  stage_participant "$target_volume" "$source_arg" "$path" "${VB_TXN_GID:?}"
}

run_restore() {
  local index ts

  require_command tar
  require_command flock
  prepare_tar_flags

  if (( all_volumes )); then
    build_participants_for_all_mode
  else
    [[ -n "$source_arg" ]] || die "Required flag is missing: -i <backup-file|s3://bucket/key>"
    [[ -n "$target_volume" ]] || die "Required flag is missing: -t <target-volume>"
    part_volumes=("$target_volume")
    part_sources=("$source_arg")
  fi

  for index in "${!part_volumes[@]}"; do
    preflight_participant "$index"
  done
  check_sources_outside_targets

  log INFO "Restoring ${#part_volumes[@]} volume(s)"
  if (( all_volumes )); then
    log INFO "Parallel jobs: $jobs"
    if [[ -n "$timestamp_filter" ]]; then
      log INFO "Snapshot timestamp: $timestamp_filter"
    elif (( ${#unique_timestamps[@]} > 1 )); then
      log WARN "Selected backups span multiple timestamps; restore may be inconsistent across volumes"
    fi
    for ts in "${!part_volumes[@]}"; do
      log INFO "  ${part_volumes[ts]}  <-  $(basename "${part_sources[ts]}")"
    done
  fi

  if (( clear_target )); then
    log INFO "Target mode: replace existing contents"
  else
    log INFO "Target mode: must be empty"
  fi

  if (( dry_run )); then
    for index in "${!part_volumes[@]}"; do
      dry_run_participant "$index"
    done
    log INFO "Dry-run: no changes made"
    return 0
  fi

  # Lock every target for the whole transaction, then finish any interrupted
  # restore that involves them before checking that they are usable.
  txn_lock x "${part_paths[@]}"
  txn_recover "${part_volumes[@]}"
  for index in "${!part_volumes[@]}"; do
    check_target_usable "${part_volumes[index]}" "${part_paths[index]}"
  done

  run_transaction

  log INFO "Restore completed successfully"
}

# ------------------------------------------------------------------------------
# Parse args
# ------------------------------------------------------------------------------

while getopts ':ad:i:t:T:v:j:sk:CnUXh' flag; do
  case "$flag" in
    a) all_volumes=1 ;;
    d) backup_root="$OPTARG" ;;
    i) source_arg="$OPTARG" ;;
    t) target_volume="$OPTARG" ;;
    T) timestamp_filter="$OPTARG" ;;
    v)
      validate_volume_name "$OPTARG"
      volume_filters["$OPTARG"]=1
      ;;
    j) jobs="$OPTARG" ;;
    s) symmetric=1 ;;
    k) private_key_file="$OPTARG" ;;
    C) clear_target=1 ;;
    n) dry_run=1 ;;
    U) allow_unverified=1 ;;
    X) recover_only=1 ;;
    h)
      usage
      exit 0
      ;;
    :)
      die "Option -$OPTARG requires an argument"
      ;;
    \?)
      die "Unsupported flag: -$OPTARG"
      ;;
  esac
done

shift $((OPTIND - 1))
[[ $# -eq 0 ]] || die "Unexpected extra arguments: $*"

# Validate before any arithmetic: bash evaluates array subscripts in (( )).
[[ "$jobs" =~ ^[1-9][0-9]?$ ]] || die "Invalid -j value: '$jobs'. Expected an integer from 1 to 99"

# ------------------------------------------------------------------------------
# Mode selection
# ------------------------------------------------------------------------------

init_volumes_root

if (( recover_only )); then
  if (( all_volumes || ${#volume_filters[@]} > 0 )) || [[ -n "$source_arg$target_volume$timestamp_filter" ]]; then
    die "Option -X cannot be combined with -a, -i, -t, -T or -v"
  fi
elif (( all_volumes )); then
  [[ -z "$source_arg" ]] || die "Option -i cannot be used with -a"
  [[ -z "$target_volume" ]] || die "Option -t cannot be used with -a"
else
  [[ -z "$timestamp_filter" ]] || die "Option -T can only be used with -a"
  (( ${#volume_filters[@]} == 0 )) || die "Option -v can only be used with -a; use -t for single restore"
  (( jobs == 1 )) || die "Option -j can only be used with -a"
fi

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------

if [[ "$RESTORE_PHASE" == stage ]]; then
  run_stage_worker
elif (( recover_only )); then
  require_command flock
  prepare_tar_flags
  txn_recover
  log INFO "Recovery finished"
else
  run_restore
fi
